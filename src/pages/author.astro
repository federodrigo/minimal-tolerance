---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";

const ssrnUrl =
  "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5984574";
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Author | Minimal Tolerance"
      description="Fede Rodrigo is an independent author and technology executive whose work examines coercion, political authority and the limits of state power."
      lang="en"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- PAGE TITLE -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            THE AUTHOR
          </p>

          <h1>
            Fede Rodrigo
          </h1>
        </div>
      </section>

      <!-- STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          Every claim must survive its strongest objection
        </blockquote>
      </section>

      <!-- ABOUT -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            ABOUT
          </p>

          <h2 class="reveal">
            Independent author and tech executive
          </h2>

          <p class="reveal">
            Federico "Fede" Rodrigo writes about power,
            legitimacy and coercion. His work explores the
            limits of state power and the conditions required
            to justify coercive necessity
          </p>

          <p class="reveal">
            Political theory is a personal interest rather than a
            profession. Outside his writing, he works in
            technology and executive leadership
          </p>
        </div>
      </section>

      <!-- CONTACT -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow reveal">
            CONTACT
          </p>

          <h2 class="reveal">
            Get in touch
          </h2>

          <p class="reveal">
            Questions, objections and criticism are welcome
          </p>

          <p class="reveal">
            <a
              class="author-email"
              href="mailto:fede@minimaltolerance.com"
            >
              fede@minimaltolerance.com
            </a>
          </p>
        </div>
      </section>

      <!-- RESEARCH -->

      <section class="ssrn">
        <div class="container">
          <p class="eyebrow reveal">
            RESEARCH
          </p>

          <h2 class="reveal">
            The Theory of Minimal Tolerance
          </h2>

          <p class="reveal">
            The foundational paper introduces the theory and
            its test for coercive necessity
          </p>

          <a
            href={ssrnUrl}
            class="primary reveal"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open on SSRN
          </a>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .author-email {
        position: relative;
        display: inline-block;
        color: var(--gold);
        font-size: 1.08rem;
        font-weight: 700;
        text-decoration: none;
      }

      .author-email::after {
        position: absolute;
        right: 0;
        bottom: -3px;
        left: 0;
        height: 1px;
        background: currentColor;
        content: "";
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 220ms ease;
      }

      @media (hover: hover) and (pointer: fine) {
        .author-email:hover::after {
          transform: scaleX(1);
          transform-origin: left;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .author-email::after {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.14,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
