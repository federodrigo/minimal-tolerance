---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Autor | Tolerancia Mínima"
      description="Fede Rodrigo es autor independiente y ejecutivo de tecnología. Su trabajo examina la coerción, la autoridad política y los límites del poder estatal."
      lang="es"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- TÍTULO DE PÁGINA -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            EL AUTOR
          </p>

          <h1>
            Fede Rodrigo
          </h1>
        </div>
      </section>

      <!-- FRASE CENTRAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          Toda afirmación debe resistir su objeción más fuerte
        </blockquote>
      </section>

      <!-- SOBRE EL AUTOR -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            SOBRE EL AUTOR
          </p>

          <h2 class="reveal">
            Autor y ejecutivo de tecnología
          </h2>

          <p class="reveal">
            Federico "Fede" Rodrigo escribe sobre poder,
            legitimidad y coerción. Su trabajo explora los
            límites del poder estatal y las condiciones necesarias
            para justificar la necesidad coercitiva
          </p>

          <p class="reveal">
            La teoría política es un interés personal y no una
            profesión. Fuera de su trabajo como autor, se desempeña
            en tecnología y liderazgo ejecutivo
          </p>
        </div>
      </section>

      <!-- CONTACTO -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow reveal">
            CONTACTO
          </p>

          <h2 class="reveal">
            Contacto
          </h2>

          <p class="reveal">
            Las preguntas, objeciones y críticas son bienvenidas
          </p>

          <p class="reveal">
            <a
              class="author-email"
              href="mailto:fede@minimaltolerance.com"
            >
              fede@minimaltolerance.com
            </a>
          </p>
        </div>
      </section>

      <!-- PROYECTO -->

      <section class="ssrn">
        <div class="container">
          <p class="eyebrow reveal">
            EL PROYECTO
          </p>

          <h2 class="reveal">
            Explorar Tolerancia Mínima
          </h2>

          <p class="reveal">
            Una teoría sobre el poder, la coerción y los límites de la autoridad política
          </p>

          <a
            href="/es/theory"
            class="primary reveal"
          >
            Explorar la Teoría
          </a>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .author-email {
        position: relative;
        display: inline-block;
        color: var(--gold);
        font-size: 1.08rem;
        font-weight: 700;
        text-decoration: none;
      }

      .author-email::after {
        position: absolute;
        right: 0;
        bottom: -3px;
        left: 0;
        height: 1px;
        background: currentColor;
        content: "";
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 220ms ease;
      }

      @media (hover: hover) and (pointer: fine) {
        .author-email:hover::after {
          transform: scaleX(1);
          transform-origin: left;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .author-email::after {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.14,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
