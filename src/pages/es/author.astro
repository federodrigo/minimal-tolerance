---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";

const ssrnUrl =
  "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5984574";
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Autor | Tolerancia Mínima"
      description="Federico Rodrigo es un autor independiente y ejecutivo de tecnología cuyo trabajo examina la coerción, la autoridad política y los límites del poder estatal."
      lang="es"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- TÍTULO -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            EL AUTOR
          </p>

          <h1>
            Federico Rodrigo
          </h1>
        </div>
      </section>

      <!-- FRASE PRINCIPAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          Todo argumento debe sobrevivir a su objeción más fuerte
        </blockquote>
      </section>

      <!-- ACERCA DE -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            ACERCA DE
          </p>

          <h2 class="reveal">
            Autor independiente y ejecutivo de tecnología
          </h2>

          <p class="reveal">
            Federico "Fede" Rodrigo escribe sobre poder,
            legitimidad y coerción. Su trabajo explora las
            condiciones bajo las cuales la autoridad estatal
            puede ser tolerada
          </p>

          <p class="reveal">
            La teoría política es un interés personal más que una
            profesión. Fuera de su actividad como autor, trabaja
            en liderazgo tecnológico y gestión ejecutiva
          </p>
        </div>
      </section>

      <!-- CONTACTO -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow reveal">
            CONTACTO
          </p>

          <h2 class="reveal">
            Ponte en contacto
          </h2>

          <p class="reveal">
            Las preguntas, objeciones y críticas son bienvenidas
          </p>

          <p class="reveal">
            <a
              class="author-email"
              href="mailto:fede@minimaltolerance.com"
            >
              fede@minimaltolerance.com
            </a>
          </p>
        </div>
      </section>

      <!-- INVESTIGACIÓN -->

      <section class="ssrn">
        <div class="container">
          <p class="eyebrow reveal">
            INVESTIGACIÓN
          </p>

          <h2 class="reveal">
            La Teoría de la Tolerancia Mínima
          </h2>

          <p class="reveal">
            El artículo fundacional presenta el teorema formal
            y las condiciones bajo las cuales la coerción
            estatal puede ser tolerada
          </p>

          <a
            href={ssrnUrl}
            class="primary reveal"
            target="_blank"
            rel="noopener noreferrer"
          >
            Abrir en SSRN
          </a>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .author-email {
        position: relative;
        display: inline-block;
        color: var(--gold);
        font-size: 1.08rem;
        font-weight: 700;
        text-decoration: none;
      }

      .author-email::after {
        position: absolute;
        right: 0;
        bottom: -3px;
        left: 0;
        height: 1px;
        background: currentColor;
        content: "";
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 220ms ease;
      }

      @media (hover: hover) and (pointer: fine) {
        .author-email:hover::after {
          transform: scaleX(1);
          transform-origin: left;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .author-email::after {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.14,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>

