---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";

const questions = [
  {
    id: "proper-functions-of-government",
    number: "01",
    title: "¿Cuáles son las funciones propias del Estado?",
    short:
      "Las teorías políticas proponen distintas listas de funciones estatales, pero la pregunta previa es qué criterio podría justificar que una función particular quede bajo autoridad coercitiva",
  },
  {
    id: "why-these-functions",
    number: "02",
    title: "¿Por qué estas funciones y no otras?",
    short:
      "La importancia de una actividad no explica por qué debería quedar bajo control político o financiarse mediante coerción",
  },
  {
    id: "principle-that-limits-government",
    number: "03",
    title: "¿Existe un principio que limite al Estado?",
    short:
      "Un límite duradero requiere un criterio específico para cada función que coloque la carga de la prueba sobre quienes proponen la coerción",
  },
  {
    id: "can-coercion-be-justified",
    number: "04",
    title: "¿Puede tolerarse alguna vez la coerción?",
    short:
      "Los resultados útiles, el apoyo democrático y las buenas intenciones no legitiman la coerción; solo condiciones excepcionales pueden sostener, a nivel de una función, un caso de necesidad coercitiva",
  },
  {
    id: "is-the-state-legitimate",
    number: "05",
    title: "¿Cuándo alcanza su límite la cooperación voluntaria?",
    short:
      "Los free riders no son suficientes: sus incentivos deben socavar persistentemente el financiamiento, la coordinación o la participación necesarios para sostener la función",
  },
  {
    id: "how-much-coercion",
    number: "06",
    title: "¿Superar el examen legitima la coerción?",
    short:
      "No. Cumplir las tres condiciones establece, a nivel de una función, un caso de necesidad coercitiva; no justifica ningún arreglo coercitivo en particular",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((question) => ({
    "@type": "Question",
    name: question.title,
    acceptedAnswer: {
      "@type": "Answer",
      text: question.short,
    },
  })),
};
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Preguntas sobre el Estado, la coerción y el poder estatal | Tolerancia Mínima"
      description="Seis preguntas fundamentales sobre las funciones del Estado, los límites de la cooperación voluntaria, la coerción y la carga exigida para admitir una excepción"
      lang="es"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->

      <section class="hero questions-page-hero">
        <div class="hero-content hero-sequence">
          <p class="eyebrow">
            LAS PREGUNTAS
          </p>

          <h1>
            ¿Qué debería permitírsele<br />
            hacer al Estado?
          </h1>
        </div>
      </section>

      <!-- FRASE CENTRAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          ¿Qué distingue una excepción de una licencia para el poder?
        </blockquote>
      </section>

      <!-- EXPLORAR -->

      <section class="questions-index">
        <div class="questions-container">
          <p class="eyebrow reveal">
            EXPLORAR
          </p>

          <nav
            class="questions-index-grid stagger"
            aria-label="Preguntas sobre el Estado y el poder político"
          >
            {
              questions.map((question) => (
                <a
                  href={`#${question.id}`}
                  class="question-index-card reveal"
                >
                  <span class="question-index-number">
                    {question.number}
                  </span>

                  <span class="question-index-title">
                    {question.title}
                  </span>
                </a>
              ))
            }
          </nav>
        </div>
      </section>

      <!-- PREGUNTAS -->

      <section class="questions-content">
        <div class="questions-container">

          <!-- PREGUNTA 01 -->

          <article
            id="proper-functions-of-government"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                01
              </span>

              <h2>
                ¿Cuáles son las funciones propias del Estado?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                Cada filosofía política ofrece una respuesta diferente.
                Algunas restringen al Estado a la policía, los tribunales
                y la defensa nacional, mientras que otras incluyen también
                educación, salud, jubilaciones, infraestructura, política
                monetaria o investigación científica. El desacuerdo es
                fácil de observar, pero encontrar un criterio capaz de
                decidir entre esas funciones en competencia es
                considerablemente más difícil
              </p>

              <p>
                Antes de decidir qué debería hacer el Estado, cada función
                propuesta debe responder una pregunta previa: ¿por qué
                debería esta actividad ser retirada de la cooperación
                voluntaria y colocada bajo autoridad coercitiva? Sin un
                criterio común, los límites políticos se convierten en
                conjuntos de preferencias en lugar de límites coherentes
                al poder
              </p>
            </div>
          </article>

          <!-- PREGUNTA 02 -->

          <article
            id="why-these-functions"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                02
              </span>

              <h2>
                ¿Por qué estas funciones y no otras?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                Los defensores de un Estado limitado suelen identificar
                un pequeño grupo de funciones que deberían permanecer
                bajo control estatal, pero la selección misma exige una
                explicación. ¿Por qué la policía pero no la salud, la
                defensa nacional pero no las jubilaciones, los tribunales
                pero no la investigación científica? Que una actividad
                sea valiosa, difícil o socialmente importante no
                demuestra que deba proveerse mediante coerción
              </p>

              <p>
                Un límite significativo debe explicar por qué una función
                puede calificar como excepción mientras otra permanece
                dentro de la cooperación voluntaria. La tarea no consiste
                en elaborar una lista más corta o más larga, sino en
                aplicar la misma carga de la prueba a cada función
                propuesta
              </p>
            </div>
          </article>

          <!-- PREGUNTA 03 -->

          <article
            id="principle-that-limits-government"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                03
              </span>

              <h2>
                ¿Existe un principio que limite al Estado?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                El debate político se concentra en políticas,
                instituciones y resultados, mientras presta menos
                atención al principio que determina qué poderes puede
                ejercer el Estado. Un límite basado en la tradición,
                la preferencia política o una lista fija de funciones
                conocidas se vuelve inestable cuando aparecen nuevos
                problemas, tecnologías y demandas
              </p>

              <p>
                Un principio limitante duradero debe aplicarse sin
                importar quién gobierne, qué objetivo se persiga o cuán
                atractivo pueda resultar el resultado prometido. Debe
                colocar la carga sobre la coerción y exigir que cada
                excepción propuesta establezca sus propias condiciones
              </p>
            </div>
          </article>

          <!-- PREGUNTA 04 -->

          <article
            id="can-coercion-be-justified"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                04
              </span>

              <h2>
                ¿Puede tolerarse alguna vez la coerción?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                Todo Estado depende en última instancia de la coerción,
                porque las leyes, los impuestos y las regulaciones siguen
                siendo obligatorios incluso para quienes los rechazan.
                Las elecciones, los resultados beneficiosos y las buenas
                intenciones pueden influir en el juicio político, pero no
                transforman una decisión impuesta en una decisión
                voluntaria ni confieren legitimidad moral a la coerción
              </p>

              <p>
                La Tolerancia Mínima pregunta si una función puede
                calificar como excepción por razones de necesidad
                coercitiva. La presunción permanece del lado de la
                cooperación voluntaria, y la carga de establecer la
                excepción pertenece a quienes pretenden imponerla
              </p>
            </div>
          </article>

          <!-- PREGUNTA 05 -->

          <article
            id="is-the-state-legitimate"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                05
              </span>

              <h2>
                ¿Cuándo alcanza su límite la cooperación voluntaria?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                La no exclusión efectiva y la no rivalidad relevante
                pueden crear fuertes incentivos para beneficiarse sin
                contribuir. Pero la existencia de free riders, por sí
                sola, no demuestra que las instituciones voluntarias
                sean incapaces de sostener la función relevante
              </p>

              <p>
                El colapso persistente ocurre cuando esos incentivos
                socavan el financiamiento, la coordinación o la
                participación necesarios para sostener la función a lo
                largo del tiempo y bajo arreglos voluntarios materialmente
                diferentes. Las alternativas plausibles deben permanecer
                genuinamente abiertas. La ausencia de un proveedor actual,
                por sí sola, no demuestra el colapso
              </p>
            </div>
          </article>

          <!-- PREGUNTA 06 -->

          <article
            id="how-much-coercion"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                06
              </span>

              <h2>
                ¿Superar el examen legitima la coerción?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                No. Cuando se establecen conjuntamente la no exclusión
                efectiva, la no rivalidad relevante y el colapso
                persistente de la provisión voluntaria, la función supera
                el Criterio de Tolerancia Mínima por razones de necesidad
                coercitiva. Esto no legitima la coerción ni justifica
                ningún arreglo coercitivo en particular
              </p>

              <p>
                Todo impuesto, organismo, presupuesto, mandato, norma de
                ejecución u otro instrumento coercitivo debe, por tanto,
                justificarse por separado. Que una función supere el
                examen no crea ninguna presunción a favor de otra, y el
                resultado debe reconsiderarse si cambian las condiciones
                que lo sustentaron
              </p>
            </div>
          </article>
        </div>
      </section>

      <!-- CTA FINAL -->

      <section class="questions-cta">
        <div class="questions-container questions-cta-content">
          <div class="reveal reveal-left">
            <p class="eyebrow">
              LA TEORÍA DE LA TOLERANCIA MÍNIMA
            </p>

            <h2>
              La carga de la prueba pertenece al poder
            </h2>

            <p>
              Explorar el marco desarrollado para determinar cuándo una
              función puede superar el examen de necesidad coercitiva sin
              convertir ese resultado en una autorización general para
              el poder político
            </p>
          </div>

          <div class="questions-cta-buttons reveal reveal-right">
            <a
              href="/es/theory"
              class="primary"
            >
              Explorar la Teoría
            </a>

            <a
              href="/es/theorem"
              class="secondary"
            >
              Examinar el Teorema
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .question-index-card {
        transition:
          color 220ms ease,
          background 220ms ease,
          transform 220ms ease;
      }

      .question-index-number {
        transition: transform 220ms ease;
      }

      .question-section {
        overflow: hidden;
      }

      @media (hover: hover) and (pointer: fine) {
        .question-index-card:hover {
          transform: translateY(-2px);
        }

        .question-index-card:hover .question-index-number {
          transform: translateX(5px);
        }
      }

      @media (max-width: 900px) {
        .question-heading.reveal-left,
        .question-copy.reveal-right {
          transform: translateY(24px);
        }

        .question-heading.reveal-left.is-visible,
        .question-copy.reveal-right.is-visible {
          transform: translateY(0);
        }
      }

      @media (max-width: 560px) {
        .questions-statement .reveal {
          transform: translateY(18px);
        }

        .questions-statement .reveal.is-visible {
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .question-index-card,
        .question-index-number {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
