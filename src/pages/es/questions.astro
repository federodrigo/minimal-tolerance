---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";

const questions = [
  {
    id: "funciones-del-estado",
    number: "01",
    title: "¿Qué funciones debe cumplir el Estado?",
    answer: [
      "Ninguna función debe darse por sentada por el solo hecho de atribuírsela al Estado. Cada una debe superar el mismo criterio",
    ],
  },
  {
    id: "carga-prueba-coercion",
    number: "02",
    title: "¿Quién debe probar que la coerción es necesaria?",
    answer: [
      "Quien pretende imponerla. La libertad es el punto de partida y la carga de la prueba recae sobre el poder",
    ],
  },
  {
    id: "legitimidad-coercion-estatal",
    number: "03",
    title: "¿Puede ser legítima la coerción estatal?",
    answer: [
      "No. Que provenga del Estado no la vuelve moralmente legítima",
      "Puede ser tolerable sin dejar de ser ilegítima",
    ],
  },
  {
    id: "democracia-legitima-coercion",
    number: "04",
    title: "¿La democracia legitima la coerción estatal?",
    answer: [
      "No. Votar o elegir un gobernante no le transfiere autoridad moral para decidir por otros en cualquier materia",
      "La aprobación de una mayoría tampoco convierte una decisión impuesta en voluntaria",
    ],
  },
  {
    id: "utilidad-necesidad-coercion",
    number: "05",
    title: "¿La utilidad o necesidad de una función justifica la coerción?",
    answer: [
      "No. Que una función sea útil, necesaria, valiosa o socialmente beneficiosa no basta",
      "La importancia del fin no sustituye el criterio",
    ],
  },
  {
    id: "bienes-publicos-provision-estatal",
    number: "06",
    title: "¿Los bienes públicos requieren provisión estatal?",
    answer: [
      "No. La no exclusión y la no rivalidad describen una estructura del bien, no una conclusión institucional",
      "La provisión puede sostenerse mediante arreglos voluntarios. Samuelson formalizó la estructura de los bienes de consumo colectivo en Teoría Pura del Gasto Público; de allí no se sigue que el Estado deba proveerlos",
    ],
  },
  {
    id: "free-rider-coercion-estatal",
    number: "07",
    title: "¿El problema del free rider justifica la coerción estatal?",
    answer: [
      "No. Que alguien pueda beneficiarse sin contribuir no demuestra que la función no pueda sostenerse",
      "El free rider importa cuando ese incentivo provoca un fracaso persistente bajo arreglos materialmente distintos",
    ],
  },
  {
    id: "fracaso-provision-voluntaria",
    number: "08",
    title: "¿Cuándo fracasa realmente la provisión voluntaria?",
    answer: [
      "Cuando arreglos materialmente distintos fallan de forma persistente porque la misma estructura de incentivos impide sostener la función",
      "Un proveedor fallido, una provisión insuficiente o una ausencia temporal no alcanzan",
    ],
  },
  {
    id: "schmidtz-diferencia",
    number: "09",
    title: "¿En qué se diferencia esta teoría de Schmidtz?",
    answer: [
      "En Los Límites del Gobierno, David Schmidtz muestra que los bienes públicos y los free riders no bastan para justificar autoridad estatal y que ciertos arreglos voluntarios pueden funcionar",
      "Esta teoría convierte el colapso persistente de la provisión voluntaria en una condición necesaria antes de considerar coerción",
    ],
  },
  {
    id: "fallas-mercado-intervencion-estatal",
    number: "10",
    title: "¿Las fallas de mercado justifican la intervención estatal?",
    answer: [
      "No. Monopolio natural, información imperfecta, concentración, problemas de coordinación o provisión insuficiente no demuestran necesidad coercitiva",
      "Esas categorías describen ciertas condiciones del mercado; no prueban que el Estado deba asumir la función",
    ],
  },
  {
    id: "externalidades-positivas-intervencion-estatal",
    number: "11",
    title: "¿Las externalidades positivas justifican la intervención estatal?",
    answer: [
      "No. Que una actividad beneficie a terceros no la convierte en una función estatal",
      "Ese beneficio tampoco prueba no exclusión, no rivalidad ni colapso persistente de la provisión voluntaria",
    ],
  },
  {
    id: "teoria-libertaria",
    number: "12",
    title: "¿Es una teoría libertaria?",
    answer: [
      "Sí. Parte de la libertad como regla y niega legitimidad moral intrínseca a la coerción, provenga del Estado o de cualquier otro",
      "Admite una tolerancia excepcional por necesidad, pero nunca transforma coerción en legitimidad",
    ],
  },
  {
    id: "hayek-gobierno-limitado",
    number: "13",
    title: "¿En qué se diferencia del gobierno limitado de Hayek?",
    answer: [
      "Hayek estudia los límites del conocimiento, el orden espontáneo, las reglas generales y el Estado de derecho",
      "Aquí la cuestión es previa: qué funciones pueden quedar bajo autoridad coercitiva",
    ],
  },
  {
    id: "buchanan-limites-constitucionales",
    number: "14",
    title: "¿En qué se diferencia de Buchanan?",
    answer: [
      "Buchanan estudia las reglas constitucionales dentro de las cuales se toman decisiones colectivas y el papel del acuerdo",
      "Aquí la función debe superar un filtro previo antes de discutir cómo organizarla institucionalmente",
    ],
  },
  {
    id: "rothbard-anarcocapitalismo",
    number: "15",
    title: "¿En qué se diferencia del anarcocapitalismo de Rothbard?",
    answer: [
      "Comparte con Rothbard que la coerción es moralmente ilegítima, provenga del Estado o de cualquier otro",
      "Se diferencia en que admite tolerar una función coercitiva por necesidad cuando supera el criterio, sin volverla legítima",
    ],
  },
  {
    id: "minarquismo",
    number: "16",
    title: "¿Conduce al minarquismo?",
    answer: [
      "No. El minarquismo suele limitar al Estado a defensa, policía y tribunales",
      "El criterio puede admitir otras funciones si cumplen sus condiciones, por lo que el ámbito tolerable puede ir más allá del Estado mínimo",
    ],
  },
  {
    id: "nozick-estado-minimo",
    number: "17",
    title: "¿En qué se diferencia del Estado mínimo de Nozick?",
    answer: [
      "En Anarquía, Estado y Utopía, Nozick defiende un Estado mínimo moralmente legítimo, concentrado en funciones de protección",
      "Aquí el Estado nunca adquiere legitimidad moral y el ámbito tolerable puede superar ese núcleo",
    ],
  },
  {
    id: "estado-autolimitacion",
    number: "18",
    title: "¿Puede el Estado limitarse a sí mismo?",
    answer: [
      "Solo de forma imperfecta. Quien ejerce el poder también participa en la definición, interpretación y modificación de sus propios límites",
      "Por eso la restricción no puede descansar únicamente en la voluntad de quien gobierna",
    ],
  },
  {
    id: "ausencia-alternativas-estado-necesario",
    number: "19",
    title: "¿La ausencia de alternativas voluntarias prueba que el Estado es necesario?",
    answer: [
      "No. Un monopolio legal o una provisión estatal prolongada puede impedir que aparezcan proveedores, capacidades e instituciones alternativas",
      "Que hoy no exista una alternativa no demuestra un fracaso persistente de la provisión voluntaria",
    ],
  },
  {
    id: "funcion-justifica-cualquier-intervencion",
    number: "20",
    title: "¿Que una función justifique coerción justifica cualquier intervención estatal?",
    answer: [
      "No. Que una función supere el criterio no autoriza cualquier impuesto, agencia, monopolio, mandato, presupuesto o forma de ejecución",
      "Cada instrumento coercitivo enfrenta una segunda carga de prueba",
    ],
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((question) => ({
    "@type": "Question",
    name: question.title,
    acceptedAnswer: {
      "@type": "Answer",
      text: question.answer.join(" "),
    },
  })),
};
---
<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Límites del Estado, coerción y bienes públicos | Tolerancia Mínima"
      description="Preguntas sobre coerción estatal, bienes públicos, free riders, fallas de mercado, externalidades, libertarismo, anarcocapitalismo, minarquismo y límites del Estado"
      lang="es"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    ></script>
  </head>

  <body>
    <Header />

    <main>
      <section class="hero questions-page-hero">
        <div class="hero-content hero-sequence">
          <p class="eyebrow">
            LAS PREGUNTAS
          </p>

          <h1>
            ¿Qué debería permitirse<br />
            al Estado?
          </h1>
        </div>
      </section>

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          Una excepción no es una licencia para el poder
        </blockquote>
      </section>

      <section class="questions-index">
        <div class="questions-container">
          <p class="eyebrow reveal">
            EXPLORAR
          </p>

          <p class="questions-intro reveal">
            Preguntas sobre qué puede justificar la coerción y dónde termina el poder del Estado
          </p>

          <nav
            class="questions-index-grid stagger"
            aria-label="Preguntas sobre el Estado, la coerción, los bienes públicos y el poder político"
          >
            {
              questions.map((question) => (
                <a
                  href={`#${question.id}`}
                  class="question-index-card reveal"
                >
                  <span class="question-index-number">
                    {question.number}
                  </span>

                  <span class="question-index-title">
                    {question.title}
                  </span>
                </a>
              ))
            }
          </nav>
        </div>
      </section>

      <section class="questions-content">
        <div class="questions-container">
          {
            questions.map((question) => (
              <article
                id={question.id}
                class="question-section"
              >
                <div class="question-heading reveal reveal-left">
                  <span class="question-number">
                    {question.number}
                  </span>

                  <h2>
                    {question.title}
                  </h2>
                </div>

                <div class="question-copy reveal reveal-right">
                  {question.answer.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="questions-cta">
        <div class="questions-container questions-cta-content">
          <div class="reveal reveal-left">
            <p class="eyebrow">
              LA TEORÍA DE LA TOLERANCIA MÍNIMA
            </p>

            <h2>
              La carga de la prueba pertenece al poder
            </h2>

            <p>
              Explora el criterio que determina cuándo una función puede
              superar el examen de necesidad coercitiva sin convertir
              tolerancia en legitimidad
            </p>
          </div>

          <div class="questions-cta-buttons reveal reveal-right">
            <a href="/es/theory" class="primary">
              Explorar la Teoría
            </a>

            <a href="/es/theorem" class="secondary">
              Examinar el Teorema
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .question-index-card {
        transition:
          color 220ms ease,
          background 220ms ease,
          transform 220ms ease;
      }

      .question-index-number {
        transition: transform 220ms ease;
      }

      .questions-intro {
        max-width: 760px;
        margin: 0 0 2rem;
        font-size: 1rem;
        line-height: 1.55;
        opacity: 0.82;
      }

      .question-index-title {
        font-size: clamp(0.95rem, 1vw, 1.08rem);
        line-height: 1.28;
      }

      .question-heading h2 {
        font-size: clamp(1.2rem, 1.8vw, 1.8rem);
        line-height: 1.12;
      }

      .question-section {
        overflow: hidden;
      }

      @media (hover: hover) and (pointer: fine) {
        .question-index-card:hover {
          transform: translateY(-2px);
        }

        .question-index-card:hover .question-index-number {
          transform: translateX(5px);
        }
      }

      @media (max-width: 900px) {
        .questions-intro {
          margin-bottom: 1.6rem;
          font-size: 0.98rem;
        }

        .question-index-title {
          font-size: 0.95rem;
        }

        .question-heading h2 {
          font-size: clamp(1.1rem, 3.7vw, 1.4rem);
        }

        .question-heading.reveal-left,
        .question-copy.reveal-right {
          transform: translateY(24px);
        }

        .question-heading.reveal-left.is-visible,
        .question-copy.reveal-right.is-visible {
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .question-index-card,
        .question-index-number {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>

