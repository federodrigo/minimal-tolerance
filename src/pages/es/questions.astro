---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";

const questions = [
  {
    id: "funciones-apropiadas-del-gobierno",
    number: "01",
    title: "¿Cuáles Son las Funciones del Estado?",
    short:
      "Las teorías políticas proponen distintas funciones para el Estado, pero la pregunta previa es qué criterio puede justificar que una función concreta quede sometida a autoridad coercitiva",
  },
  {
    id: "por-que-estas-funciones",
    number: "02",
    title: "¿Por Qué Estas Funciones y No Otras?",
    short:
      "La importancia de una actividad no explica por qué debería quedar bajo control político o financiarse mediante coerción",
  },
  {
    id: "principio-que-limita-al-gobierno",
    number: "03",
    title: "¿Existe un Principio que Limite al Gobierno?",
    short:
      "Un límite duradero requiere un criterio aplicable a cada función y una carga de la prueba que recaiga sobre quienes proponen la coerción",
  },
  {
    id: "puede-justificarse-la-coercion",
    number: "04",
    title: "¿Puede Tolerarse Alguna Vez la Coerción?",
    short:
      "Los resultados útiles, el apoyo democrático y las buenas intenciones no confieren legitimidad moral a la coerción; a lo sumo, condiciones excepcionales pueden volverla tolerable",
  },
  {
    id: "es-legitimo-el-estado",
    number: "05",
    title: "¿Es Legítimo el Estado?",
    short:
      "Las instituciones políticas no adquieren autoridad moral intrínseca por existir, gobernar democráticamente o producir beneficios colectivos",
  },
  {
    id: "cuanta-coercion-es-demasiada",
    number: "06",
    title: "¿Dónde Termina la Coerción Tolerable?",
    short:
      "Toda excepción debe permanecer limitada a una función concreta y a las condiciones que permitieron considerarla tolerable",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((question) => ({
    "@type": "Question",
    name: question.title,
    acceptedAnswer: {
      "@type": "Answer",
      text: question.short,
    },
  })),
};
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Preguntas Sobre el Gobierno, la Coerción y el Poder del Estado | Tolerancia Mínima"
      description="Seis preguntas fundamentales sobre las funciones del Estado, la legitimidad política, la coerción y la carga necesaria para admitir una excepción a la cooperación voluntaria"
      lang="es"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->

      <section class="hero questions-page-hero">
        <div class="hero-content hero-sequence">
          <p class="eyebrow">
            LAS PREGUNTAS
          </p>

          <h1>
            ¿Qué debería poder<br />
            hacer el gobierno?
          </h1>

          <p class="lead">
            Las preguntas detrás de la Teoría de la Tolerancia Mínima
          </p>
        </div>
      </section>

      <!-- FRASE CENTRAL -->

      <section class="questions-statement">
        <div class="questions-container">
          <p class="reveal reveal-scale">
            Las distintas tradiciones políticas discrepan acerca del
            papel del gobierno, los límites de su poder y las
            condiciones bajo las cuales puede tolerarse la coerción.
            <br />
            La pregunta previa es qué criterio permite distinguir una
            excepción genuina de una autorización general para ejercer
            poder político
          </p>
        </div>
      </section>

      <!-- EXPLORAR -->

      <section class="questions-index">
        <div class="questions-container">
          <p class="eyebrow reveal">
            EXPLORAR
          </p>

          <nav
            class="questions-index-grid stagger"
            aria-label="Preguntas sobre el gobierno y el poder político"
          >
            {
              questions.map((question) => (
                <a
                  href={`#${question.id}`}
                  class="question-index-card reveal"
                >
                  <span class="question-index-number">
                    {question.number}
                  </span>

                  <span class="question-index-title">
                    {question.title}
                  </span>
                </a>
              ))
            }
          </nav>
        </div>
      </section>

      <!-- PREGUNTAS -->

      <section class="questions-content">
        <div class="questions-container">
          <article
            id="funciones-apropiadas-del-gobierno"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                01
              </span>

              <h2>
                ¿Cuáles Son las Funciones del Estado?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                Toda filosofía política ofrece una respuesta diferente.
                Algunas limitan al gobierno a la policía, los tribunales
                y la defensa nacional, mientras que otras también
                incluyen la educación, la salud, las jubilaciones, la
                infraestructura, la política monetaria o la
                investigación científica. El desacuerdo es fácil de
                observar; encontrar un criterio capaz de decidir entre
                esas funciones resulta mucho más difícil
              </p>

              <p>
                Antes de decidir qué debería hacer el gobierno, cada
                función debe responder una pregunta previa: ¿por qué
                debería salir del ámbito de la cooperación voluntaria
                y quedar sometida a autoridad coercitiva? Sin un criterio
                común, los límites políticos se convierten en una
                colección de preferencias
              </p>
            </div>
          </article>

          <article
            id="por-que-estas-funciones"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                02
              </span>

              <h2>
                ¿Por Qué Estas Funciones y No Otras?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                Los defensores de un gobierno limitado suelen
                identificar un pequeño grupo de funciones que deberían
                permanecer bajo control estatal, pero la propia
                selección requiere una explicación. ¿Por qué la
                policía, pero no la salud; la defensa nacional, pero no
                las jubilaciones; los tribunales, pero no la
                investigación científica? Que una actividad sea valiosa,
                difícil o socialmente importante no demuestra que deba
                proporcionarse mediante coerción
              </p>

              <p>
                Un límite significativo debe explicar por qué una
                función puede convertirse en excepción mientras otra
                permanece dentro de la cooperación voluntaria. La tarea
                no consiste en elaborar una lista más corta o más extensa,
                sino en aplicar la misma carga de la prueba a cada
                función propuesta
              </p>
            </div>
          </article>

          <article
            id="principio-que-limita-al-gobierno"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                03
              </span>

              <h2>
                ¿Existe un Principio que Limite al Gobierno?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                El debate político se concentra en políticas,
                instituciones y resultados, mientras dedica menos
                atención al principio que determina qué poderes puede
                ejercer el gobierno. Un límite basado en la tradición,
                la preferencia política o una lista fija de funciones
                se vuelve inestable cuando aparecen nuevos problemas,
                tecnologías y demandas
              </p>

              <p>
                Un principio limitante duradero debe aplicarse con
                independencia de quién gobierne, del objetivo perseguido
                o de lo atractivo que resulte el desenlace prometido.
                Debe colocar la carga sobre la coerción y exigir que cada
                excepción demuestre por separado las condiciones que
                permiten considerarla
              </p>
            </div>
          </article>

          <article
            id="puede-justificarse-la-coercion"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                04
              </span>

              <h2>
                ¿Puede Tolerarse Alguna Vez la Coerción?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                Todo gobierno depende en última instancia de la
                coerción, porque las leyes, los impuestos y las
                regulaciones continúan siendo obligatorios incluso para
                quienes los rechazan. Las elecciones, los resultados
                beneficiosos y las buenas intenciones pueden influir en
                la evaluación política, pero no convierten una decisión
                impuesta en voluntaria ni confieren legitimidad moral
                a la coerción
              </p>

              <p>
                La Tolerancia Mínima plantea una pregunta más estrecha:
                si determinadas condiciones excepcionales pueden volver
                tolerable una respuesta coercitiva limitada como último
                recurso. La cooperación voluntaria conserva la
                presunción inicial y la carga de demostrar la excepción
                recae sobre quienes proponen imponerla
              </p>
            </div>
          </article>

          <article
            id="es-legitimo-el-estado"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                05
              </span>

              <h2>
                ¿Es Legítimo el Estado?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                El Estado suele ser tratado como una institución
                moralmente excepcional cuya autoridad se deriva de las
                elecciones, las constituciones, el consentimiento
                colectivo o los beneficios que produce. Esos elementos
                pueden tener relevancia política, pero no transforman
                por sí mismos el ejercicio de poder coercitivo en
                autoridad moral
              </p>

              <p>
                La Teoría de la Tolerancia Mínima distingue legitimidad
                de tolerabilidad. Una función coercitiva puede, bajo
                condiciones excepcionales, superar un examen exigente
                sin adquirir por ello legitimidad moral. Toda tolerancia
                queda limitada a esa función y a las condiciones que
                permitieron la excepción
              </p>
            </div>
          </article>

          <article
            id="cuanta-coercion-es-demasiada"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                06
              </span>

              <h2>
                ¿Dónde Termina la Coerción Tolerable?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                Si toda imperfección, beneficio colectivo o resultado
                deseable abre la puerta a la intervención, ningún límite
                significativo sobre el poder político puede sobrevivir.
                Una excepción debe permanecer estrecha, referida a una
                función concreta y sin crear una presunción favorable a
                nuevas formas de coerción
              </p>

              <p>
                La Teoría de la Tolerancia Mínima exige no exclusión
                efectiva, no rivalidad relevante y una demostración
                independiente de que la provisión voluntaria fracasa
                persistentemente en sostener la función examinada.
                Incluso cuando concurren las tres condiciones, la
                coerción no queda legitimada: el caso únicamente ha
                superado el examen inicial
              </p>
            </div>
          </article>
        </div>
      </section>

      <!-- CTA FINAL -->

      <section class="questions-cta">
        <div class="questions-container questions-cta-content">
          <div class="reveal reveal-left">
            <p class="eyebrow">
              LA TEORÍA DE LA TOLERANCIA MÍNIMA
            </p>

            <h2>
              La carga de la prueba pertenece al poder
            </h2>

            <p>
              Explora el marco desarrollado para determinar cuándo una
              excepción coercitiva puede entrar en consideración sin
              convertir la necesidad en una autorización general para
              ejercer poder político
            </p>
          </div>

          <div class="questions-cta-buttons reveal reveal-right">
            <a
              href="/es/theory"
              class="primary"
            >
              Explorar la Teoría
            </a>

            <a
              href="/es/theorem"
              class="secondary"
            >
              Examinar el Teorema
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .question-index-card {
        transition:
          color 220ms ease,
          background 220ms ease,
          transform 220ms ease;
      }

      .question-index-number {
        transition: transform 220ms ease;
      }

      .question-section {
        overflow: hidden;
      }

      @media (hover: hover) and (pointer: fine) {
        .question-index-card:hover {
          transform: translateY(-2px);
        }

        .question-index-card:hover .question-index-number {
          transform: translateX(5px);
        }
      }

      @media (max-width: 900px) {
        .question-heading.reveal-left,
        .question-copy.reveal-right {
          transform: translateY(24px);
        }

        .question-heading.reveal-left.is-visible,
        .question-copy.reveal-right.is-visible {
          transform: translateY(0);
        }
      }

      @media (max-width: 560px) {
        .questions-statement .reveal {
          transform: translateY(18px);
        }

        .questions-statement .reveal.is-visible {
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .question-index-card,
        .question-index-number {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
