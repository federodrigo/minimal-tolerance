---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";

const questions = [
  {
    id: "libertad-punto-partida-moral",
    number: "01",
    title: "¿Por qué la libertad debe ser el punto de partida moral?",
    answer: [
      "Porque la coerción obliga a quien no consintió. Los beneficios, la equidad o los buenos resultados pueden importar, pero restringir la libertad exige justificación",
    ],
  },
  {
    id: "carga-prueba-coercion",
    number: "02",
    title: "¿Quién debe probar que la coerción es necesaria?",
    answer: [
      "Quien pretende imponerla. La libertad es el punto de partida; la carga de la prueba pertenece al poder",
    ],
  },
  {
    id: "legitimidad-moral-estado",
    number: "03",
    title: "¿Es el Estado moralmente legítimo?",
    answer: [
      "No. El Estado reclama autoridad coercitiva sobre quienes no la han consentido",
      "Las leyes y las elecciones pueden regular ese poder; no convierten la coerción en consentimiento",
    ],
  },
  {
    id: "mejores-resultados-coercion-estatal",
    number: "04",
    title: "¿Mejores resultados justifican la coerción estatal?",
    answer: [
      "No. Los buenos resultados importan, pero los beneficios sociales esperados no crean por sí solos un derecho a obligar a otros",
      "De lo contrario, casi cualquier intromisión podría defenderse prometiendo beneficios suficientes",
    ],
  },
  {
    id: "democracia-legitima-coercion",
    number: "05",
    title: "¿La democracia legitima la coerción estatal?",
    answer: [
      "No. Las elecciones determinan quién ejerce el poder y bajo qué reglas; no convierten decisiones obligatorias en consentimiento individual",
      "El apoyo mayoritario otorga autorización política, no legitimidad moral",
    ],
  },
  {
    id: "estado-organizacion-criminal",
    number: "06",
    title: "¿Es el Estado una organización criminal?",
    answer: [
      "Sí, en un sentido normativo. La tributación, la jurisdicción obligatoria y la imposición de decisiones serían coercitivas si una asociación privada las ejerciera sin consentimiento",
      "La autorización legal no resuelve su estatus moral",
    ],
  },
  {
    id: "funciones-del-estado",
    number: "07",
    title: "¿Qué funciones debe cumplir el Estado?",
    answer: [
      "Ninguna función queda exenta de antemano. Defensa, justicia, educación, salud y las demás deben evaluarse por separado",
      "La pregunta es si la coerción resulta necesaria para esa función",
    ],
  },
  {
    id: "eficiencia-estado",
    number: "08",
    title: "¿Puede el Estado ser eficiente?",
    answer: [
      "No, no como institución. Un organismo público puede ejecutar bien una tarea concreta",
      "El Estado sigue sujeto a límites estructurales de información, cálculo, incentivos, competencia, posibilidad de salida y corrección de errores que la gestión no puede eliminar",
    ],
  },
  {
    id: "servicios-esenciales-coercion-estatal",
    number: "09",
    title: "¿Los servicios esenciales justifican la coerción estatal?",
    answer: [
      "No. Ni la importancia ni la urgencia demuestran que la provisión obligatoria sea necesaria",
      "El valor del fin y los medios usados para alcanzarlo son cuestiones distintas",
    ],
  },
  {
    id: "desigualdad-economica-coercion-estatal",
    number: "10",
    title: "¿La desigualdad económica justifica la coerción estatal?",
    answer: [
      "No. Las diferencias económicas no son injustas por sí mismas",
      "Pueden surgir del trabajo, las decisiones, la suerte, la herencia, los privilegios, el fraude o la agresión. Cuando hay una violación de derechos, ese es el problema, no el resultado desigual",
    ],
  },
  {
    id: "pobreza-coercion-estatal",
    number: "11",
    title: "¿La pobreza justifica la coerción estatal?",
    answer: [
      "No. La pobreza puede exigir ayuda urgente, pero la necesidad por sí sola no otorga autoridad para obligar a terceros a prestar o financiar asistencia",
    ],
  },
  {
    id: "bienes-publicos-provision-estatal",
    number: "12",
    title: "¿Los bienes públicos requieren provisión estatal?",
    answer: [
      "No. La no exclusión y la no rivalidad describen un bien, no quién debe proveerlo",
      "Samuelson formalizó el consumo colectivo; esa clasificación no establece por sí sola una función estatal",
    ],
  },
  {
    id: "free-rider-coercion-estatal",
    number: "13",
    title: "¿El problema del free rider justifica la coerción estatal?",
    answer: [
      "No. Beneficiarse sin pagar no demuestra que la provisión voluntaria vaya a colapsar",
      "El free riding importa cuando el mismo problema de incentivos hace fracasar de forma persistente arreglos materialmente distintos",
    ],
  },
  {
    id: "fracaso-provision-voluntaria",
    number: "14",
    title: "¿Cuándo fracasa realmente la provisión voluntaria?",
    answer: [
      "Cuando arreglos materialmente distintos colapsan repetidamente porque la misma estructura de incentivos impide una provisión estable",
      "Un proveedor fallido, una insuficiencia temporal o la ausencia actual de alternativas no bastan",
    ],
  },
  {
    id: "ausencia-alternativas-voluntarias-estado-necesario",
    number: "15",
    title: "¿La ausencia de alternativas voluntarias prueba que el Estado es necesario?",
    answer: [
      "No. Que hoy no exista una opción voluntaria no demuestra que la provisión coercitiva sea necesaria",
      "El monopolio, la regulación, los subsidios o la provisión estatal previa pueden haber impedido su aparición",
    ],
  },
  {
    id: "fallas-mercado-intervencion-estatal",
    number: "16",
    title: "¿Las fallas de mercado justifican la intervención estatal?",
    answer: [
      "No. El monopolio, la información imperfecta, la concentración, los problemas de coordinación o la provisión insuficiente pueden revelar fallas del mercado",
      "No demuestran que la intervención estatal sea necesaria ni superior",
    ],
  },
  {
    id: "externalidades-intervencion-estatal",
    aliases: [
      "externalidades-positivas-intervencion-estatal",
      "externalidades-negativas-intervencion-estatal",
    ],
    number: "17",
    title: "¿Las externalidades justifican la intervención estatal?",
    answer: [
      "No automáticamente. Las externalidades positivas no crean un derecho a obligar a otros a pagar",
      "Las negativas pueden implicar daño; entonces importan los derechos, la responsabilidad y la compensación, no una licencia general para intervenir",
    ],
  },
  {
    id: "accion-colectiva-intervencion-estatal",
    number: "18",
    title: "¿Los problemas de acción colectiva requieren intervención estatal?",
    answer: [
      "No. Contratos, empresas, clubes, asociaciones, seguros, organizaciones benéficas y normas pueden coordinar muchas tareas colectivas sin autoridad coercitiva",
      "El fracaso de un arreglo o cierta provisión insuficiente no prueban necesidad coercitiva",
    ],
  },
  {
    id: "schmidtz-bienes-publicos-free-riders",
    number: "19",
    title: "¿Qué sostiene David Schmidtz sobre los bienes públicos y los free riders?",
    answer: [
      "En <em>The Limits of Government</em>, Schmidtz sostiene que los bienes públicos y los free riders no establecen automáticamente autoridad estatal y muestra que pueden funcionar arreglos voluntarios",
      "Tolerancia Mínima agrega una condición más estricta: solo puede considerarse coerción tras un colapso persistente en arreglos voluntarios materialmente distintos",
    ],
  },
  {
    id: "economia-keynesiana-intervencion-estatal",
    number: "20",
    title: "¿La economía keynesiana justifica la intervención estatal?",
    answer: [
      "No por sí sola. El keynesianismo ofrece razones para la estabilización fiscal o monetaria durante las recesiones",
      "Aunque esas políticas mejoren resultados, su eficacia no resuelve si se justifican el financiamiento o el control obligatorios",
    ],
  },
  {
    id: "rawls-redistribucion",
    number: "21",
    title: "¿Rawls justifica la redistribución?",
    answer: [
      "Sí, bajo ciertas condiciones. Sus principios pueden respaldarla cuando las instituciones respetan libertades iguales, oportunidades justas y mejoran la posición de los menos aventajados",
      "Tolerancia Mínima pregunta si esos fines también justifican la coerción",
    ],
  },
  {
    id: "musgrave-funciones-estado",
    number: "22",
    title: "¿Cuáles son las tres funciones del Estado según Musgrave?",
    answer: [
      "Asignación, distribución y estabilización",
      "Musgrave clasifica grandes funciones de las finanzas públicas; esa clasificación no demuestra que alguna requiera provisión o financiamiento obligatorios",
    ],
  },
  {
    id: "libertarismo-coercion-estatal",
    number: "23",
    title: "¿Puede una teoría libertaria tolerar la coerción estatal?",
    answer: [
      "Sí, excepcionalmente. Tolerancia Mínima rechaza que la coerción sea moralmente legítima, pero tolera una función cuando su necesidad está establecida y no queda una alternativa voluntaria viable",
    ],
  },
  {
    id: "hayek-limites-poder-estatal",
    number: "24",
    title: "¿Qué limita el poder del Estado en la teoría política de Hayek?",
    answer: [
      "Hayek destaca el conocimiento disperso, el orden espontáneo, las reglas generales y el Estado de derecho",
      "Tolerancia Mínima plantea una pregunta anterior: qué funciones, si alguna, pueden quedar bajo autoridad coercitiva",
    ],
  },
  {
    id: "buchanan-economia-politica-constitucional",
    number: "25",
    title: "¿Qué limita al Estado en la economía política constitucional de Buchanan?",
    answer: [
      "Buchanan se centra en las reglas constitucionales de la decisión colectiva y el papel del acuerdo",
      "Tolerancia Mínima pregunta si una función puede asignarse coercitivamente antes de elegir su diseño institucional",
    ],
  },
  {
    id: "rothbard-anarcocapitalismo-coercion-estatal",
    number: "26",
    title: "¿El anarcocapitalismo de Rothbard rechaza toda coerción estatal?",
    answer: [
      "Sí. Rothbard rechaza la provisión estatal obligatoria y considera ilegítima la coerción sin importar quién la ejerza",
      "Tolerancia Mínima comparte ese punto de partida, pero admite una tolerancia excepcional cuando se establece la necesidad",
    ],
  },
  {
    id: "minarquismo-defensa-policia-tribunales",
    number: "27",
    title: "¿El minarquismo justifica un Estado limitado a defensa, policía y tribunales?",
    answer: [
      "El minarquismo trata defensa, policía y tribunales como el núcleo legítimo de un Estado mínimo",
      "Tolerancia Mínima no les concede una excepción automática; cada función debe superar el mismo examen",
    ],
  },
  {
    id: "nozick-estado-minimo-legitimidad",
    number: "28",
    title: "¿Es moralmente legítimo el Estado mínimo de Nozick?",
    answer: [
      "En <em>Anarquía, Estado y Utopía</em>, Nozick sostiene que un Estado mínimo puede surgir sin violar derechos y ser, por tanto, legítimo",
      "Tolerancia Mínima rechaza esa conclusión: un menor alcance no cambia el estatus moral de la autoridad coercitiva",
    ],
  },
];

const stripHtml = (value) =>
  value.replace(/<[^>]*>/g, "");

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((question) => ({
    "@type": "Question",
    name: question.title,
    acceptedAnswer: {
      "@type": "Answer",
      text: question.answer.map(stripHtml).join(" "),
    },
  })),
};
---
<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="¿Qué debería permitirse al Estado? | Tolerancia Mínima"
      description="¿Cuándo se justifica la intervención estatal? 28 preguntas concisas sobre legitimidad, coerción, bienes públicos, fallas de mercado, externalidades, desigualdad, Keynes, Rawls y poder estatal"
      lang="es"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    ></script>
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->

      <section class="hero questions-page-hero">
        <div class="hero-content hero-sequence">
          <p class="eyebrow">
            LAS PREGUNTAS
          </p>

          <h1>
            ¿Qué debería permitirse<br />
            al Estado?
          </h1>
        </div>
      </section>

      <!-- CENTRAL STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
         Nadie tiene un derecho inherente a gobernar a otro
        </blockquote>
      </section>

      <!-- PREGUNTAS CLAVE -->

      <section class="questions-index">
        <div class="questions-container">
          <p class="eyebrow reveal key-questions-label">
            PREGUNTAS CLAVE
          </p>

          <nav
            class="questions-index-grid stagger"
            aria-label="Preguntas sobre el Estado, la coerción, los bienes públicos y el poder político"
          >
            {
              questions.map((question) => (
                <a
                  href={`#${question.id}`}
                  class="question-index-card reveal"
                >
                  <span class="question-index-number">
                    {question.number}
                  </span>

                  <span class="question-index-title">
                    {question.title}
                  </span>
                </a>
              ))
            }
          </nav>
        </div>
      </section>

      <!-- PREGUNTAS -->

      <section class="questions-content">
        <div class="questions-container">
          {
            questions.map((question) => (
              <article
                id={question.id}
                class="question-section"
              >
                {question.aliases?.map((alias) => (
                  <span id={alias} class="anchor-alias" aria-hidden="true"></span>
                ))}
                <div class="question-heading reveal reveal-left">
                  <span class="question-number">
                    {question.number}
                  </span>

                  <h2>
                    {question.title}
                  </h2>
                </div>

                <div class="question-copy reveal reveal-right">
                  {question.answer.map((paragraph) => (
                    <p set:html={paragraph}></p>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- CTA FINAL -->

      <section class="questions-cta">
        <div class="questions-container questions-cta-content">
          <div class="reveal reveal-left">
            <p class="eyebrow">
              LA TEORÍA DE LA TOLERANCIA MÍNIMA
            </p>

            <h2>
              La carga de la prueba pertenece al poder
            </h2>

            <p>
              Explora el criterio que determina cuándo una función puede
              superar el examen de necesidad coercitiva sin convertir
              tolerancia en legitimidad
            </p>
          </div>

          <div class="questions-cta-buttons reveal reveal-right">
            <a href="/es/theory" class="primary">
              Explorar la Teoría
            </a>

            <a href="/es/theorem" class="secondary">
              Examinar el Teorema
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /*
       * Force a true two-column grid here so each pair of questions
       * shares the exact same row height.
       */
      .key-questions-label {
  color: #a07d37 !important;
  font-size: 1.15rem;
  letter-spacing: 0.14em;
  margin-bottom: 1.25rem;
}

      .questions-index-grid {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        grid-auto-flow: row !important;
        gap: 0 !important;
        align-items: stretch !important;
      }

      .question-index-card {
        box-sizing: border-box !important;
        display: grid !important;
        grid-template-columns: 3.1rem minmax(0, 1fr) !important;
        align-items: start !important;
        align-content: start !important;
        column-gap: 1rem !important;
        width: 100% !important;
        height: 100% !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 1rem 1.15rem 1rem 0 !important;
        transition:
          color 220ms ease,
          background 220ms ease,
          transform 220ms ease;
      }

      .question-index-card:nth-child(odd) {
        border-right: 1px solid var(--line, rgba(20, 30, 40, 0.14)) !important;
        padding-right: 1.4rem !important;
      }

      .question-index-card:nth-child(even) {
        padding-left: 2rem !important;
      }

      .question-index-number,
      .question-index-title {
        align-self: start !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .question-index-number {
        line-height: 1.28 !important;
        transition: transform 220ms ease;
      }

      .question-index-title {
        display: block !important;
        line-height: 1.28;
      }

      /*
       * Keep the index type exactly at the approved size.
       */
      .question-index-title {
        font-size: clamp(0.95rem, 1vw, 1.08rem);
      }

      /*
       * Developed-question title: 10% smaller than the previous version.
       * Right-side answer size is untouched.
       */
      .question-number {
        display: inline-block;
        transform: scale(1.5);
        transform-origin: left top;
      }

      .question-heading h2 {
        font-size: clamp(1.08rem, 1.62vw, 1.62rem);
        line-height: 1.12;
      }

      .question-section {
        position: relative;
        overflow: hidden;
      }

      .anchor-alias {
        position: absolute;
        top: 0;
        left: 0;
        width: 0;
        height: 0;
      }

      @media (hover: hover) and (pointer: fine) {
        .question-index-card:hover {
          transform: translateY(-2px);
        }

        .question-index-card:hover .question-index-number {
          transform: translateX(5px);
        }
      }

      @media (max-width: 900px) {
        .questions-index-grid {
          grid-template-columns: 1fr !important;
        }

        .question-index-card,
        .question-index-card:nth-child(odd),
        .question-index-card:nth-child(even) {
          grid-template-columns: 2.75rem minmax(0, 1fr) !important;
          column-gap: 0.85rem !important;
          padding: 0.9rem 0 !important;
          border-right: 0 !important;
        }

        .question-index-title {
          font-size: 0.95rem;
        }

        .question-heading h2 {
          font-size: clamp(0.99rem, 3.33vw, 1.26rem);
        }

        .question-heading.reveal-left,
        .question-copy.reveal-right {
          transform: translateY(24px);
        }

        .question-heading.reveal-left.is-visible,
        .question-copy.reveal-right.is-visible {
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .question-index-card,
        .question-index-number {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
