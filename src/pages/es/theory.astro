---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="El Problema de la Tolerancia | Tolerancia Mínima"
      description="Los fundamentos morales, económicos e institucionales de la Teoría de la Tolerancia Mínima"
      lang="es"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- TÍTULO DE PÁGINA -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            LA TEORÍA
          </p>

          <h1>
            El problema de la tolerancia
          </h1>
<p class="story-trail" aria-label="Recorrido de lectura"><span class="story-step">Preguntas</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step is-current">Teoría</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step">Teorema</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step">Casos</span></p>
        </div>
      </section>

      <!-- FRASE INICIAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          La coerción puede tolerarse, no legitimarse
        </blockquote>
      </section>

      <!-- PROBLEMA MORAL -->

      <section class="content-section">
        <div class="container theory-block">
          <p class="eyebrow reveal">
            EL PROBLEMA MORAL
          </p>

          <h2 class="reveal">
            La autoridad política descansa<br />sobre la coerción
          </h2>

          <p class="reveal">
            El Estado puede imponer impuestos, normas y prohibiciones incluso a quienes no están de acuerdo. Tener autoridad política no vuelve moralmente legítima esa coerción
          </p>
        </div>
      </section>

      <!-- PROBLEMA DE EFICIENCIA -->

      <section class="content-section content-section-alt">
        <div class="container theory-block manuscript-split"><div class="manuscript-copy">
          <p class="eyebrow reveal">
            EL PROBLEMA DE EFICIENCIA
          </p>

          <h2 class="reveal theory-efficiency-heading"><span class="heading-line">Los límites de las</span><span class="heading-line">decisiones centralizadas</span></h2>

          <p class="reveal">
            Ninguna autoridad central puede reunir todo el conocimiento necesario para coordinar una sociedad compleja. Buena parte está dispersa, cambia constantemente y se descubre mediante precios, competencia y experimentación. Centralizar las decisiones no elimina esos límites
          </p>
        </div><figure class="manuscript-scene reveal reveal-right" role="img" aria-label="Torre central frente a decisiones dispersas"><span class="scene-picture scene-theory" aria-hidden="true"></span></figure></div>
      </section>

      <!-- PRESUNCIÓN DE LIBERTAD -->

      <section class="content-section">
        <div class="container theory-block">
          <p class="eyebrow reveal">
            PRESUNCIÓN DE LIBERTAD
          </p>

          <h2 class="reveal theory-proof-heading">
            La carga de la prueba pertenece al poder
          </h2>

          <p class="reveal">
            Detectar un problema no demuestra que sea necesaria la intervención estatal. Quien propone recurrir a la coerción debe demostrar por qué las alternativas voluntarias no pueden sostener esa función
          </p>
        </div>
      </section>

      <!-- PROBLEMA DEL FREE RIDER -->

      <section class="content-section content-section-alt">
        <div class="container theory-block">
          <p class="eyebrow reveal">
            EL PROBLEMA DEL FREE RIDER
          </p>

          <h2 class="reveal">
            Cuando falla la provisión voluntaria
          </h2>

          <p class="reveal">
            Cuando alguien puede beneficiarse sin contribuir, sostener una función voluntariamente puede resultar difícil. Pero eso no basta para demostrar la necesidad de coerción. El teorema exige tres condiciones conjuntas: no exclusión efectiva, no rivalidad relevante y colapso persistente de la provisión voluntaria
          </p>
        </div>
      </section>

      <!-- COMPARISON OF APPROACHES -->

      <section class="content-section approaches-section" aria-labelledby="approaches-heading">
        <div class="container">
          <p class="eyebrow reveal">TRES ENFOQUES</p>
          <h2 class="reveal" id="approaches-heading">Tres formas de pensar el Estado</h2>
          <p class="approaches-intro reveal">No todas las teorías discuten lo mismo. Algunas preguntan si el Estado debe existir. Otras, qué funciones debería cumplir. Tolerancia Mínima plantea otra pregunta: <strong>qué debe demostrarse antes de tolerar su coerción</strong></p>

          <div class="approaches-frame reveal reveal-scale">
            <table class="approaches-table" aria-labelledby="approaches-heading">
              <colgroup><col /><col /><col /><col /></colgroup>
              <thead>
              <tr>
                <th scope="col">Característica</th>
                <th scope="col">Anarcocapitalismo</th>
                <th scope="col">Minarquismo</th>
                <th scope="col">Tolerancia Mínima</th>
              </tr>
              </thead>
              <tbody>
              <tr>
                <th scope="row">El Estado</th>
                <td data-label="Anarcocapitalismo">Rechaza el monopolio coercitivo estatal</td>
                <td data-label="Minarquismo">Defiende un Estado limitado para proteger derechos</td>
                <td data-label="Tolerancia Mínima">No presume legitimidad moral. La coerción solo puede tolerarse excepcionalmente</td>
              </tr>
              <tr>
                <th scope="row">Funciones</th>
                <td data-label="Anarcocapitalismo">Defensa, seguridad y justicia pueden organizarse voluntariamente</td>
                <td data-label="Minarquismo">Principalmente defensa, seguridad y justicia</td>
                <td data-label="Tolerancia Mínima">No hay una lista fija. Cada función debe superar el criterio</td>
              </tr>
              <tr>
                <th scope="row">Justificación</th>
                <td data-label="Anarcocapitalismo">Ninguna función justifica un monopolio estatal coercitivo</td>
                <td data-label="Minarquismo">La protección de derechos fundamenta el Estado mínimo</td>
                <td data-label="Tolerancia Mínima">Quien propone coerción debe demostrar su necesidad</td>
              </tr>
              <tr>
                <th scope="row">Producción</th>
                <td data-label="Anarcocapitalismo">La provisión corresponde a instituciones voluntarias</td>
                <td data-label="Minarquismo">El Estado puede asumir funciones básicas</td>
                <td data-label="Tolerancia Mínima">Responsabilidad estatal no implica producción estatal directa</td>
              </tr>
              <tr>
                <th scope="row">Permanencia</th>
                <td data-label="Anarcocapitalismo">Rechaza la excepción estatal</td>
                <td data-label="Minarquismo">Mantiene un núcleo limitado de funciones</td>
                <td data-label="Tolerancia Mínima">Toda excepción debe seguir justificándose en el tiempo</td>
              </tr>
              </tbody>
            </table>
          </div>

          <p class="approaches-closing reveal">Tolerancia Mínima no parte de una lista fija de funciones. Parte de un criterio</p>
        </div>
      </section>

      <!-- ENLACE AL TEOREMA -->

      <section class="content-section">
        <div class="container theory-final">
          <p class="eyebrow reveal" style="text-align: center;">
            EL TEOREMA
          </p>

          <h2 class="reveal">
            Definir el límite
          </h2>

          <div class="section-action section-action-centered reveal"><a href="/es/theorem/" class="story-link">Continuar al teorema <span aria-hidden="true">→</span></a></div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .theory-block {
        position: relative;
      }

      .theory-block::before {
        position: absolute;
        top: 0;
        left: 5vw;
        width: 42px;
        height: 2px;
        background: var(--gold);
        content: "";
        opacity: 0;
        transform: scaleX(0);
        transform-origin: left;
        transition:
          opacity 500ms ease,
          transform 700ms ease;
      }

      .theory-block:has(.is-visible)::before {
        opacity: 1;
        transform: scaleX(1);
      }

      .theory-final {
        text-align: center;
      }

      .theory-final > h2 {
        margin-right: auto;
        margin-left: auto;
      }

      .theory-final .buttons {
        justify-content: center;
      }

      @media (max-width: 900px) {
        .theory-block::before {
          left: 5vw;
          width: 34px;
        }
      }

      @media (max-width: 560px) {
        .theory-block::before {
          left: 5vw;
          width: 28px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .theory-block::before {
          opacity: 1;
          transform: scaleX(1);
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.14,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
