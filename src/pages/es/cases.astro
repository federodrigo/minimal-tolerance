---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Casos del Teorema de la Tolerancia Mínima | Tolerancia Mínima"
      description="Puesta a prueba del Teorema de la Tolerancia Mínima en defensa, servicios públicos, necesidades básicas, estabilidad financiera, investigación científica y otras áreas controvertidas."
      lang="es"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- TÍTULO DE PÁGINA -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            CASOS
          </p>

          <h1>
            Puesta a prueba
          </h1>
<p class="story-trail" aria-label="Recorrido de lectura"><span class="story-step">Preguntas</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step">Teoría</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step">Teorema</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step is-current">Casos</span></p>
        </div>
      </section>

      <!-- FRASE CENTRAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          Toda excepción debe demostrar su necesidad
        </blockquote>
      </section>

      <!-- CRITERIO -->

      <section class="application-section method-section">
        <div class="container">
          <div class="cases-criterion-layout">
            <div class="cases-criterion-copy">

          <p class="eyebrow reveal">
            EL TEOREMA DE LA TOLERANCIA MÍNIMA
          </p>

          <h2 class="reveal">
            T → (NE ∧ NR ∧ CV)
          </h2>

          <div
            class="criterion-panel reveal reveal-scale"
            style="margin: 20px auto 0;"
          >

            <!-- DEFINICIONES -->

            <div class="criterion-terms">

              <div class="criterion-term">
                <span class="criterion-code">
                  T
                </span>

                <span class="criterion-name">
                  Tolerabilidad de la coerción por necesidad
                </span>
              </div>

              <div class="criterion-term">
                <span class="criterion-code">
                  NE
                </span>

                <span class="criterion-name">
                  No exclusión efectiva
                </span>
              </div>

              <div class="criterion-term">
                <span class="criterion-code">
                  NR
                </span>

                <span class="criterion-name">
                  No rivalidad relevante
                </span>
              </div>

              <div class="criterion-term">
                <span class="criterion-code">
                  CV
                </span>

                <span class="criterion-name">
                  Colapso persistente de la provisión voluntaria
                </span>
              </div>

            </div>

          </div>
        </div>
            <figure class="manuscript-scene cases-criterion-illustration reveal reveal-right" role="img" aria-label="Prueba de resistencia de un puente"><span class="scene-picture scene-cases" aria-hidden="true"></span></figure>
          </div>
        </div>
      </section>

      <!-- FUNCIONES QUE SUPERAN EL EXAMEN -->

      <section class="application-section application-section-pass">
        <div class="container">
          <p class="eyebrow reveal">
            LOS CANDIDATOS MÁS FUERTES
          </p>

          <h2 class="reveal">
            Funciones que superan el examen
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <h3>
                Defensa territorial
              </h3>

              <p>
                La defensa territorial puede cumplir la no exclusión y la no rivalidad. Solo supera el examen si el free riding también provoca un fracaso persistente del financiamiento, la coordinación o la participación voluntarios
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Seguridad interna y orden jurídico
              </h3>

              <p>
                Algunas funciones de seguridad colectiva y orden jurídico pueden cumplir las dos primeras condiciones. Aún debe demostrarse el fracaso persistente de la provisión voluntaria
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Grandes emergencias y epidemias
              </h3>

              <p>
                Las grandes emergencias pueden generar beneficios no excluibles y no rivales. Cada función exige además probar el colapso persistente de la provisión voluntaria antes de tolerar la coerción
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- FUNCIONES QUE NO SUPERAN EL EXAMEN -->

      <section class="application-section application-section-fail">
        <div class="container">
          <p class="eyebrow reveal">
            FUERA DE LA EXCEPCIÓN
          </p>

          <h2 class="reveal">
            Funciones que no superan el examen
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <h3>
                Salud, educación y jubilaciones
              </h3>

              <p>
                Estos servicios pueden ser esenciales, pero su importancia no demuestra la no exclusión ni la no rivalidad. Como categorías generales, no superan el primer examen
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Regulación laboral y paternalismo
              </h3>

              <p>
                Las normas sobre salarios y contratos pueden buscar equidad o protección, pero esos fines no demuestran las tres condiciones del teorema
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Partidos políticos y regulación ordinaria
              </h3>

              <p>
                La desigualdad de negociación, la concentración y las conductas perjudiciales pueden preocupar. Por sí solas, no prueban la no exclusión, la no rivalidad ni el colapso voluntario persistente
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- CASOS FRONTERIZOS -->

      <section
        class="application-section application-section-borderline"
      >
        <div class="container">
          <p class="eyebrow reveal">
            CASOS FRONTERIZOS
          </p>

          <h2 class="reveal">
            No toda función tiene una respuesta
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <h3>
                Grandes arterias urbanas y carreteras abiertas
              </h3>

              <p>
                Las calles privadas y las rutas con peaje permiten excluir; algunas vías abiertas no. La congestión, la propiedad, la tecnología y el financiamiento pueden cambiar el resultado
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Investigación científica básica
              </h3>

              <p>
                El conocimiento científico puede ser difícil de excluir y no rival. Falta demostrar que el free riding impide persistentemente que instituciones voluntarias sostengan la investigación
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Servicios urbanos no excluibles
              </h3>

              <p>
                La iluminación pública abierta puede cumplir las dos primeras condiciones. Resta demostrar si la provisión voluntaria puede sostener el servicio
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- PRINCIPIO FINAL -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow reveal">
            EL RESULTADO
          </p>

          <h2 class="reveal cases-result-title">
            Cada función se evalúa por separado
          </h2>

          <p class="reveal">
            El teorema evalúa cada función, no al Estado en su conjunto. Que una supere el examen no favorece a las demás. Toda excepción debe revisarse si cambian la tecnología, las instituciones o las alternativas voluntarias
          </p>
        </div>
      </section>

      <!-- COMPARISON OF APPROACHES -->

      <section class="content-section approaches-section" aria-labelledby="approaches-heading">
        <div class="container">
          <p class="eyebrow reveal">UN CRITERIO, NO UNA LISTA</p>
          <h2 class="reveal" id="approaches-heading">Tres formas de pensar el Estado</h2>
          
          <div class="approaches-frame reveal reveal-scale">
            <table class="approaches-table" aria-labelledby="approaches-heading">
              <colgroup><col /><col /><col /><col /></colgroup>
              <thead>
              <tr>
                <th scope="col">Característica</th>
                <th scope="col">Anarcocapitalismo</th>
                <th scope="col">Minarquismo</th>
                <th scope="col">Tolerancia Mínima</th>
              </tr>
              </thead>
              <tbody>
              <tr>
                <th scope="row">Existencia del Estado</th>
                <td data-label="Anarcocapitalismo">No: rechaza el monopolio coercitivo estatal</td>
                <td data-label="Minarquismo">Sí: defiende un Estado mínimo</td>
                <td data-label="Tolerancia Mínima">Excepcional: una institución de último recurso</td>
              </tr>
              <tr>
                <th scope="row">Funciones estatales</th>
                <td data-label="Anarcocapitalismo">Ninguna: toda provisión debe ser voluntaria</td>
                <td data-label="Minarquismo">Defensa, seguridad y justicia</td>
                <td data-label="Tolerancia Mínima">Sin lista fija: cada función debe cumplir NE, NR y CV</td>
              </tr>
              <tr>
                <th scope="row">Base filosófica</th>
                <td data-label="Anarcocapitalismo">La coerción estatal es moralmente ilegítima</td>
                <td data-label="Minarquismo">Proteger derechos justifica la coerción</td>
                <td data-label="Tolerancia Mínima">La coerción no se legitima: su necesidad debe demostrarse</td>
              </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- LIBRO -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            EL LIBRO
          </p>

          <h2 class="reveal">
            Ver la prueba completa
          </h2>

          <p class="reveal">
            El libro aplica el criterio a más casos, especialmente aquellos donde resulta más difícil trazar el límite
          </p>

          <div class="section-action reveal"><a href="/es/book/" class="story-link">Explorar el libro <span aria-hidden="true">→</span></a></div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /* CRITERIO */

      .criterion-panel {
        max-width: 480px;
        margin-top: 20px;
        padding: 0 30px 20px;
        background: var(--paper-light);
        border: 1px solid var(--line);
        border-radius: 16px;
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      /* FÓRMULA */

      .criterion-formal {
        padding: 25px 0 23px;
        border-bottom: 1px solid var(--line);
      }

      .formula-expression {
        color: var(--navy);
        font-size: clamp(2rem, 3.6vw, 2.75rem);
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: 0.01em;
      }

      /* DEFINICIONES */

      .criterion-terms {
        width: fit-content;
        margin: 0 auto;
        padding-top: 14px;
      }

      .criterion-term {
        display: grid;
        grid-template-columns: 48px auto;
        align-items: baseline;
        gap: 12px;
        padding: 5px 0;
      }

      .criterion-code {
        color: var(--gold);
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.2;
      }

      .criterion-name {
        color: var(--navy);
        font-size: 1.03rem;
        font-weight: 500;
        line-height: 1.35;
      }

      /* SECCIONES DE CASOS */

      .application-section {
        padding: var(--section-space) 0;
        border-top: 1px solid var(--line);
      }

      .application-section-pass {
        background: var(--cream);
      }

      .application-section-fail {
        background: var(--paper);
      }

      .application-section-borderline {
        background: var(--paper-light);
      }

      .application-section > .container > .eyebrow,
      .application-section > .container > h2 {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      .application-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
        margin-top: 34px;
      }

      .application-card {
        min-height: 245px;
        padding: 28px;
        background: var(--paper-light);
        border: 1px solid var(--line);
        border-radius: 14px;
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      .application-section-fail .application-card {
        background: var(--cream);
      }

      .application-card h3 {
        margin-bottom: 14px;
        color: var(--navy);
        font-size: 1.35rem;
        line-height: 1.25;
      }

      .application-card p {
        margin-bottom: 0;
        font-size: 1rem;
        line-height: 1.62;
        text-align: left;
        hyphens: none;
      }

      /* HOVER — SOLO MOUSE */

      @media (hover: hover) and (pointer: fine) {
        .criterion-panel:hover {
          transform: translateY(-3px);
          border-color: rgba(169, 131, 58, 0.35);
          box-shadow: 0 14px 32px rgba(13, 27, 42, 0.06);
        }

        .application-card:hover {
          transform: translateY(-5px);
          border-color: rgba(169, 131, 58, 0.4);
          box-shadow: 0 18px 42px rgba(13, 27, 42, 0.09);
        }
      }

      /* RESPONSIVE */

      @media (max-width: 900px) {
        .application-grid {
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .application-card {
          min-height: auto;
        }
      }

      @media (max-width: 700px) {
        .criterion-panel {
          padding: 0 22px 18px;
        }

        .criterion-formal {
          padding: 22px 0 20px;
        }

        .formula-expression {
          font-size: clamp(1.7rem, 7vw, 2.2rem);
        }

        .criterion-term {
          grid-template-columns: 42px auto;
          gap: 10px;
          padding: 5px 0;
        }

        .criterion-code {
          font-size: 1.05rem;
        }

        .criterion-name {
          font-size: 0.98rem;
        }
      }

      @media (max-width: 600px) {
        .application-card {
          padding: 24px;
        }
      }

      /* MOVIMIENTO REDUCIDO */

      @media (prefers-reduced-motion: reduce) {
        .criterion-panel,
        .application-card {
          transition: none;
        }
      }
    
      /* Bridge illustration belongs with the theorem, not the page heading */
      .cases-criterion-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(210px, 275px);
        align-items: center;
        gap: 38px;
      }
      .cases-criterion-illustration {
        width: 100%;
        max-width: 275px;
        justify-self: end;
      }
      .cases-criterion-copy { min-width: 0; }
      .cases-criterion-copy > .eyebrow,
      .cases-criterion-copy > h2 {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }
      @media (max-width: 840px) {
        .cases-criterion-layout {
          grid-template-columns: 1fr;
          gap: 8px;
        }
        .cases-criterion-illustration { max-width: 205px !important; }
      }

    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
