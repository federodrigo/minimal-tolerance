---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Aplicaciones del Teorema de la Tolerancia Mínima | Tolerancia Mínima"
      description="Pruebas del Teorema de la Tolerancia Mínima aplicadas a defensa, servicios públicos, necesidades básicas, estabilidad financiera, investigación científica y otras áreas controvertidas."
      lang="es"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- TÍTULO -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            APLICACIONES
          </p>

          <h1>
            Prueba de Estrés
          </h1>
        </div>
      </section>

      <!-- FRASE PRINCIPAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          El teorema no acepta ni rechaza al Estado en su conjunto.
          Cada función debe superar el examen de manera independiente
        </blockquote>
      </section>

      <!-- MÉTODO -->

      <section class="content-section method-section">
        <div class="container">
          <p class="eyebrow reveal">
            EL MÉTODO
          </p>

          <h2 class="reveal">
            Un examen para cada función
          </h2>

          <p class="method-intro reveal">
            Toda excepción propuesta debe cumplir
            <strong>las tres condiciones</strong>
          </p>

          <ol class="condition-list stagger">
            <li class="condition reveal">
              <span class="condition-number" aria-hidden="true">
                01
              </span>

              <span class="condition-name">
                No exclusión efectiva
              </span>
            </li>

            <li class="condition reveal">
              <span class="condition-number" aria-hidden="true">
                02
              </span>

              <span class="condition-name">
                No rivalidad relevante
              </span>
            </li>

            <li class="condition reveal">
              <span class="condition-number" aria-hidden="true">
                03
              </span>

              <span class="condition-name">
                Colapso persistente de la provisión voluntaria
              </span>
            </li>
          </ol>

          <p class="method-note reveal">
            Las dos primeras definen la estructura económica. La tercera
            determina si la cooperación voluntaria alcanzó efectivamente
            su límite
          </p>
        </div>
      </section>

      <!-- FUNCIONES QUE SUPERAN EL EXAMEN -->

      <section class="application-section application-section-pass">
        <div class="container">
          <p class="eyebrow reveal">
            LOS CANDIDATOS MÁS FUERTES
          </p>

          <h2 class="reveal">
            Funciones que pueden superar el examen
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                CANDIDATO FUERTE
              </p>

              <h3>
                Defensa, seguridad y orden jurídico
              </h3>

              <p>
                La defensa territorial y algunas formas de seguridad
                colectiva pueden presentar una fuerte no exclusión y no
                rivalidad. Siguen siendo candidatos sólo si también se
                demuestra que la cooperación voluntaria no logra sostener
                la función relevante de manera estable
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                CANDIDATO POSIBLE
              </p>

              <h3>
                Estabilidad financiera sistémica
              </h3>

              <p>
                La función relevante puede ser la continuidad de una
                infraestructura financiera y no la supervivencia de un
                banco o una empresa particular. Que satisfaga las tres
                condiciones depende de la estructura del sistema y de las
                alternativas voluntarias disponibles
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                CANDIDATO POSIBLE
              </p>

              <h3>
                Amenazas ambientales globales
              </h3>

              <p>
                Algunos beneficios ambientales atraviesan fronteras y
                generaciones y pueden presentar no exclusión y no rivalidad.
                La tercera condición exige determinar si la cooperación
                voluntaria fracasa persistentemente en sostener la función
                de protección relevante
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- FUNCIONES QUE NO SUPERAN EL EXAMEN -->

      <section class="application-section application-section-fail">
        <div class="container">
          <p class="eyebrow reveal">
            FUERA DE LA EXCEPCIÓN
          </p>

          <h2 class="reveal">
            Funciones que no superan el examen
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                NO SUPERA
              </p>

              <h3>
                Salud, educación, vivienda y pensiones
              </h3>

              <p>
                Estos bienes pueden ser esenciales y socialmente valiosos,
                pero su importancia no elimina la rivalidad, vuelve
                inefectiva la exclusión ni demuestra un colapso persistente
                de la provisión voluntaria
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                NO SUPERA
              </p>

              <h3>
                Regulación laboral y paternalismo
              </h3>

              <p>
                Las restricciones sobre salarios, contratos, beneficios
                y condiciones de trabajo pueden perseguir fines
                distributivos o paternalistas, pero esos fundamentos no
                establecen las tres condiciones exigidas por el teorema
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                NO SUPERA
              </p>

              <h3>
                Partidos políticos y regulación ordinaria de los
                mercados
              </h3>

              <p>
                La influencia política, el poder desigual de negociación,
                la concentración y ciertas conductas pueden generar
                preocupaciones importantes. Por sí solas no establecen
                la no exclusión efectiva, la no rivalidad relevante y el
                colapso persistente de la provisión voluntaria
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- CASOS LÍMITE -->

      <section
        class="application-section application-section-borderline"
      >
        <div class="container">
          <p class="eyebrow reveal">
            CASOS LÍMITE
          </p>

          <h2 class="reveal">
            No todas las funciones tienen una respuesta clara
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                DEPENDE DEL CONTEXTO
              </p>

              <h3>
                Carreteras y redes urbanas
              </h3>

              <p>
                Las autopistas con peaje y las calles privadas permiten
                una exclusión efectiva, mientras que algunas redes abiertas
                pueden no hacerlo. La congestión, la tecnología, la
                propiedad, la escala y las formas alternativas de
                financiación pueden modificar el resultado
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                DEPENDE DEL CONTEXTO
              </p>

              <h3>
                Investigación científica básica
              </h3>

              <p>
                El conocimiento puede ser difícil de excluir y utilizarse
                sin reducir significativamente lo disponible para los
                demás. Esas características definen la estructura
                económica. La cuestión decisiva es si la cooperación
                voluntaria logra sostener la función de investigación
                en el tiempo
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                DEPENDE DEL CONTEXTO
              </p>

              <h3>
                Infraestructura estratégica y monetaria
              </h3>

              <p>
                Los semiconductores, las monedas y los servicios financieros
                son normalmente excluibles y rivales en el nivel del
                producto. El análisis puede cambiar cuando la función
                examinada es una forma más amplia de resiliencia sistémica,
                que deberá satisfacer por separado las tres condiciones
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- CONCLUSIÓN -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow reveal">
            EL RESULTADO
          </p>

          <h2 class="reveal">
            Cada función se evalúa por separado
          </h2>

          <p class="reveal">
            El teorema no acepta ni rechaza al Estado en su conjunto.
            Evalúa cada función de manera independiente, y ninguna
            excepción crea una presunción favorable a otra
          </p>

          <p class="reveal">
            Toda tolerancia permanece condicionada a las circunstancias
            que permitieron la excepción. Los cambios en la tecnología,
            las instituciones o la provisión voluntaria pueden exigir
            que vuelva a ser examinada
          </p>
        </div>
      </section>

      <!-- LIBRO -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            EL LIBRO
          </p>

          <h2 class="reveal">
            Explore la prueba completa
          </h2>

          <p class="reveal">
            El libro aplica el teorema a la defensa, las emergencias,
            las necesidades básicas, las carreteras, los sistemas
            monetarios, las crisis financieras, la investigación
            científica, las amenazas ambientales, la regulación
            laboral y los acuerdos comúnmente considerados
            inaceptables
          </p>

          <div class="buttons reveal">
            <a href="/es/book" class="primary">
              Explorar el Libro
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /* MÉTODO */

      .method-intro {
        max-width: 680px;
        margin-bottom: 20px;
      }

      .condition-list {
        max-width: 760px;
        margin: 0 0 20px;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--line);
      }

      .condition {
        display: grid;
        grid-template-columns: 62px 1fr;
        align-items: center;
        min-height: 68px;
        border-bottom: 1px solid var(--line);
      }

      .condition-number {
        color: var(--gold);
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.18em;
        transition:
          transform 220ms ease,
          color 220ms ease;
      }

      .condition-name {
        color: var(--navy);
        font-family: inherit;
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.35;
      }

      .method-note {
        margin-bottom: 0;
        font-style: italic;
        line-height: 1.6;
      }

      /* SECCIONES DE APLICACIONES */

      .application-section {
        padding: var(--section-space) 0;
        border-top: 1px solid var(--line);
      }

      .application-section-pass {
        background: var(--cream);
      }

      .application-section-fail {
        background: var(--paper);
      }

      .application-section-borderline {
        background: var(--paper-light);
      }

      .application-section > .container > .eyebrow,
      .application-section > .container > h2 {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      .application-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
        margin-top: 34px;
      }

      .application-card {
        min-height: 290px;
        padding: 28px;
        background: var(--paper-light);
        border: 1px solid var(--line);
        border-radius: 14px;
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      .application-section-fail .application-card {
        background: var(--cream);
      }

      .application-card h3 {
        margin-bottom: 14px;
        color: var(--navy);
        font-size: 1.35rem;
        line-height: 1.25;
      }

      .application-card p {
        margin-bottom: 0;
        font-size: 1rem;
        line-height: 1.62;
        text-align: left;
        hyphens: none;
      }

      .application-card .application-result {
        margin-bottom: 14px;
        color: var(--gold);
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: 0.16em;
      }

      /* HOVER — SOLO CON MOUSE */

      @media (hover: hover) and (pointer: fine) {
        .condition:hover .condition-number {
          color: var(--navy);
          transform: translateX(5px);
        }

        .application-card:hover {
          transform: translateY(-5px);
          border-color: rgba(169, 131, 58, 0.4);
          box-shadow: 0 18px 42px rgba(13, 27, 42, 0.09);
        }
      }

      /* RESPONSIVE */

      @media (max-width: 900px) {
        .application-grid {
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .application-card {
          min-height: auto;
        }
      }

      @media (max-width: 600px) {
        .condition {
          grid-template-columns: 46px 1fr;
          min-height: 66px;
        }

        .condition-name {
          font-size: 1.05rem;
        }

        .application-card {
          padding: 24px;
        }
      }

      /* MOVIMIENTO REDUCIDO */

      @media (prefers-reduced-motion: reduce) {
        .condition-number,
        .application-card {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
