---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Aplicaciones del Teorema de la Tolerancia Mínima | Tolerancia Mínima"
      description="Aplicaciones prácticas del Teorema de la Tolerancia Mínima en defensa, servicios públicos, necesidades básicas, estabilidad financiera y otras áreas controvertidas."
      lang="es"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- TÍTULO -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            APLICACIONES
          </p>

          <h1>
            Prueba de Estrés
          </h1>
        </div>
      </section>

      <!-- FRASE PRINCIPAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          El teorema no acepta ni rechaza al Estado en su conjunto.
          Cada función debe superar el examen de manera independiente
        </blockquote>
      </section>

      <!-- MÉTODO -->

      <section class="content-section method-section">
        <div class="container">
          <p class="eyebrow reveal">
            EL MÉTODO
          </p>

          <h2 class="reveal">
            Un examen para cada función
          </h2>

          <p class="method-intro reveal">
            Toda excepción propuesta debe cumplir
            <strong>las tres condiciones</strong>
          </p>

          <ol class="condition-list stagger">
            <li class="condition reveal">
              <span class="condition-number" aria-hidden="true">
                01
              </span>

              <span class="condition-name">
                No excluibilidad efectiva
              </span>
            </li>

            <li class="condition reveal">
              <span class="condition-number" aria-hidden="true">
                02
              </span>

              <span class="condition-name">
                No rivalidad relevante
              </span>
            </li>

            <li class="condition reveal">
              <span class="condition-number" aria-hidden="true">
                03
              </span>

              <span class="condition-name">
                Colapso persistente de la provisión voluntaria
              </span>
            </li>
          </ol>

          <p class="method-note reveal">
            La importancia no demuestra necesidad. La dificultad no
            demuestra imposibilidad
          </p>
        </div>
      </section>

      <!-- FUNCIONES QUE SUPERAN EL EXAMEN -->

      <section class="application-section application-section-pass">
        <div class="container">
          <p class="eyebrow reveal">
            LA EXCEPCIÓN
          </p>

          <h2 class="reveal">
            Funciones que superan el examen
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                SUPERA
              </p>

              <h3>
                Defensa, seguridad y orden jurídico
              </h3>

              <p>
                La protección frente a invasiones, violencia organizada,
                amenazas catastróficas y la aplicación de reglas
                jurídicas comunes afecta a toda la población. Sus
                beneficios se extienden más allá de quienes los
                financian y no pueden limitarse fácilmente a quienes
                pagan
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                SUPERA
              </p>

              <h3>
                Estabilidad financiera sistémica
              </h3>

              <p>
                El bien relevante no es la supervivencia de un banco o
                de una empresa en particular, sino el funcionamiento
                continuo de la infraestructura financiera de la que
                dependen millones de participantes
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                SUPERA
              </p>

              <h3>
                Amenazas ambientales globales
              </h3>

              <p>
                Algunos riesgos ambientales atraviesan fronteras,
                afectan a generaciones futuras y no pueden limitarse
                únicamente a quienes financian su prevención. Los
                beneficios son compartidos mientras que los incentivos
                para asumir los costos siguen siendo débiles
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- FUNCIONES QUE NO SUPERAN EL EXAMEN -->

      <section class="application-section application-section-fail">
        <div class="container">
          <p class="eyebrow reveal">
            FUERA DE LA EXCEPCIÓN
          </p>

          <h2 class="reveal">
            Funciones que no superan el examen
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                NO SUPERA
              </p>

              <h3>
                Salud, educación, vivienda y pensiones
              </h3>

              <p>
                Estos bienes pueden ser esenciales para el bienestar de
                las personas, pero siguen siendo excluibles, rivales o
                susceptibles de provisión voluntaria
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                NO SUPERA
              </p>

              <h3>
                Regulación laboral y paternalismo
              </h3>

              <p>
                Las restricciones sobre salarios, contratos, beneficios
                y condiciones de trabajo descansan sobre juicios acerca
                de qué acuerdos y resultados se consideran aceptables
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                NO SUPERA
              </p>

              <h3>
                Partidos políticos y regulación ordinaria de los
                mercados
              </h3>

              <p>
                La influencia política, el poder de negociación
                desigual, los monopolios o ciertas conductas pueden
                generar preocupaciones importantes. Ninguna de ellas
                demuestra por sí misma la no excluibilidad, la no
                rivalidad y el colapso persistente de la provisión
                voluntaria
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- CASOS LÍMITE -->

      <section
        class="application-section application-section-borderline"
      >
        <div class="container">
          <p class="eyebrow reveal">
            CASOS LÍMITE
          </p>

          <h2 class="reveal">
            No todas las funciones tienen una respuesta clara
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                DEPENDE DEL CONTEXTO
              </p>

              <h3>
                Carreteras y redes urbanas
              </h3>

              <p>
                Las autopistas con peaje y las calles privadas permiten
                la exclusión. Las grandes redes abiertas pueden no
                hacerlo. La congestión, la tecnología, la propiedad y
                la escala de la red pueden modificar el resultado
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                DEPENDE DEL CONTEXTO
              </p>

              <h3>
                Investigación científica básica
              </h3>

              <p>
                El conocimiento puede beneficiar a personas que nunca
                financiaron su descubrimiento y utilizarse sin
                consumirse. La cuestión decisiva es si las instituciones
                voluntarias siguen siendo capaces de sostener su
                producción
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                DEPENDE DEL CONTEXTO
              </p>

              <h3>
                Infraestructura estratégica y monetaria
              </h3>

              <p>
                Los semiconductores y las monedas normalmente se
                producen mediante intercambio voluntario. El análisis
                puede cambiar cuando el bien relevante pasa a ser la
                resiliencia del sistema y no el producto individual
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- CONCLUSIÓN -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow reveal">
            EL RESULTADO
          </p>

          <h2 class="reveal">
            Cada función se evalúa por separado
          </h2>

          <p class="reveal">
            El teorema no acepta ni rechaza al Estado en su conjunto.
            Evalúa cada función de manera independiente y exige que toda
            excepción propuesta supere el mismo examen
          </p>

          <p class="reveal">
            Las excepciones siguen siendo excepciones. Su tolerancia
            depende de las circunstancias y no de una regla permanente.
            Sociedades distintas pueden llegar a conclusiones diferentes
            aplicando el mismo criterio
          </p>
        </div>
      </section>

      <!-- LIBRO -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            EL LIBRO
          </p>

          <h2 class="reveal">
            Explore la prueba completa
          </h2>

          <p class="reveal">
            El libro aplica el teorema a la defensa, las emergencias,
            las necesidades básicas, las carreteras, los sistemas
            monetarios, las crisis financieras, la investigación
            científica, las amenazas ambientales, la regulación
            laboral y los acuerdos comúnmente considerados
            inaceptables
          </p>

          <div class="buttons reveal">
            <a href="/es/book" class="primary">
              Explorar el Libro
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /* MÉTODO */

      .method-intro {
        max-width: 680px;
        margin-bottom: 20px;
      }

      .condition-list {
        max-width: 760px;
        margin: 0 0 20px;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--line);
      }

      .condition {
        display: grid;
        grid-template-columns: 62px 1fr;
        align-items: center;
        min-height: 68px;
        border-bottom: 1px solid var(--line);
      }

      .condition-number {
        color: var(--gold);
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.18em;
        transition:
          transform 220ms ease,
          color 220ms ease;
      }

      .condition-name {
        color: var(--navy);
        font-family: inherit;
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.35;
      }

      .method-note {
        margin-bottom: 0;
        font-style: italic;
        line-height: 1.6;
      }

      /* SECCIONES DE APLICACIONES */

      .application-section {
        padding: var(--section-space) 0;
        border-top: 1px solid var(--line);
      }

      .application-section-pass {
        background: var(--cream);
      }

      .application-section-fail {
        background: var(--paper);
      }

      .application-section-borderline {
        background: var(--paper-light);
      }

      .application-section > .container > .eyebrow,
      .application-section > .container > h2 {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      .application-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
        margin-top: 34px;
      }

      .application-card {
        min-height: 290px;
        padding: 28px;
        background: var(--paper-light);
        border: 1px solid var(--line);
        border-radius: 14px;
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      .application-section-fail .application-card {
        background: var(--cream);
      }

      .application-card h3 {
        margin-bottom: 14px;
        color: var(--navy);
        font-size: 1.35rem;
        line-height: 1.25;
      }

      .application-card p {
        margin-bottom: 0;
        font-size: 1rem;
        line-height: 1.62;
        text-align: left;
        hyphens: none;
      }

      .application-card .application-result {
        margin-bottom: 14px;
        color: var(--gold);
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: 0.16em;
      }

      /* HOVER — SOLO CON MOUSE */

      @media (hover: hover) and (pointer: fine) {
        .condition:hover .condition-number {
          color: var(--navy);
          transform: translateX(5px);
        }

        .application-card:hover {
          transform: translateY(-5px);
          border-color: rgba(169, 131, 58, 0.4);
          box-shadow: 0 18px 42px rgba(13, 27, 42, 0.09);
        }
      }

      /* RESPONSIVE */

      @media (max-width: 900px) {
        .application-grid {
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .application-card {
          min-height: auto;
        }
      }

      @media (max-width: 600px) {
        .condition {
          grid-template-columns: 46px 1fr;
          min-height: 66px;
        }

        .condition-name {
          font-size: 1.05rem;
        }

        .application-card {
          padding: 24px;
        }
      }

      /* MOVIMIENTO REDUCIDO */

      @media (prefers-reduced-motion: reduce) {
        .condition-number,
        .application-card {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>


