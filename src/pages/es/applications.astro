---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Aplicaciones del Teorema de la Tolerancia Mínima | Tolerancia Mínima"
      description="Puesta a prueba del Teorema de la Tolerancia Mínima en defensa, servicios públicos, necesidades básicas, estabilidad financiera, investigación científica y otras áreas controvertidas."
      lang="es"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- TÍTULO DE PÁGINA -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            APLICACIONES
          </p>

          <h1>
            Puesta a prueba
          </h1>
        </div>
      </section>

      <!-- FRASE CENTRAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          Toda excepción debe demostrar su necesidad
        </blockquote>
      </section>

      <!-- CRITERIO -->

      <section class="content-section method-section">
        <div class="container">
          <p class="eyebrow reveal">
            EL TEOREMA DE LA TOLERANCIA MÍNIMA
          </p>

          <div class="criterion-panel reveal reveal-scale">

            <!-- FÓRMULA -->

            <div class="criterion-formal">
              <div class="formula-expression">
                T → (NE ∧ NR ∧ CV)
              </div>
            </div>

            <!-- DEFINICIONES -->

            <div class="criterion-terms">
              <div class="criterion-term">
                <span class="criterion-code">
                  T
                </span>

                <span class="criterion-name">
                  Tolerabilidad por razones de necesidad coercitiva
                </span>
              </div>

              <div class="criterion-term">
                <span class="criterion-code">
                  NE
                </span>

                <span class="criterion-name">
                  No exclusión efectiva
                </span>
              </div>

              <div class="criterion-term">
                <span class="criterion-code">
                  NR
                </span>

                <span class="criterion-name">
                  No rivalidad relevante
                </span>
              </div>

              <div class="criterion-term">
                <span class="criterion-code">
                  CV
                </span>

                <span class="criterion-name">
                  Colapso persistente de la provisión voluntaria
                </span>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- FUNCIONES QUE PUEDEN SUPERAR EL EXAMEN -->

      <section class="application-section application-section-pass">
        <div class="container">
          <p class="eyebrow reveal">
            LOS CANDIDATOS MÁS FUERTES
          </p>

          <h2 class="reveal">
            Funciones que pueden superar el examen
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <h3>
                Defensa territorial
              </h3>

              <p>
                La defensa territorial puede satisfacer la no exclusión y
                la no rivalidad. Solo supera el examen si los incentivos de
                free rider socavan persistentemente el financiamiento, la
                coordinación o la participación necesarios para sostener
                la función colectiva
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Seguridad interna y orden jurídico
              </h3>

              <p>
                Algunas funciones de seguridad colectiva y orden jurídico
                pueden satisfacer las dos primeras condiciones. La carga
                restante consiste en demostrar que la provisión voluntaria
                fracasa persistentemente en sostener la función relevante
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Grandes emergencias y epidemias
              </h3>

              <p>
                Las emergencias excepcionales pueden generar funciones cuyos
                beneficios sean difíciles de excluir y ampliamente compartidos.
                Solo superan el examen cuando también se establece un colapso
                persistente de la provisión voluntaria para la función
                específica examinada
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- FUNCIONES QUE NO SUPERAN EL EXAMEN -->

      <section class="application-section application-section-fail">
        <div class="container">
          <p class="eyebrow reveal">
            FUERA DE LA EXCEPCIÓN
          </p>

          <h2 class="reveal">
            Funciones que no superan el examen
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <h3>
                Salud, educación y jubilaciones
              </h3>

              <p>
                Estos bienes pueden ser esenciales y socialmente valiosos,
                pero su importancia no elimina la rivalidad ni vuelve
                inefectiva la exclusión. Por lo tanto, quedan fuera antes
                de que el colapso persistente de la provisión voluntaria
                se vuelva relevante
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Regulación laboral y paternalismo
              </h3>

              <p>
                Las restricciones sobre salarios, contratos, beneficios
                y condiciones laborales pueden perseguir fines distributivos
                o paternalistas, pero esas razones no establecen las tres
                condiciones exigidas por el teorema
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Partidos políticos y regulación ordinaria
              </h3>

              <p>
                La influencia política, el poder de negociación desigual,
                la concentración y las conductas indeseables pueden generar
                preocupaciones serias. Por sí solas, no establecen la no
                exclusión efectiva, la no rivalidad relevante y el colapso
                persistente de la provisión voluntaria
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- CASOS FRONTERIZOS -->

      <section
        class="application-section application-section-borderline"
      >
        <div class="container">
          <p class="eyebrow reveal">
            CASOS FRONTERIZOS
          </p>

          <h2 class="reveal">
            No toda función tiene una respuesta clara
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <h3>
                Carreteras y redes urbanas
              </h3>

              <p>
                Las carreteras con peaje y las calles privadas pueden
                permitir una exclusión efectiva, mientras que algunas
                redes abiertas pueden no hacerlo. La congestión, la
                tecnología, la propiedad, la escala y las alternativas
                de financiamiento pueden modificar el resultado
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Investigación científica básica
              </h3>

              <p>
                El conocimiento puede ser difícil de excluir y a menudo
                puede utilizarse sin reducir lo que queda disponible para
                otros. La pregunta restante es si los incentivos de free
                rider impiden que las instituciones voluntarias sostengan
                en el tiempo la función de investigación relevante
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Infraestructura estratégica
              </h3>

              <p>
                Los semiconductores, las monedas y los servicios financieros
                son normalmente excluibles y rivales a nivel del producto.
                El análisis puede cambiar cuando la función examinada es
                una forma más amplia de resiliencia sistémica, que deberá
                entonces satisfacer de manera independiente las tres
                condiciones
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Estabilidad financiera sistémica
              </h3>

              <p>
                La función relevante puede ser la continuidad de una
                infraestructura financiera y no la supervivencia de una
                institución particular. Que supere el examen depende de
                la estructura del sistema y de las alternativas voluntarias
                disponibles
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Protección ambiental
              </h3>

              <p>
                Algunos beneficios ambientales se extienden a través de
                fronteras y generaciones y pueden satisfacer la no exclusión
                y la no rivalidad. La pregunta restante es si los incentivos
                de free rider socavan persistentemente la función de
                protección
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- PRINCIPIO FINAL -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow reveal">
            EL RESULTADO
          </p>

          <h2 class="reveal">
            Cada función se evalúa por separado
          </h2>

          <p class="reveal">
            El teorema no acepta ni rechaza al Estado en su conjunto.
            Cada función se evalúa de manera independiente, y que una
            supere el examen no crea ninguna presunción a favor de otra
          </p>

          <p class="reveal">
            Toda tolerancia permanece condicionada a las circunstancias
            que la sustentaron. Los cambios en la tecnología, las
            instituciones o la provisión voluntaria pueden exigir,
            por tanto, que la excepción vuelva a ser examinada
          </p>
        </div>
      </section>

      <!-- LIBRO -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            EL LIBRO
          </p>

          <h2 class="reveal">
            Ver la puesta a prueba completa
          </h2>

          <p class="reveal">
            El libro aplica el teorema a la defensa, las emergencias,
            las necesidades básicas, las carreteras, los sistemas
            monetarios, las crisis financieras, la investigación
            científica, las amenazas ambientales, la regulación
            laboral y los acuerdos comúnmente considerados
            inaceptables
          </p>

          <div class="buttons reveal">
            <a href="/es/book" class="primary">
              Explorar el Libro
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /* CRITERIO */

      .criterion-panel {
        max-width: 760px;
        margin-top: 20px;
        padding: 0 30px 20px;
        background: var(--paper-light);
        border: 1px solid var(--line);
        border-radius: 16px;
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      /* FÓRMULA */

      .criterion-formal {
        padding: 25px 0 23px;
        border-bottom: 1px solid var(--line);
      }

      .formula-expression {
        color: var(--navy);
        font-size: clamp(2rem, 3.6vw, 2.75rem);
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: 0.01em;
      }

      /* DEFINICIONES */

      .criterion-terms {
        padding-top: 14px;
      }

      .criterion-term {
        display: grid;
        grid-template-columns: 48px 1fr;
        align-items: baseline;
        gap: 12px;
        padding: 5px 0;
      }

      .criterion-code {
        color: var(--gold);
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.2;
      }

      .criterion-name {
        color: var(--navy);
        font-size: 1.03rem;
        font-weight: 500;
        line-height: 1.35;
      }

      /* SECCIONES DE APLICACIONES */

      .application-section {
        padding: var(--section-space) 0;
        border-top: 1px solid var(--line);
      }

      .application-section-pass {
        background: var(--cream);
      }

      .application-section-fail {
        background: var(--paper);
      }

      .application-section-borderline {
        background: var(--paper-light);
      }

      .application-section > .container > .eyebrow,
      .application-section > .container > h2 {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      .application-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
        margin-top: 34px;
      }

      .application-card {
        min-height: 290px;
        padding: 28px;
        background: var(--paper-light);
        border: 1px solid var(--line);
        border-radius: 14px;
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      .application-section-fail .application-card {
        background: var(--cream);
      }

      .application-card h3 {
        margin-bottom: 14px;
        color: var(--navy);
        font-size: 1.35rem;
        line-height: 1.25;
      }

      .application-card p {
        margin-bottom: 0;
        font-size: 1rem;
        line-height: 1.62;
        text-align: left;
        hyphens: none;
      }

      /* HOVER — SOLO MOUSE */

      @media (hover: hover) and (pointer: fine) {
        .criterion-panel:hover {
          transform: translateY(-3px);
          border-color: rgba(169, 131, 58, 0.35);
          box-shadow: 0 14px 32px rgba(13, 27, 42, 0.06);
        }

        .application-card:hover {
          transform: translateY(-5px);
          border-color: rgba(169, 131, 58, 0.4);
          box-shadow: 0 18px 42px rgba(13, 27, 42, 0.09);
        }
      }

      /* RESPONSIVE */

      @media (max-width: 900px) {
        .application-grid {
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .application-card {
          min-height: auto;
        }
      }

      @media (max-width: 700px) {
        .criterion-panel {
          padding: 0 22px 18px;
        }

        .criterion-formal {
          padding: 22px 0 20px;
        }

        .formula-expression {
          font-size: clamp(1.7rem, 7vw, 2.2rem);
        }

        .criterion-term {
          grid-template-columns: 42px 1fr;
          gap: 10px;
          padding: 5px 0;
        }

        .criterion-code {
          font-size: 1.05rem;
        }

        .criterion-name {
          font-size: 0.98rem;
        }
      }

      @media (max-width: 600px) {
        .application-card {
          padding: 24px;
        }
      }

      /* MOVIMIENTO REDUCIDO */

      @media (prefers-reduced-motion: reduce) {
        .criterion-panel,
        .application-card {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
