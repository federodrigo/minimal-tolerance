---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="¿Cuándo puede tolerarse la coerción? | Tolerancia Mínima"
      description="La Teoría de la Tolerancia Mínima establece las condiciones bajo las cuales la provisión coercitiva de una función puede considerarse tolerable por razones de necesidad"
      lang="es"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->

      <section class="hero">
        <div class="hero-content hero-sequence">
          <p class="eyebrow">
            LA TEORÍA DE LA TOLERANCIA MÍNIMA
          </p>

          <h1>
            ¿Cuándo puede tolerarse<br />
            la coerción?
          </h1>

          <!--
            Se mantienen exactamente 3 spans para conservar
            la animación original del sitio.

            JavaScript hace rotar las 4 frases utilizando
            esos mismos 3 espacios de animación.
          -->

          <div
            class="animated-text"
            aria-label="El poder se tolera. No se legitima. Solo bajo condiciones excepcionales. Una teoría de la coerción y sus límites"
          >
            <span>El poder se tolera</span>
            <span>No se legitima</span>
            <span>Solo bajo condiciones excepcionales</span>
          </div>

          <div class="buttons">
            <a href="/es/theory" class="primary">
              Explorar la Teoría
            </a>

            <a href="/es/book" class="secondary">
              Explorar el Libro
            </a>
          </div>
        </div>
      </section>

      <!-- FRASE CENTRAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          La carga de la prueba pertenece al poder
        </blockquote>
      </section>

      <!-- LIBRO -->

      <section id="book" class="book">
        <div class="container">
          <div class="book-grid">

            <div class="reveal reveal-left">
              <a
                href="/es/book"
                class="book-cover-link"
                aria-label="Explorar el libro Una Teoría de la Tolerancia Mínima"
              >
                <img
                  src="/images/book-cover.jpg"
                  alt="Portada de Una Teoría de la Tolerancia Mínima de Fede Rodrigo"
                  loading="lazy"
                />
              </a>
            </div>

            <div class="reveal reveal-right">
              <p class="eyebrow">
                EL LIBRO
              </p>

              <h2>
                Una Teoría de la Tolerancia Mínima
              </h2>

              <p>
                Un libro de próxima publicación sobre la coerción,<br />
                sus límites y la carga de la prueba impuesta al poder
              </p>

              <a href="/es/book" class="secondary">
                Explorar el Libro
              </a>
            </div>

          </div>
        </div>
      </section>

      <!-- PREGUNTAS -->

      <section id="questions" class="content-section">
        <div class="container">

          <p class="eyebrow reveal">
            LAS PREGUNTAS CENTRALES
          </p>

          <h2 class="reveal">
            Donde comienza el debate
          </h2>

          <p class="reveal">
            ¿Por qué debería el Estado desempeñar algunas funciones
            y no otras? • ¿Cuándo, si alguna vez, puede tolerarse la
            coerción? • ¿Dónde deben trazarse los límites del poder
            político?
          </p>

          <a href="/es/questions" class="secondary reveal">
            Leer las Preguntas
          </a>

        </div>
      </section>

      <!-- TEORÍA -->

      <section id="theory" class="content-section">
        <div class="container">

          <p class="eyebrow reveal">
            LA TEORÍA
          </p>

          <h2 class="reveal">
            Fundamentos
          </h2>

          <div class="foundation-principles stagger">

            <article class="foundation-principle reveal">
              <span class="foundation-number">
                01
              </span>

              <div>
                <h3>
                  Sin legitimidad moral intrínseca
                </h3>

                <p>
                  El Estado no posee autoridad moral por el mero
                  hecho de existir o de ejercer poder
                </p>
              </div>
            </article>

            <article class="foundation-principle reveal">
              <span class="foundation-number">
                02
              </span>

              <div>
                <h3>
                  Límites estructurales del gobierno
                </h3>

                <p>
                  Los gobiernos enfrentan límites inevitables de
                  información, cálculo económico, incentivos y
                  corrección de errores que ninguna concentración
                  de poder puede eliminar
                </p>
              </div>
            </article>

            <article class="foundation-principle reveal">
              <span class="foundation-number">
                03
              </span>

              <div>
                <h3>
                  Presunción de libertad
                </h3>

                <p>
                  La libertad es el punto de partida. La coerción
                  soporta la carga de la prueba
                </p>
              </div>
            </article>

          </div>

          <a href="/es/theory" class="secondary reveal">
            Continuar leyendo
          </a>

        </div>
      </section>

      <!-- TEOREMA -->

      <section id="theorem" class="theorem">
        <div class="container">

          <p class="eyebrow reveal">
            EL CRITERIO
          </p>

          <h2 class="reveal">
            El Teorema de la Tolerancia Mínima
          </h2>

          <div class="theorem-summary stagger">

            <article class="theorem-summary-card reveal reveal-scale">
              <h3>
                No exclusión efectiva
              </h3>
            </article>

            <article class="theorem-summary-card reveal reveal-scale">
              <h3>
                No rivalidad relevante
              </h3>
            </article>

            <article class="theorem-summary-card reveal reveal-scale">
              <h3>
                Colapso persistente de la provisión voluntaria
              </h3>
            </article>

          </div>

          <div class="buttons reveal">
            <a href="/es/theorem" class="primary">
              Examinar el Teorema
            </a>
          </div>

        </div>
      </section>

      <!-- INVESTIGACIÓN -->

      <section id="papers" class="ssrn">
        <div class="container">

          <p class="eyebrow reveal">
            INVESTIGACIÓN
          </p>

          <h2 class="reveal">
            Investigación sobre Tolerancia Mínima
          </h2>

          <p class="reveal">
            Papers que exploran la Tolerancia Mínima y los límites del poder estatal
          </p>

          <a
            href="/es/papers"
            class="primary reveal"
          >
            Ver los Papers
          </a>

        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      /*
        ANIMACIONES REVEAL
      */

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.14,
            rootMargin: "0px 0px -45px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }

      /*
        TEXTO ANIMADO DEL HERO

        La animación original utiliza 3 spans.

        Se mantienen esos 3 spans para no alterar
        el movimiento, los tiempos ni las transiciones
        definidos en el CSS original.

        La cuarta frase entra en la rotación mediante
        JavaScript.
      */

      if (!reduceMotion) {
        const heroPhrases = [
          "El poder se tolera",
          "No se legitima",
          "Solo bajo condiciones excepcionales",
          "Una teoría de la coerción y sus límites",
        ];

        const heroSpans =
          document.querySelectorAll(".animated-text > span");

        heroSpans.forEach((span, index) => {
          let phraseIndex = index;

          span.addEventListener("animationiteration", () => {
            phraseIndex =
              (phraseIndex + heroSpans.length) %
              heroPhrases.length;

            span.textContent = heroPhrases[phraseIndex];
          });
        });
      }
    </script>
  </body>
</html>

<style>
  /*
    PORTADA DEL LIBRO

    Solo se agrega la interacción de la portada.
    No se modifica ningún estilo de .animated-text.
  */

  .book-cover-link {
    display: inline-block;
  }

  .book-cover-link img {
    display: block;
    transition: transform 0.25s ease;
  }

  .book-cover-link:hover img {
    transform: scale(1.02);
  }

  .book-cover-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .book-cover-link img {
      transition: none;
    }

    .book-cover-link:hover img {
      transform: none;
    }
  }
</style>
