---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";

const ssrnUrl =
  "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5984574";
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="¿Cuándo puede tolerarse la coerción? | Tolerancia Mínima"
      description="La Teoría de la Tolerancia Mínima ofrece un marco consistente para determinar bajo qué condiciones excepcionales puede tolerarse la coerción estatal"
      lang="es"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->

      <section class="hero">
        <div class="hero-content hero-sequence">
          <p class="eyebrow">
            LA TEORÍA DE LA TOLERANCIA MÍNIMA
          </p>

          <h1>
            ¿Cuándo puede tolerarse<br />
            la coerción?
          </h1>

          <p class="lead">
            Una teoría sobre el poder y sus límites
          </p>

          <div
            class="animated-text"
            aria-label="El poder se tolera. No se legitima. Solo bajo condiciones excepcionales"
          >
            <span>El poder se tolera</span>
            <span>No se legitima</span>
            <span>Solo bajo condiciones excepcionales</span>
          </div>

          <div class="buttons">
            <a href="/es/theory" class="primary">
              Explorar la Teoría
            </a>

            <a
              href={ssrnUrl}
              class="secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              Leer el Paper
            </a>
          </div>
        </div>
      </section>

      <!-- FRASE CENTRAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          La carga de la prueba pertenece al poder
        </blockquote>
      </section>

      <!-- PREGUNTAS -->

      <section id="questions" class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            LAS PREGUNTAS CENTRALES
          </p>

          <h2 class="reveal">
            Donde comienza el debate
          </h2>

          <p class="reveal">
            ¿Por qué debería el Estado cumplir algunas funciones y no
            otras? • ¿Cuándo, si alguna vez, puede tolerarse la
            coerción? • ¿Dónde deberían trazarse los límites del poder
            político?
          </p>

          <a href="/es/questions" class="secondary reveal">
            Leer las Preguntas
          </a>
        </div>
      </section>

      <!-- TEORÍA -->

      <section id="theory" class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            LA TEORÍA
          </p>

          <h2 class="reveal">
            Fundamentos
          </h2>

          <div class="foundation-principles stagger">
            <article class="foundation-principle reveal">
              <span class="foundation-number">
                01
              </span>

              <div>
                <h3>
                  Ausencia de legitimidad moral intrínseca
                </h3>

                <p>
                  El Estado no posee autoridad moral por el simple
                  hecho de existir o de ejercer poder
                </p>
              </div>
            </article>

            <article class="foundation-principle reveal">
              <span class="foundation-number">
                02
              </span>

              <div>
                <h3>
                  Límites funcionales estructurales
                </h3>

                <p>
                  Los gobiernos enfrentan límites inevitables de
                  información, cálculo económico, incentivos y
                  corrección de errores que ninguna concentración
                  de poder puede eliminar
                </p>
              </div>
            </article>

            <article class="foundation-principle reveal">
              <span class="foundation-number">
                03
              </span>

              <div>
                <h3>
                  Un principio con límites estrictos
                </h3>

                <p>
                  La acción estatal solo puede tolerarse bajo
                  condiciones estrechamente definidas y una carga
                  de la prueba excepcionalmente alta
                </p>
              </div>
            </article>
          </div>

          <a href="/es/theory" class="secondary reveal">
            Continuar Leyendo
          </a>
        </div>
      </section>

      <!-- TEOREMA -->

      <section id="theorem" class="theorem">
        <div class="container">
          <p class="eyebrow reveal">
            EL EXAMEN FORMAL
          </p>

          <h2 class="reveal">
            El Teorema de la Tolerancia Mínima
          </h2>

          <div class="theorem-summary stagger">
            <article class="theorem-summary-card reveal reveal-scale">
              <h3>
                No excluibilidad efectiva
              </h3>
            </article>

            <article class="theorem-summary-card reveal reveal-scale">
              <h3>
                No rivalidad relevante
              </h3>
            </article>

            <article class="theorem-summary-card reveal reveal-scale">
              <h3>
                Colapso persistente de la provisión voluntaria
              </h3>
            </article>
          </div>

          <div class="buttons reveal">
            <a href="/es/theorem" class="primary">
              Examinar el Teorema
            </a>
          </div>
        </div>
      </section>

      <!-- LIBRO -->

      <section id="book" class="book">
        <div class="container">
          <div class="book-grid">
            <div class="reveal reveal-left">
              <img
                src="/images/book-cover.jpg"
                alt="Portada de Tolerancia Mínima, de Federico Rodrigo"
                loading="lazy"
              />
            </div>

            <div class="reveal reveal-right">
              <p class="eyebrow">
                EL LIBRO
              </p>

              <h2>
                Una Teoría de la Tolerancia Mínima
              </h2>

              <p>
                Un próximo libro que explora los límites
                excepcionales de la coerción.
              </p>

              <a href="/es/book" class="secondary">
                Descubrir el Libro
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- PAPER -->

      <section id="paper" class="ssrn">
        <div class="container">
          <p class="eyebrow reveal">
            PREPRINT EN SSRN
          </p>

          <h2 class="reveal">
            Leer el paper fundacional
          </h2>

          <p class="reveal">
            Free Riders, the State, and the “Institutional Technology
            of Last Resort”
          </p>

          <a
            href={ssrnUrl}
            class="primary reveal"
            target="_blank"
            rel="noopener noreferrer"
          >
            Abrir en SSRN
          </a>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.14,
            rootMargin: "0px 0px -45px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
