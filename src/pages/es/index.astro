---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="¿Qué debería poder hacer el Estado? | Tolerancia Mínima"
      description="La Teoría de la Tolerancia Mínima establece las condiciones bajo las cuales la provisión coercitiva de una función puede considerarse tolerable por razones de necesidad"
      lang="es"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->

      <section class="hero">
        <div class="hero-content hero-sequence">
          <p class="eyebrow">
            LA TEORÍA DE LA TOLERANCIA MÍNIMA
          </p>

          <h1 class="landing-question-title">¿Qué debería <em>poder</em><br />hacer el Estado?</h1>  

          <div class="buttons">
            <a href="/es/theory/" class="primary">Explorar la teoría</a>
            <a href="/es/book/" class="secondary">Explorar el libro</a>
          </div>
        </div>
      </section>

      <!-- FRASE CENTRAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          La carga de la prueba pertenece al poder
        </blockquote>
      </section>

      <!-- LIBRO -->

      <section id="book" class="book">
        <div class="container">
          <div class="book-grid">
            <div class="reveal reveal-left">
              <a
                href="/es/book"
                aria-label="Explorar el libro Una Teoría de Tolerancia Mínima"
              >
                <img
                  src="/images/book-cover-esp.jpg"
                  alt="Portada de Una Teoría de Tolerancia Mínima de Fede Rodrigo"
                  loading="lazy"
                />
              </a>
            </div>

            <div class="reveal reveal-right">
              <p class="eyebrow">
                EL LIBRO
              </p>

              <h2 class="landing-book-title">
                <span class="landing-title-line">Una Teoría</span>
                <span class="landing-title-line">de Tolerancia Mínima</span>
              </h2>

              <p>
                Un libro disponible en PDF gratuito sobre la coerción,<br />
                sus límites y la carga de la prueba impuesta al poder
              </p>

              <div class="book-landing-actions">
                <a href="/es/book" class="secondary">
                  Explorar el Libro
                </a>
                <a
                  href="https://www.amazon.com/dp/B0HMM92K5R"
                  class="secondary"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Comprar en Amazon
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

            <!-- PREGUNTAS -->

      <section id="questions" class="content-section">
        <div class="container manuscript-split"><div class="manuscript-copy">
          <p class="eyebrow reveal">
            LAS PREGUNTAS CENTRALES
          </p>

          <h2 class="reveal">
            Las preguntas<br />detrás de la teoría
          </h2>

          <p class="reveal">
            ¿Qué limita el poder del Estado? • ¿Los bienes públicos o el
            problema del free rider justifican la coerción? • ¿Cuándo puede
            tolerarse la coerción sin volverse legítima?
          </p>

          <div class="section-action reveal"><a href="/es/questions" class="story-link">Explorar las Preguntas <span aria-hidden="true">→</span></a></div>
        </div><figure class="manuscript-scene reveal reveal-right" role="img" aria-label="Acuerdo voluntario e imposición"><span class="scene-picture scene-home" aria-hidden="true"></span></figure></div>
      </section>

      <!-- TEORÍA -->

      <section id="theory" class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            LA TEORÍA
          </p>

          <h2 class="reveal">
            Fundamentos
          </h2>

          <div class="foundation-principles stagger">
            <article class="foundation-principle reveal">
              <span class="foundation-number">
                01
              </span>

              <div>
                <h3>
                  Sin legitimidad moral intrínseca
                </h3>

                <p>
                  El Estado no posee autoridad moral por el mero
                  hecho de existir o de ejercer poder
                </p>
              </div>
            </article>

            <article class="foundation-principle reveal">
              <span class="foundation-number">
                02
              </span>

              <div>
                <h3>
                  Límites estructurales del gobierno
                </h3>

                <p>
                  Los gobiernos enfrentan límites inevitables de
                  información, cálculo económico, incentivos y
                  corrección de errores que ninguna concentración
                  de poder puede eliminar
                </p>
              </div>
            </article>

            <article class="foundation-principle reveal">
              <span class="foundation-number">
                03
              </span>

              <div>
                <h3>
                  Presunción de libertad
                </h3>

                <p>
                  La libertad es el punto de partida. La coerción
                  soporta la carga de la prueba
                </p>
              </div>
            </article>
          </div>

          <div class="section-action reveal"><a href="/es/theory" class="story-link">Continuar leyendo <span aria-hidden="true">→</span></a></div>
        </div>
      </section>

      <!-- TEOREMA -->

      <section id="theorem" class="theorem">
        <div class="container">
          <p class="eyebrow reveal">
            EL CRITERIO
          </p>

          <h2 class="reveal">
            El Teorema de la Tolerancia Mínima
          </h2>

          <div class="theorem-summary stagger reveal"><article class="theorem-summary-card"><span class="criterion-mark">NE</span><h3>No exclusión efectiva</h3></article><article class="theorem-summary-card"><span class="criterion-mark">NR</span><h3>No rivalidad relevante</h3></article><article class="theorem-summary-card"><span class="criterion-mark">CV</span><h3>Colapso persistente de la provisión voluntaria</h3></article></div>

          <div class="section-action reveal"><a href="/es/theorem" class="story-link">Examinar el Teorema <span aria-hidden="true">→</span></a></div>
        </div>
      </section>

      <!-- INVESTIGACIÓN -->

      <section id="papers" class="ssrn">
        <div class="container">
          <p class="eyebrow reveal">
            LOS PAPERS
          </p>

          <h2 class="reveal landing-research-title">
            <span class="landing-title-line">Investigación sobre</span>
            <span class="landing-title-line">Tolerancia Mínima</span>
          </h2>

          <p class="reveal">
            Papers que exploran la Tolerancia Mínima y los límites del poder estatal
          </p>

          <div class="section-action reveal"><a href="/es/papers" class="story-link">Ver los Papers <span aria-hidden="true">→</span></a></div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .book-landing-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.85rem;
      }

      /* Keep the Spanish landing question on precisely two readable lines. */
      .hero h1.landing-question-title {
        max-width: 100%;
      }

      .hero h1.landing-question-title span {
        display: block;
        margin-top: 0;
        color: inherit;
        font-size: inherit;
        line-height: inherit;
        letter-spacing: inherit;
        white-space: nowrap;
      }

      @media (max-width: 900px) {
        .hero h1.landing-question-title {
          font-size: clamp(1.35rem, 6vw, 3.8rem);
        }
      }

      @media (max-width: 560px) {
        .hero h1.landing-question-title {
          font-size: clamp(1.15rem, 5.8vw, 2.3rem);
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.14,
            rootMargin: "0px 0px -45px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
