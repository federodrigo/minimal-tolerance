---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Una Teoría de la Tolerancia Mínima | Tolerancia Mínima"
      description="Una Teoría de la Tolerancia Mínima de Fede Rodrigo examina la coerción, la autoridad política, la cooperación voluntaria y los límites del poder estatal."
      lang="es"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- TÍTULO DE PÁGINA -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            EL LIBRO
          </p>

          <h1>
            Una Teoría de la Tolerancia Mínima
          </h1>
        </div>
      </section>

      <!-- FRASE CENTRAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          De la legitimidad a la tolerancia
        </blockquote>
      </section>

      <!-- LIBRO -->

      <section class="book book-page-section">
        <div class="container">
          <div class="book-grid">
            <div class="book-cover-wrapper reveal reveal-left">
              <img
                src="/images/book-cover.jpg"
                alt="Portada de Una Teoría de la Tolerancia Mínima de Fede Rodrigo"
              />
            </div>

            <div class="book-copy reveal reveal-right">
              <p class="eyebrow">
                SOBRE EL LIBRO - DISPONIBLE A FINES DE SEPTIEMBRE DE 2026
              </p>

              <h2>
                Una Teoría de la Tolerancia Mínima
              </h2>

              <p>
                Este libro desarrolla los fundamentos morales, económicos
                e institucionales de la Teoría de la Tolerancia Mínima.
                Define las condiciones que una función debe satisfacer para
                superar el examen de necesidad coercitiva, sin tratar ese
                resultado como autorización para un arreglo coercitivo
                particular
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- AUTOR -->

      <section class="ssrn">
        <div class="container">
          <p class="eyebrow reveal">
            EL AUTOR
          </p>

          <h2 class="reveal">
            Sobre el autor
          </h2>

          <p class="reveal">
            Autor, ejecutivo de tecnología e investigador independiente
          </p>

          <a
            href="/es/author"
            class="primary reveal"
          >
            Conocer al Autor
          </a>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .book-page-section .book-grid {
        align-items: center;
      }

      .book-cover-wrapper {
        perspective: 1000px;
      }

      .book-cover-wrapper img {
        transform-origin: center;
        transition:
          transform 320ms ease,
          box-shadow 320ms ease;
      }

      .book-copy p:not(.eyebrow) {
        max-width: 760px;
      }

      @media (hover: hover) and (pointer: fine) {
        .book-cover-wrapper img:hover {
          transform: translateY(-7px) rotateY(-2deg) rotateZ(-0.5deg);
          box-shadow: 0 30px 76px rgba(13, 27, 42, 0.22);
        }
      }

      @media (max-width: 900px) {
        .book-cover-wrapper {
          max-width: 320px;
        }
      }

      @media (max-width: 560px) {
        .book-cover-wrapper {
          max-width: 270px;
          margin: 0 auto;
        }

        .book-copy {
          text-align: left;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .book-cover-wrapper img {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.14,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
