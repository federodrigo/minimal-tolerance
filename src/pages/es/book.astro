---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";
import BookEndorsement from "../../components/BookEndorsement.astro";

const conceptosCentrales = [
  {
    id: "teorema-tolerancia-minima",
    name: "Teorema de la Tolerancia Mínima",
    description:
      "Una función solo puede considerarse como excepción coercitiva si se prueban conjuntamente la no exclusión efectiva, la no rivalidad relevante y el colapso persistente de la provisión voluntaria. Superar el examen no autoriza una intervención particular",
  },
  {
    id: "presuncion-libertad",
    name: "Presunción de Libertad",
    description:
      "La cooperación voluntaria es la regla. Quien pretenda restringirla debe justificar la excepción; nadie tiene que defender su libertad",
  },
  {
    id: "inversion-carga-prueba",
    name: "Inversión de la Carga de la Prueba",
    description:
      "Un problema social no basta para justificar la intervención estatal. Quien propone coerción debe demostrar que su respuesta mejora las alternativas disponibles",
  },
  {
    id: "provision-voluntaria",
    name: "Provisión Voluntaria",
    description:
      "Formas estables de sostener una función sin coerción: mercados, contratos, cooperativas, acuerdos mutuos, organizaciones benéficas, asociaciones y comunidades",
  },
  {
    id: "colapso-persistente",
    name: "Colapso Persistente de la Provisión Voluntaria",
    description:
      "El free riding o la ausencia de una solución actual no prueban el fracaso. La provisión voluntaria debe fallar de manera persistente después de que alternativas genuinas hayan tenido oportunidad de desarrollarse",
  },
  {
    id: "ultimo-recurso-institucional",
    name: "Tecnología Institucional de Último Recurso",
    description:
      "El Estado entra en consideración solo como último recurso. Si instituciones voluntarias o nuevas tecnologías logran después sostener la función, desaparece el fundamento de la excepción",
  },
];

const conceptosSegundoFiltro = [
  {
    id: "segunda-carga-prueba",
    name: "Segunda Carga de la Prueba",
    description:
      "Ser responsable de garantizar una función no obliga al Estado a producirla directamente. La producción estatal debe superar una segunda carga de la prueba",
  },
  {
    id: "principio-separabilidad",
    name: "Principio de Separabilidad",
    description:
      "Garantizar una función y producirla son decisiones distintas. La ejecución puede quedar fuera del Estado sin perder la responsabilidad estatal ni la garantía de la función",
  },
  {
    id: "autoridad-verificabilidad-sustituibilidad",
    name: "Autoridad, Verificabilidad y Sustituibilidad",
    description:
      "El examen es secuencial: la autoridad soberana inseparable genera una presunción de ejecución estatal. Fuera de ese núcleo, la ejecución externa tiene prioridad si se puede verificar el desempeño y sustituir al productor sin comprometer la función",
  },
  {
    id: "perimetro-profundidad",
    name: "Perímetro y Profundidad",
    description:
      "El primer filtro limita qué funciones pueden quedar bajo responsabilidad estatal. El segundo determina cuánto de su producción debe permanecer dentro del Estado",
  },
];

const conceptosInstitucionales = [
  {
    id: "state-free-riding",
    name: "State Free Riding",
    description:
      "Una sociedad productiva puede absorber una carga estatal adicional y seguir funcionando. Esa adaptación incorpora la carga al punto de partida y puede hacer que otras parezcan viables. Facilita la expansión sin volverla inevitable",
  },
  {
    id: "paradoja-resiliencia",
    name: "Paradoja de la Resiliencia",
    description:
      "Cuanto más resiliente es una sociedad, más cargas puede absorber antes de mostrar un deterioro visible. Su fortaleza puede hacer que nuevas exigencias parezcan sostenibles",
  },
  {
    id: "bootstrap-institucional",
    name: "Bootstrap Institucional",
    description:
      "Las alternativas voluntarias necesitan tiempo, experiencia y recursos para desarrollarse. Si un control estatal prolongado impide su maduración, su ausencia no prueba que fueran inviables",
  },
  {
    id: "ratchet-institucional",
    name: "Ratchet Institucional",
    description:
      "Una atribución excepcional crea intereses, procedimientos y estructuras que vuelven cada vez más costosa su reversión. Lo temporal puede perdurar mucho después de desaparecer las circunstancias que lo justificaron",
  },
  {
    id: "estado-no-puede-autolimitarse",
    name: "El Estado No Puede Autolimitarse",
    description:
      "Las instituciones que crean, interpretan y hacen cumplir los límites del poder estatal forman parte del poder que pretenden contener. Las reglas escritas no garantizan por sí solas límites duraderos",
  },
  {
    id: "ley-disfraz-benevolente",
    name: "Ley del Disfraz Benevolente",
    description:
      "La coerción suele presentarse como ayuda: los impuestos como solidaridad, las restricciones como protección y la vigilancia como seguridad. Los beneficios prometidos pueden ocultar los medios coercitivos",
  },
  {
    id: "paradoja-tutela",
    name: "Paradoja de la Tutela",
    description:
      "La intervención puede debilitar las capacidades voluntarias cuya ausencia se usa después para justificarla. La dependencia puede ser, en parte, producto de la institución creada para aliviarla",
  },
  {
    id: "paradoja-fortaleza-institucional",
    name: "Paradoja de la Fortaleza Institucional",
    description:
      "Una Constitución no puede hacerse cumplir sola. Sus límites subsisten mientras quienes pueden violarlos elijan no hacerlo. La obediencia prolongada puede ocultar cuánto dependen las instituciones de la contención humana",
  },
];

const todosLosConceptos = [
  ...conceptosCentrales,
  ...conceptosSegundoFiltro,
  ...conceptosInstitucionales,
];

const pageUrl = new URL(
  Astro.url.pathname,
  "https://minimaltolerance.com"
).href;

const bookPdfUrl = "https://minimaltolerance.com/books/una-teoria-de-tolerancia-minima.pdf";

const bookSchema = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: "Una Teoría de Tolerancia Mínima",
  author: {
    "@type": "Person",
    name: "Fede Rodrigo",
  },
  url: pageUrl,
  inLanguage: "es",
  isAccessibleForFree: true,
  encoding: {
    "@type": "MediaObject",
    contentUrl: bookPdfUrl,
    encodingFormat: "application/pdf",
    inLanguage: "es",
  },
  description:
    "Una teoría sobre coerción, autoridad política, provisión voluntaria, límites institucionales, producción estatal, State Free Riding y las condiciones bajo las cuales el poder político puede ser tolerado como excepción",
  about: todosLosConceptos.map((concepto) => concepto.name),
};

const conceptSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  name: "Conceptos Clave de Una Teoría de Tolerancia Mínima",
  url: `${pageUrl}#conceptos-clave`,
  hasDefinedTerm: todosLosConceptos.map((concepto) => ({
    "@type": "DefinedTerm",
    name: concepto.name,
    description: concepto.description,
    url: `${pageUrl}#${concepto.id}`,
  })),
};
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Una Teoría de Tolerancia Mínima | Tolerancia Mínima"
      description="Una Teoría de Tolerancia Mínima de Fede Rodrigo desarrolla el Teorema de la Tolerancia Mínima como criterio para las excepciones coercitivas, el colapso persistente de la provisión voluntaria, el Principio de Separabilidad, State Free Riding y los límites institucionales del poder"
      lang="es"
      image="/images/book-cover-esp.jpg"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(bookSchema)}
    ></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(conceptSchema)}
    ></script>
  </head>

  <body>
    <Header />

    <main>
      <!-- TÍTULO DE PÁGINA -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            EL LIBRO
          </p>

          <h1>
            Una Teoría de<br />
            Tolerancia Mínima
          </h1>
        </div>
      </section>

      <!-- FRASE CENTRAL -->

      <BookEndorsement lang="es" />

      <!-- LIBRO -->

      <section class="book book-page-section">
        <div class="container">
          <div class="book-grid">
            <div class="book-cover-wrapper reveal reveal-left">
              <img
                src="/images/book-cover-esp.jpg"
                alt="Portada de Una Teoría de Tolerancia Mínima de Fede Rodrigo"
              />
            </div>

            <div class="book-copy reveal reveal-right">
              <p class="eyebrow">
                LIBRO DESTACADO
              </p>

              <h2>
                Una Teoría de<br />Tolerancia Mínima
              </h2>

              <p>
                El poder del Estado suele crecer acompañado de una promesa: resolver un problema, proteger a las personas o mejorar sus vidas. Pero las buenas intenciones no vuelven moralmente legítima la coerción
              </p>

              <p>
                <em>Una Teoría de Tolerancia Mínima</em> examina una dificultad fundamental: cuando las instituciones adquieren poder, también desarrollan incentivos para conservarlo. Lo que comienza como una excepción bien delimitada puede convertirse en un rasgo permanente de la vida política, incluso después de que hayan cambiado las circunstancias que la motivaron
              </p>

              <div class="book-access">
                <a
                  href="https://www.amazon.com/dp/B0HMM92K5R"
                  class="book-buy"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Comprar en Amazon
                </a>
                <a
                  href="/books/una-teoria-de-tolerancia-minima.pdf"
                  class="book-explore"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Leer gratis (PDF)
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      

      <!-- ABSTRACT -->

      <section class="book-abstract">
        <div class="container abstract-inner">
          <p class="eyebrow reveal">
            ABSTRACT
          </p>

          <h2 class="reveal book-question-heading">
            <span class="book-question-line">¿Cuándo puede</span>
            <span class="book-question-line"><span style="color: var(--gold)">tolerarse</span> la coerción?</span>
          </h2>

          <div class="abstract-copy reveal">
            <p>
              La Presunción de Libertad asigna la carga de la prueba a quienes proponen recurrir a la coerción. El Teorema de la Tolerancia Mínima establece tres condiciones necesarias bajo las cuales la coerción estatal puede considerarse tolerable: no exclusión efectiva, no rivalidad relevante y colapso persistente de la provisión voluntaria. Incluso si se cumplen las tres condiciones, ninguna intervención coercitiva particular queda automáticamente justificada
            </p>

            <p>
              El libro también distingue entre responsabilidad estatal y producción estatal directa, y examina cómo la intervención puede debilitar las alternativas voluntarias
            </p>
          </div>
        </div>
      </section>

      <!-- COMPARISON OF APPROACHES -->

      <section class="content-section approaches-section" aria-labelledby="approaches-heading">
        <div class="container">
          <p class="eyebrow reveal">UN CRITERIO, NO UNA LISTA</p>
          <h2 class="reveal" id="approaches-heading">Cuatro formas de pensar <span class="approaches-heading-accent">el Estado</span></h2>

          <div class="approaches-frame reveal reveal-scale">
            <table class="approaches-table" aria-labelledby="approaches-heading">
              <colgroup><col /><col /><col /><col /><col /></colgroup>
              <thead>
              <tr>
                <th scope="col">Criterio</th>
                <th scope="col">Anarcocapitalismo</th>
                <th scope="col">Minarquismo</th>
                <th scope="col">Liberalismo clásico</th>
                <th scope="col">Tolerancia Mínima</th>
              </tr>
              </thead>
              <tbody>
              <tr>
                <th scope="row">Existencia</th>
                <td data-label="Anarcocapitalismo">Lo rechaza</td>
                <td data-label="Minarquismo">Estado mínimo</td>
                <td data-label="Liberalismo clásico">Estado limitado</td>
                <td data-label="Tolerancia Mínima">Institución de último recurso</td>
              </tr>
              <tr>
                <th scope="row">Justificación moral</th>
                <td data-label="Anarcocapitalismo">Carece de legitimidad</td>
                <td data-label="Minarquismo">Legítimo para proteger derechos</td>
                <td data-label="Liberalismo clásico">Legítimo si protege derechos y libertades</td>
                <td data-label="Tolerancia Mínima">Carece de legitimidad</td>
              </tr>
              <tr>
                <th scope="row">Funciones</th>
                <td data-label="Anarcocapitalismo">Ninguna; provisión voluntaria</td>
                <td data-label="Minarquismo">Defensa, seguridad y justicia</td>
                <td data-label="Liberalismo clásico">Protección de derechos y determinadas funciones públicas</td>
                <td data-label="Tolerancia Mínima">Cada función debe cumplir NE, NR y CV</td>
              </tr>
              <tr>
                <th scope="row">Naturaleza del límite</th>
                <td data-label="Anarcocapitalismo">Moral y absoluto</td>
                <td data-label="Minarquismo">Moral y relativamente fijo</td>
                <td data-label="Liberalismo clásico">Constitucional e institucional</td>
                <td data-label="Tolerancia Mínima">Condicional, verificable y revisable</td>
              </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- CONCEPTOS CLAVE -->

      <section
        class="concepts"
        id="conceptos-clave"
      >
        <div class="container">
          <div class="section-intro manuscript-split book-intro-split"><div class="manuscript-copy">
            <p class="eyebrow reveal">
              CONCEPTOS CLAVE
            </p>

            <h2 class="reveal">
              La arquitectura conceptual
            </h2>

            <p class="section-lead reveal">
              El libro sigue tres preguntas: qué funciones pueden quedar bajo responsabilidad estatal, cuándo se justifica la producción estatal directa y qué ocurre una vez que el poder político existe
            </p>
          </div><figure class="manuscript-scene reveal reveal-right" role="img" aria-label="Estructuras institucionales entre ruinas"><span class="scene-picture scene-book" aria-hidden="true"></span></figure></div>

          <!-- PRIMER FILTRO -->

          <div class="concept-group">
            <div class="concept-group-heading reveal">
              <span class="concept-number">01</span>

              <div>
                <p class="concept-kicker">
                  EL PRIMER FILTRO
                </p>

                <h3>
                  ¿Cuándo puede una función entrar al Estado?
                </h3>
              </div>
            </div>

            <div class="concept-grid">
              {
                conceptosCentrales.map((concepto) => (
                  <article
                    class="concept-card reveal"
                    id={concepto.id}
                  >
                    <h4>
                      {concepto.name}
                    </h4>

                    <p>
                      {concepto.description}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>

          <!-- SEGUNDO FILTRO -->

          <div class="concept-group">
            <div class="concept-group-heading reveal">
              <span class="concept-number">02</span>

              <div>
                <p class="concept-kicker">
                  EL SEGUNDO FILTRO
                </p>

                <h3>
                  ¿Cuánto Estado hace falta?
                </h3>
              </div>
            </div>

            <div class="concept-grid">
              {
                conceptosSegundoFiltro.map((concepto) => (
                  <article
                    class="concept-card reveal"
                    id={concepto.id}
                  >
                    <h4>
                      {concepto.name}
                    </h4>

                    <p>
                      {concepto.description}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>

          <!-- CONSECUENCIAS -->

          <div class="concept-group">
            <div class="concept-group-heading reveal">
              <span class="concept-number">03</span>

              <div>
                <p class="concept-kicker">
                  LAS CONSECUENCIAS
                </p>

                <h3>
                  ¿Qué ocurre una vez que el poder existe?
                </h3>
              </div>
            </div>

            <div class="concept-grid">
              {
                conceptosInstitucionales.map((concepto) => (
                  <article
                    class="concept-card reveal"
                    id={concepto.id}
                  >
                    <h4>
                      {concepto.name}
                    </h4>

                    <p>
                      {concepto.description}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- PRINCIPIO CENTRAL -->

      <section class="book-principle">
        <div class="container">
          <p class="eyebrow reveal">
            EL ESTÁNDAR
          </p>

          <blockquote class="reveal reveal-scale book-standard-singleline">
            <strong>La carga de la prueba pertenece al poder</strong>
          </blockquote>

          <p class="reveal">
            Primero cuando pretende entrar. Otra vez cuando pretende producir
          </p>
        </div>
      </section>

      <!-- PAPERS -->

      <section class="ssrn">
        <div class="container">
          <p class="eyebrow reveal">
            LOS PAPERS
          </p>

          <h2 class="reveal book-research-singleline">
            La investigación detrás de la teoría
          </h2>

          <p class="reveal">
            Explora los trabajos de investigación que desarrollan los criterios, argumentos y consecuencias institucionales del libro
          </p>

          <a
            href="/es/papers"
            class="primary reveal"
          >
            Explorar los Papers
          </a>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /* Anchor the cover to the text heading, independent of copy length. */
      .book-page-section .book-grid {
        align-items: start;
      }

      @media (min-width: 901px) {
        .book-page-section .book-cover-wrapper {
          margin-top: 14px;
        }
      }

      .book-cover-wrapper {
        perspective: 1000px;
      }

      .book-cover-wrapper img {
        transform-origin: center;
        transition:
          transform 320ms ease,
          box-shadow 320ms ease;
      }

      .book-copy p:not(.eyebrow) {
        max-width: 720px;
      }

      .book-copy p + p {
        margin-top: 0.9rem;
      }

      /* ABSTRACT */

      .book-abstract {
        padding: 3rem 0 3.5rem;
      }

      .abstract-inner {
        max-width: 980px;
      }

      .abstract-inner h2 {
        max-width: 760px;
        margin-bottom: 1.25rem;
      }

      .abstract-inner h2 .abstract-title-line {
        display: block;
        white-space: nowrap;
      }

      @media (max-width: 560px) {
        .abstract-inner h2 {
          font-size: clamp(1.22rem, 5.6vw, 2rem);
        }
      }

      .abstract-copy {
        max-width: 900px;
        font-size: 1.03rem;
        line-height: 1.65;
      }

      .abstract-copy p {
        margin: 0;
      }

      .abstract-copy p + p {
        margin-top: 0.9rem;
      }

      /* CONCEPTOS CLAVE */

      .concepts {
        padding: 3.5rem 0 4rem;
      }

      .section-intro {
        max-width: 850px;
        margin-bottom: 2.4rem;
      }

      .section-intro h2 {
        margin-bottom: 0;
      }

      .section-lead {
        max-width: 760px;
        margin-top: 0.8rem;
        font-size: 1.03rem;
        line-height: 1.6;
      }

      .concept-group + .concept-group {
        margin-top: 3rem;
      }

      .concept-group-heading {
        display: grid;
        grid-template-columns: 96px 1fr;
        gap: 1.1rem;
        align-items: start;
        margin-bottom: 1.2rem;
      }

      .concept-number {
        display: block;
        margin-top: -0.05rem;
        color: var(--gold, #b49355);
        font-size: clamp(3rem, 5vw, 4.6rem);
        font-weight: 400;
        line-height: 0.82;
        letter-spacing: -0.065em;
      }

      .concept-kicker {
        margin: 0 0 0.18rem;
        font-size: 0.68rem;
        font-weight: 400;
        letter-spacing: 0.14em;
      }

      .concept-group-heading h3 {
        margin: 0;
        font-size: clamp(1.45rem, 2.3vw, 2rem);
        font-weight: 400;
        line-height: 1.15;
      }

      .concept-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid rgba(13, 27, 42, 0.16);
      }

      .concept-card {
        padding: 1.35rem 1.65rem 1.45rem 0;
        border-bottom: 1px solid rgba(13, 27, 42, 0.16);
        scroll-margin-top: 100px;
      }

      .concept-card:nth-child(even) {
        padding-left: 1.65rem;
        border-left: 1px solid rgba(13, 27, 42, 0.16);
      }

      .concept-card h4 {
        margin: 0 0 0.5rem;
        font-size: clamp(1.1rem, 1.5vw, 1.32rem);
        font-weight: 700;
        line-height: 1.2;
      }

      .concept-card p {
        margin: 0;
        max-width: 620px;
        font-size: 0.96rem;
        line-height: 1.55;
      }

      /* PRINCIPIO CENTRAL */

      .book-principle {
        padding: 3.2rem 0 3.5rem;
        text-align: center;
      }

      .book-principle blockquote {
        max-width: 950px;
        margin: 0.7rem auto;
        font-size: clamp(2rem, 4vw, 3.6rem);
        line-height: 1.05;
        letter-spacing: -0.03em;
      }

      .book-principle > .container > p:last-child {
        max-width: 620px;
        margin: 0.85rem auto 0;
        font-size: 0.98rem;
        opacity: 0.72;
      }

      @media (hover: hover) and (pointer: fine) {
        .book-cover-wrapper img:hover {
          transform: translateY(-7px) rotateY(-2deg) rotateZ(-0.5deg);
          box-shadow: 0 30px 76px rgba(13, 27, 42, 0.22);
        }
      }

      @media (max-width: 900px) {
        .book-cover-wrapper {
          max-width: 320px;
        }

        .concept-grid {
          grid-template-columns: 1fr;
        }

        .concept-card,
        .concept-card:nth-child(even) {
          padding: 1.25rem 0;
          border-left: 0;
        }
      }

      @media (max-width: 560px) {
        .book-cover-wrapper {
          max-width: 270px;
          margin: 0 auto;
        }

        .book-copy {
          text-align: left;
        }

        .book-abstract {
          padding: 2.6rem 0 3rem;
        }

        .concepts {
          padding: 3rem 0 3.5rem;
        }

        .concept-group + .concept-group {
          margin-top: 2.6rem;
        }

        .concept-group-heading {
          grid-template-columns: 64px 1fr;
          gap: 0.75rem;
        }

        .concept-number {
          font-size: 2.9rem;
        }

        .concept-card {
          padding: 1.15rem 0 1.25rem;
        }

        .book-principle {
          padding: 2.8rem 0 3rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .book-cover-wrapper img {
          transition: none;
        }
      }
    
      /* Three selected titles fit on one line at desktop widths only */
      @media (min-width: 861px) {
        .book-principle blockquote.book-standard-singleline {
          max-width: none;
          font-size: clamp(1.8rem, 3.1vw, 2.65rem);
          white-space: nowrap;
          letter-spacing: -0.037em;
        }
        .ssrn h2.book-research-singleline {
          max-width: none;
          font-size: clamp(1.8rem, 3.1vw, 2.65rem);
          white-space: nowrap;
          letter-spacing: -0.035em;
        }
      }

    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (
        reduceMotion ||
        !("IntersectionObserver" in window)
      ) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver =
          new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;

                entry.target.classList.add(
                  "is-visible"
                );

                observer.unobserve(entry.target);
              });
            },
            {
              threshold: 0.14,
              rootMargin:
                "0px 0px -40px 0px",
            }
          );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
