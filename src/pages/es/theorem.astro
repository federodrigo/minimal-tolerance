---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="El Teorema de la Tolerancia Mínima | Tolerancia Mínima"
      description="Las condiciones necesarias, la carga de la prueba y los límites institucionales del Teorema de la Tolerancia Mínima de Federico Rodrigo."
      lang="es"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- TÍTULO DE PÁGINA -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            EL CRITERIO FORMAL
          </p>

          <h1>
            El Teorema de la<br />
            Tolerancia Mínima
          </h1>
<p class="story-trail" aria-label="Recorrido de lectura"><span class="story-step">Preguntas</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step">Teoría</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step is-current">Teorema</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step">Casos</span></p>
        </div>
      </section>

      <!-- FRASE CENTRAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          El Estado es una tecnología institucional de último recurso
        </blockquote>
      </section>

      <!-- ÚLTIMO RECURSO INSTITUCIONAL -->

      <section class="content-section content-section-alt">
        <div class="container manuscript-split"><div class="manuscript-copy">
          <p class="eyebrow reveal">
            ÚLTIMO RECURSO INSTITUCIONAL
          </p>

          <h2 class="reveal theorem-exception-heading">
            Definir la excepción
          </h2>

          <p class="reveal">
            La autoridad política no tiene legitimidad moral ni superioridad institucional por defecto. Un beneficio colectivo o una falla de mercado no bastan para tolerar la coerción. Quien la propone debe demostrar que la función cumple las condiciones del teorema
          </p>
        </div><figure class="manuscript-scene reveal reveal-right" role="img" aria-label="Paso estrecho que representa la excepción"><span class="scene-picture scene-theorem" aria-hidden="true"></span></figure></div>
      </section>

      <!-- FORMULACIÓN FORMAL -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            EL TEOREMA DE LA TOLERANCIA MÍNIMA
          </p>

          <h2 class="reveal">
            Formulación formal
          </h2>

          <blockquote class="formal-statement theorem-definition-statement reveal reveal-scale">
            Una función satisface el Criterio de Tolerancia Mínima solo
            cuando se establecen conjuntamente la no exclusión efectiva,
            la no rivalidad relevante y el colapso persistente de la
            provisión voluntaria
          </blockquote>
        </div>
      </section>

      <!-- TRES CONDICIONES -->

      <section class="theorem">
        <div class="container">
          <p class="eyebrow reveal">
            EL CRITERIO
          </p>

          <h2 class="reveal">
            Dos condiciones económicas<br />
            Un examen institucional
          </h2>

          <div class="theorem-conditions stagger reveal">

            <article>
              <span>NE</span>

              <h3>
                No exclusión efectiva
              </h3>

              <p>
                No puede excluirse de manera efectiva a quienes no contribuyen al beneficio
              </p>
            </article>

            <article>
              <span>NR</span>

              <h3>
                No rivalidad relevante
              </h3>

              <p>
                El uso del beneficio por una persona no reduce significativamente su disponibilidad para los demás
              </p>
            </article>

            <article>
              <span>CV</span>

              <h3>
                Colapso persistente de la provisión voluntaria
              </h3>

              <p>
                Los incentivos a beneficiarse sin contribuir socavan de forma persistente el financiamiento, la coordinación o la participación necesarios para sostener la provisión voluntaria
              </p>
            </article>

          </div>
        </div>
      </section>

      <!-- COROLARIO -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            COROLARIO
          </p>

          <h2 class="reveal theorem-corollary-heading">
            La carga permanece del lado de la coerción
          </h2>

          <blockquote class="formal-statement theorem-definition-statement reveal reveal-scale">
            La importancia, el beneficio colectivo, la provisión insuficiente y los free riders no demuestran la necesidad de coerción. Si falla alguna condición, el argumento de bienes públicos a favor de la coerción deja de sostenerse
          </blockquote>
        </div>
      </section>

      <!-- LÍMITES DEL CRITERIO -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow reveal">
            LÍMITES DEL CRITERIO
          </p>

          <h2 class="reveal">
            Aplicación y permanencia
          </h2>

          <p class="reveal">
            El teorema establece un criterio, pero no garantiza una aplicación imparcial. Las instituciones y sus integrantes siguen sujetos a errores, incentivos e intereses propios
          </p>

          <p class="reveal">
            Superar el criterio una vez no vuelve permanente la excepción. Quienes ejercen el poder deben seguir demostrando que las condiciones se mantienen
          </p>
        </div>
      </section>

      <!-- CASOS -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            CASOS
          </p>

          <h2 class="reveal">
            Poner a prueba el límite
          </h2>

          <p class="reveal">
            El teorema distingue el fracaso persistente causado por
            incentivos de free rider de la conveniencia política,
            el paternalismo y la insatisfacción con los resultados
            voluntarios
          </p>

          <div class="section-action reveal"><a href="/es/cases/" class="story-link">Continuar a los casos <span aria-hidden="true">→</span></a></div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .theorem-conditions article {
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      .theorem-conditions article > span {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0;

        transition:
          transform 220ms ease,
          color 220ms ease;
      }

      .formal-statement {
        transition:
          transform 260ms ease,
          border-color 260ms ease,
          box-shadow 260ms ease;
      }

      @media (hover: hover) and (pointer: fine) {
        .theorem-conditions article:hover {
          transform: translateY(-5px);
          border-color: rgba(169, 131, 58, 0.42);
          box-shadow: 0 18px 42px rgba(13, 27, 42, 0.09);
        }

        .theorem-conditions article:hover > span {
          color: var(--navy);
          transform: translateX(4px);
        }

        .formal-statement:hover {
          transform: translateY(-2px);
          border-left-color: var(--navy);
          box-shadow: 0 14px 34px rgba(13, 27, 42, 0.07);
        }
      }

      @media (max-width: 900px) {
        .theorem-conditions article {
          min-height: auto;
        }
      }

      @media (max-width: 560px) {
        .formal-statement.reveal-scale {
          transform: translateY(18px) scale(0.99);
        }

        .formal-statement.reveal-scale.is-visible {
          transform: translateY(0) scale(1);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .theorem-conditions article,
        .theorem-conditions article > span,
        .formal-statement {
          transition: none;
        }
      }
    
      /* Give the formal definition slightly more typographic weight. */
      .formal-statement.theorem-definition-statement {
        font-size: clamp(1.2rem, 1.65vw, 1.32rem);
        line-height: 1.68;
      }
      @media (max-width: 600px) {
        .formal-statement.theorem-definition-statement {
          font-size: 1.1rem;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.13,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
