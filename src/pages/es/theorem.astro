---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="El Teorema de la Tolerancia Mínima | Tolerancia Mínima"
      description="La formulación formal, las condiciones necesarias, la carga de la prueba y el corolario del Teorema de la Tolerancia Mínima de Federico Rodrigo."
      lang="es"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- TÍTULO -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            LA PRUEBA FORMAL
          </p>

          <h1>
            El Teorema de la Tolerancia Mínima
          </h1>
        </div>
      </section>

      <!-- FRASE PRINCIPAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          El Estado solo puede ser tolerado como una
          tecnología institucional de último recurso
        </blockquote>
      </section>

      <!-- ÚLTIMO RECURSO INSTITUCIONAL -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow reveal">
            ÚLTIMO RECURSO INSTITUCIONAL
          </p>

          <h2 class="reveal">
            Definiendo la excepción
          </h2>

          <p class="reveal">
            El Estado no constituye ni una solución moral ni una
            solución eficiente. Su justificación no puede descansar
            en la legitimidad, ni en ninguna afirmación de desempeño
            superior. Ambos argumentos ya han fracasado
          </p>

          <p class="reveal">
            Cualquier posible tolerancia permanece excepcional y no
            general. El teorema define la frontera entre aquello que
            puede ser tolerado con reticencia y aquello que debe
            permanecer fuera de esa excepción
          </p>
        </div>
      </section>

      <!-- FORMULACIÓN FORMAL -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            EL TEOREMA DE LA TOLERANCIA MÍNIMA
          </p>

          <h2 class="reveal">
            Formulación formal
          </h2>

          <blockquote class="formal-statement reveal reveal-scale">
            La coerción estatal solo puede ser tolerada cuando un
            problema estructural de free rider vuelve
            persistentemente inviable una provisión voluntaria
            estable y la no intervención produciría un daño mayor
          </blockquote>
        </div>
      </section>

      <!-- TRES CONDICIONES -->

      <section class="theorem">
        <div class="container">
          <p class="eyebrow reveal">
            LAS TRES CONDICIONES
          </p>

          <h2 class="reveal">
            Un problema estructural de free rider
          </h2>

          <div class="theorem-conditions stagger">
            <article class="reveal reveal-scale">
              <span>01</span>

              <h3>
                No exclusión efectiva
              </h3>

              <p>
                Debe resultar física, técnica o económicamente
                imposible excluir a quienes no pagan del beneficio
                relevante
              </p>
            </article>

            <article class="reveal reveal-scale">
              <span>02</span>

              <h3>
                No rivalidad relevante
              </h3>

              <p>
                El uso del bien por parte de una persona no debe
                reducir de manera significativa la cantidad
                disponible para los demás
              </p>
            </article>

            <article class="reveal reveal-scale">
              <span>03</span>

              <h3>
                Colapso persistente de la provisión voluntaria
              </h3>

              <p>
                Fracaso real y continuo de los mecanismos privados,
                no causado por barreras estatales previas o actuales
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- COROLARIO -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            COROLARIO
          </p>

          <h2 class="reveal">
            La no intervención sigue siendo la regla
          </h2>

          <blockquote class="formal-statement reveal reveal-scale">
            La importancia, el beneficio colectivo o la existencia
            de una dificultad no constituyen una justificación
            funcional para la coerción. Allí donde no exista un
            problema estructural de free rider, la intervención
            estatal debe presumirse ilegítima por defecto
          </blockquote>
        </div>
      </section>

      <!-- APLICACIONES -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow reveal">
            APLICACIONES
          </p>

          <h2 class="reveal">
            Poniendo a prueba el límite
          </h2>

          <p class="reveal">
            El teorema solo importa si puede distinguir la auténtica
            necesidad institucional de la conveniencia política, el
            paternalismo y la insatisfacción con los resultados
            voluntarios
          </p>

          <div class="buttons reveal">
            <a href="/es/applications" class="primary">
              Explorar las Aplicaciones
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .theorem-conditions article {
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      .theorem-conditions article > span {
        transition:
          transform 220ms ease,
          color 220ms ease;
      }

      .formal-statement {
        transition:
          transform 260ms ease,
          border-color 260ms ease,
          box-shadow 260ms ease;
      }

      @media (hover: hover) and (pointer: fine) {
        .theorem-conditions article:hover {
          transform: translateY(-5px);
          border-color: rgba(169, 131, 58, 0.42);
          box-shadow: 0 18px 42px rgba(13, 27, 42, 0.09);
        }

        .theorem-conditions article:hover > span {
          color: var(--navy);
          transform: translateX(4px);
        }

        .formal-statement:hover {
          transform: translateY(-2px);
          border-left-color: var(--navy);
          box-shadow: 0 14px 34px rgba(13, 27, 42, 0.07);
        }
      }

      @media (max-width: 900px) {
        .theorem-conditions article {
          min-height: auto;
        }
      }

      @media (max-width: 560px) {
        .formal-statement.reveal-scale {
          transform: translateY(18px) scale(0.99);
        }

        .formal-statement.reveal-scale.is-visible {
          transform: translateY(0) scale(1);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .theorem-conditions article,
        .theorem-conditions article > span,
        .formal-statement {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.13,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
