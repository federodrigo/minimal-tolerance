---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";
---

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="El Teorema de la Tolerancia Mínima | Tolerancia Mínima"
      description="Las condiciones necesarias, la carga de la prueba y los límites institucionales del Teorema de la Tolerancia Mínima de Federico Rodrigo."
      lang="es"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- TÍTULO DE PÁGINA -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            EL CRITERIO FORMAL
          </p>

          <h1>
            El Teorema de la Tolerancia Mínima
          </h1>
        </div>
      </section>

      <!-- FRASE CENTRAL -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          El Estado es una tecnología institucional de último recurso
        </blockquote>
      </section>

      <!-- ÚLTIMO RECURSO INSTITUCIONAL -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow reveal">
            ÚLTIMO RECURSO INSTITUCIONAL
          </p>

          <h2 class="reveal">
            Definir la excepción
          </h2>

          <p class="reveal">
            La autoridad política no puede presumir legitimidad moral
            ni superioridad institucional. La existencia de un problema,
            un beneficio colectivo o una falla de mercado no justifica
            por sí sola reemplazar la cooperación voluntaria por coerción
          </p>

          <p class="reveal">
            Toda posible tolerancia permanece, por tanto, como una
            excepción. La carga recae sobre quienes proponen la coerción,
            y el teorema define las condiciones que una función debe
            satisfacer para superar el examen de necesidad coercitiva
          </p>
        </div>
      </section>

      <!-- FORMULACIÓN FORMAL -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            EL TEOREMA DE LA TOLERANCIA MÍNIMA
          </p>

          <h2 class="reveal">
            Formulación formal
          </h2>

          <blockquote class="formal-statement reveal reveal-scale">
            Una función supera el Criterio de Tolerancia Mínima solo
            cuando se establecen conjuntamente la no exclusión efectiva,
            la no rivalidad relevante y el colapso persistente de la
            provisión voluntaria. Esto no justifica por sí solo ningún
            arreglo coercitivo en particular
          </blockquote>
        </div>
      </section>

      <!-- TRES CONDICIONES -->

      <section class="theorem">
        <div class="container">
          <p class="eyebrow reveal">
            EL CRITERIO
          </p>

       <h2 class="reveal">
  Dos condiciones económicas<br />
  Un examen institucional
</h2>

          <div class="theorem-conditions stagger">

            <article class="reveal reveal-scale">
              <span>01</span>

              <h3>
                No exclusión efectiva
              </h3>

              <p>
                El acceso no puede condicionarse efectivamente a la
                contribución: quienes no contribuyen continúan recibiendo
                el beneficio relevante
              </p>
            </article>

            <article class="reveal reveal-scale">
              <span>02</span>

              <h3>
                No rivalidad relevante
              </h3>

              <p>
                El uso del beneficio relevante no debe reducir de manera
                significativa lo que queda disponible para los demás
              </p>
            </article>

            <article class="reveal reveal-scale">
              <span>03</span>

              <h3>
                Colapso persistente de la provisión voluntaria
              </h3>

              <p>
                El incentivo a beneficiarse sin contribuir debe socavar
                el financiamiento, la coordinación o la participación
                necesarios para sostener la función en el tiempo
              </p>
            </article>

          </div>
        </div>
      </section>

      <!-- COROLARIO -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            COROLARIO
          </p>

          <h2 class="reveal">
            La carga sigue del lado de la coerción
          </h2>

          <blockquote class="formal-statement reveal reveal-scale">
            La importancia, el beneficio colectivo, la provisión
            insuficiente o la presencia de free riders no pueden
            establecer la necesidad de coerción. Si cualquiera de las
            tres condiciones falla, el caso de bienes públicos a favor
            de la necesidad coercitiva termina allí
          </blockquote>
        </div>
      </section>

      <!-- APLICACIONES -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow reveal">
            APLICACIONES
          </p>

          <h2 class="reveal">
            Poner a prueba el límite
          </h2>

          <p class="reveal">
            El teorema distingue el fracaso persistente causado por
            incentivos de free rider de la conveniencia política,
            el paternalismo y la insatisfacción con los resultados
            voluntarios
          </p>

          <div class="buttons reveal">
            <a href="/es/applications" class="primary">
              Explorar las Aplicaciones
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .theorem-conditions article {
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

  .theorem-conditions article > span {
  font-size: 1.55rem;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.02em;

  transition:
    transform 220ms ease,
    color 220ms ease;
}

      .formal-statement {
        transition:
          transform 260ms ease,
          border-color 260ms ease,
          box-shadow 260ms ease;
      }

      @media (hover: hover) and (pointer: fine) {
        .theorem-conditions article:hover {
          transform: translateY(-5px);
          border-color: rgba(169, 131, 58, 0.42);
          box-shadow: 0 18px 42px rgba(13, 27, 42, 0.09);
        }

        .theorem-conditions article:hover > span {
          color: var(--navy);
          transform: translateX(4px);
        }

        .formal-statement:hover {
          transform: translateY(-2px);
          border-left-color: var(--navy);
          box-shadow: 0 14px 34px rgba(13, 27, 42, 0.07);
        }
      }

      @media (max-width: 900px) {
        .theorem-conditions article {
          min-height: auto;
        }
      }

      @media (max-width: 560px) {
        .formal-statement.reveal-scale {
          transform: translateY(18px) scale(0.99);
        }

        .formal-statement.reveal-scale.is-visible {
          transform: translateY(0) scale(1);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .theorem-conditions article,
        .theorem-conditions article > span,
        .formal-statement {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.13,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
