---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
---

<!doctype html>

<html lang="en">
  <head>
    <script is:inline>
      // Choose a language once when the visitor opens the main homepage.
      (function () {
        const storageKey = 'minimal-tolerance-language';
        let preference = null;

        try {
          preference = window.localStorage.getItem(storageKey);
        } catch (_) {
          // Storage can be restricted or unavailable.
        }

        if (preference !== 'es' && preference !== 'en') {
          const browserLanguage =
            (navigator.languages && navigator.languages.length
              ? navigator.languages[0]
              : navigator.language) || '';

          preference = /^es(?:[-_]|$)/i.test(browserLanguage) ? 'es' : 'en';

          try {
            window.localStorage.setItem(storageKey, preference);
          } catch (_) {
            // Detection still works for this visit.
          }
        }

        if (preference === 'es') {
          window.location.replace(
            '/es/' + window.location.search + window.location.hash
          );
        }
      })();
    </script>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="What is government for? | Minimal Tolerance"
      socialTitle="Minimal Tolerance"
      description="The Theory of Minimal Tolerance establishes the conditions under which coercive provision of a function may be considered tolerable on grounds of necessity"
      lang="en"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->

      <section class="hero">
        <div class="hero-content hero-sequence">
          <p class="eyebrow">
            THE THEORY OF MINIMAL TOLERANCE
          </p>

          <h1>What is government <em>for?</em></h1>

          <div class="buttons">
            <a href="/theory/" class="primary">Explore the Theory</a>
            <a href="/book/" class="secondary">Explore the Book</a>
          </div>
        </div>
      </section>

      <!-- CENTRAL STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          The burden of proof belongs to power
        </blockquote>
      </section>

      <!-- BOOK -->

      <section id="book" class="book">
        <div class="container">
          <div class="book-grid">
            <div class="reveal reveal-left">
              <a
                href="/book"
                aria-label="Explore the book A Theory of Minimal Tolerance"
              >
                <img
                  src="/images/book-cover.jpg"
                  alt="Cover of A Theory of Minimal Tolerance by Fede Rodrigo"
                  loading="lazy"
                />
              </a>
            </div>

            <div class="reveal reveal-right">
              <p class="eyebrow">
                THE BOOK
              </p>

              <h2 class="landing-book-title">
                <span class="landing-title-line">A Theory of</span>
                <span class="landing-title-line">Minimal Tolerance</span>
              </h2>

              <p>
                Political debates often revolve around the use of power. Some call for more intervention, others for less. Rarely is there a clear criterion for determining when the exercise of that power can be tolerated
              </p>

              <p>
                <strong>The Theory of Minimal Tolerance</strong> reverses the burden of proof
              </p>

              <p>
                <strong>What must be demonstrated before anyone can impose their will on another?</strong>
              </p>

              <figure class="book-inline-endorsement" aria-label="Book endorsement">
                <blockquote>“This fascinating book of yours makes an <span class="quote-tail">important contribution”</span></blockquote>
                <figcaption>Walter E. Block, Ph.D.</figcaption>
              </figure>

              <div class="book-landing-actions">
                <a
                  href="https://www.amazon.com/dp/B0HMX14TDZ"
                  class="book-buy"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Buy on Amazon
                </a>
                <a href="/book" class="book-explore">
                  Explore the Book
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

             

      <!-- QUESTIONS -->

      <section id="questions" class="content-section">
        <div class="container manuscript-split"><div class="manuscript-copy">
          <p class="eyebrow reveal">
            THE CENTRAL QUESTIONS
          </p>

          <h2 class="reveal">
             Behind the theory
          </h2>

          <p class="reveal">
            What limits government power? • Do public goods or the
            free-rider problem justify coercion? • When can coercion
            be tolerated without becoming legitimate?
          </p>

          <div class="section-action reveal"><a href="/questions" class="story-link">Explore the Questions <span aria-hidden="true">→</span></a></div>
        </div><figure class="manuscript-scene reveal reveal-right" role="img" aria-label="Voluntary agreement and compulsion"><span class="scene-picture scene-home" aria-hidden="true"></span></figure></div>
      </section>

      <!-- THEORY -->

      <section id="theory" class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            THE THEORY
          </p>

          <h2 class="reveal">
            Foundations
          </h2>

          <div class="foundation-principles stagger">
            <article class="foundation-principle reveal">
              <span class="foundation-number">
                01
              </span>

              <div>
                <h3>
                  No intrinsic moral legitimacy
                </h3>

                <p>
                  The State possesses no moral authority merely by
                  existing or by exercising power
                </p>
              </div>
            </article>

            <article class="foundation-principle reveal">
              <span class="foundation-number">
                02
              </span>

              <div>
                <h3>
                  Structural limits of government
                </h3>

                <p>
                  Governments face unavoidable limits of information,
                  economic calculation, incentives, and error
                  correction that no concentration of power can
                  eliminate
                </p>
              </div>
            </article>

            <article class="foundation-principle reveal">
              <span class="foundation-number">
                03
              </span>

              <div>
                <h3>
                  Presumption of liberty
                </h3>

                <p>
                  Liberty is the baseline. Coercion bears the burden
                  of proof
                </p>
              </div>
            </article>
          </div>

          <div class="section-action reveal"><a href="/theory" class="story-link">Continue Reading <span aria-hidden="true">→</span></a></div>
        </div>
      </section>

      <!-- THEOREM -->

      <section id="theorem" class="theorem">
        <div class="container">
          <p class="eyebrow reveal">
            THE CRITERION
          </p>

          <h2 class="reveal">
            The Minimal Tolerance Theorem
          </h2>

          <div class="theorem-summary stagger reveal"><article class="theorem-summary-card"><span class="criterion-mark">NE</span><h3>Non-contributors can’t be effectively excluded</h3></article><article class="theorem-summary-card"><span class="criterion-mark">NR</span><h3>One person’s use doesn’t meaningfully reduce what others receive</h3></article><article class="theorem-summary-card"><span class="criterion-mark">CV</span><h3>Voluntary provision repeatedly fails</h3></article></div>

          <div class="section-action reveal"><a href="/theorem" class="story-link">Examine the Theorem <span aria-hidden="true">→</span></a></div>
        </div>
      </section>

      <!-- RESEARCH -->

      <section id="papers" class="ssrn">
        <div class="container">
          <p class="eyebrow reveal">
            THE PAPERS
          </p>

          <h2 class="reveal landing-research-title">
            <span class="landing-title-line">Research on</span>
            <span class="landing-title-line">Minimal Tolerance</span>
          </h2>

          <p class="reveal">
            Papers exploring Minimal Tolerance and the limits of state power
          </p>

          <div class="section-action section-action-centered reveal"><a href="/papers" class="story-link">View the Papers <span aria-hidden="true">→</span></a></div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /* Place the landing cover beside the book title, not centered against all the copy. */
      @media (min-width: 901px) {
        #book .book-grid {
          align-items: start;
        }

        #book .book-grid > div:first-child {
          margin-top: 42px;
        }
      }

      /* An endorsement inside the book presentation, not a second banner. */
      #book .book-inline-endorsement {
        margin: 18px 0 22px;
        padding-left: 18px;
        border-left: 2px solid var(--gold);
        text-align: left;
      }

      #book .book-inline-endorsement blockquote {
        max-width: none;
        margin: 0 0 8px;
        font-size: clamp(1.13rem, 1.7vw, 1.35rem);
        font-style: italic;
        font-weight: 400;
        line-height: 1.4;
        letter-spacing: -0.015em;
        text-align: left;
        text-wrap: balance;
      }

      #book .book-inline-endorsement .quote-tail {
        white-space: nowrap;
      }

      #book .book-inline-endorsement figcaption {
        font-size: 0.92rem;
        line-height: 1.35;
      }

    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.14,
            rootMargin: "0px 0px -45px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
