---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="When May Coercion Be Tolerated? | Minimal Tolerance"
      description="The Theory of Minimal Tolerance establishes the conditions under which coercive provision of a function may be considered tolerable on grounds of necessity"
      lang="en"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->

      <section class="hero">
        <div class="hero-content hero-sequence">
          <p class="eyebrow">
            THE THEORY OF MINIMAL TOLERANCE
          </p>

          <h1>
            When may coercion<br />
            be tolerated?
          </h1>

          <div
            class="animated-text animated-text-four"
            aria-label="Power is tolerated. Not legitimized. Only under exceptional conditions. A theory of coercion and its limits"
          >
            <span>Power is tolerated</span>
            <span>Not legitimized</span>
            <span>Only under exceptional conditions</span>
            <span>A theory of coercion and its limits</span>
          </div>

          <div class="buttons">
            <a href="/theory" class="primary">
              Explore the Theory
            </a>

            <a href="/book" class="secondary">
              Explore the Book
            </a>
          </div>
        </div>
      </section>

      <!-- CENTRAL STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          The burden of proof belongs to power
        </blockquote>
      </section>

      <!-- BOOK -->

      <section id="book" class="book">
        <div class="container">
          <div class="book-grid">
            <div class="reveal reveal-left">
              <a
                href="/book"
                class="book-cover-link"
                aria-label="Explore the book A Theory of Minimal Tolerance"
              >
                <img
                  src="/images/book-cover.jpg"
                  alt="Cover of A Theory of Minimal Tolerance by Fede Rodrigo"
                  loading="lazy"
                />
              </a>
            </div>

            <div class="reveal reveal-right">
              <p class="eyebrow">
                THE BOOK
              </p>

              <h2>
                A Theory of Minimal Tolerance
              </h2>

              <p>
                A forthcoming book on coercion, its limits,<br />
                and the burden of proof imposed on power
              </p>

              <a href="/book" class="secondary">
                Explore the Book
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- QUESTIONS -->

      <section id="questions" class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            THE CENTRAL QUESTIONS
          </p>

          <h2 class="reveal">
            Where the debate begins
          </h2>

          <p class="reveal">
            Why should government perform some functions but not
            others? • When, if ever, may coercion be tolerated? •
            Where should the limits of political power be drawn?
          </p>

          <a href="/questions" class="secondary reveal">
            Read the Questions
          </a>
        </div>
      </section>

      <!-- THEORY -->

      <section id="theory" class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            THE THEORY
          </p>

          <h2 class="reveal">
            Foundations
          </h2>

          <div class="foundation-principles stagger">
            <article class="foundation-principle reveal">
              <span class="foundation-number">
                01
              </span>

              <div>
                <h3>
                  No intrinsic moral legitimacy
                </h3>

                <p>
                  The State possesses no moral authority merely by
                  existing or by exercising power
                </p>
              </div>
            </article>

            <article class="foundation-principle reveal">
              <span class="foundation-number">
                02
              </span>

              <div>
                <h3>
                  Structural limits of government
                </h3>

                <p>
                  Governments face unavoidable limits of information,
                  economic calculation, incentives, and error
                  correction that no concentration of power can
                  eliminate
                </p>
              </div>
            </article>

            <article class="foundation-principle reveal">
              <span class="foundation-number">
                03
              </span>

              <div>
                <h3>
                  Presumption of liberty
                </h3>

                <p>
                  Liberty is the baseline. Coercion bears the burden
                  of proof
                </p>
              </div>
            </article>
          </div>

          <a href="/theory" class="secondary reveal">
            Continue Reading
          </a>
        </div>
      </section>

      <!-- THEOREM -->

      <section id="theorem" class="theorem">
        <div class="container">
          <p class="eyebrow reveal">
            THE CRITERION
          </p>

          <h2 class="reveal">
            The Minimal Tolerance Theorem
          </h2>

          <div class="theorem-summary stagger">
            <article class="theorem-summary-card reveal reveal-scale">
              <h3>
                Effective non-excludability
              </h3>
            </article>

            <article class="theorem-summary-card reveal reveal-scale">
              <h3>
                Relevant non-rivalry
              </h3>
            </article>

            <article class="theorem-summary-card reveal reveal-scale">
              <h3>
                Persistent collapse of voluntary provision
              </h3>
            </article>
          </div>

          <div class="buttons reveal">
            <a href="/theorem" class="primary">
              Examine the Theorem
            </a>
          </div>
        </div>
      </section>

      <!-- RESEARCH -->

      <section id="papers" class="ssrn">
        <div class="container">
          <p class="eyebrow reveal">
            RESEARCH
          </p>

          <h2 class="reveal">
            Research on Minimal Tolerance
          </h2>

          <p class="reveal">
            Papers exploring Minimal Tolerance and the limits of state power
          </p>

          <a
            href="/papers"
            class="primary reveal"
          >
            View the Papers
          </a>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.14,
            rootMargin: "0px 0px -45px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>

<style>
  /*
    HERO ANIMATION — 4 PHRASES
  */

  .hero .animated-text-four {
    position: relative;
    min-height: 1.6em;
  }

  .hero .animated-text-four > span {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;

    opacity: 0;

    animation-name: minimalToleranceHeroFour;
    animation-duration: 12s;
    animation-timing-function: ease;
    animation-iteration-count: infinite;
    animation-fill-mode: both;
  }

  .hero .animated-text-four > span:nth-child(1) {
    animation-delay: 0s;
  }

  .hero .animated-text-four > span:nth-child(2) {
    animation-delay: 3s;
  }

  .hero .animated-text-four > span:nth-child(3) {
    animation-delay: 6s;
  }

  .hero .animated-text-four > span:nth-child(4) {
    animation-delay: 9s;
  }

  @keyframes minimalToleranceHeroFour {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }

    5% {
      opacity: 1;
      transform: translateY(0);
    }

    20% {
      opacity: 1;
      transform: translateY(0);
    }

    25% {
      opacity: 0;
      transform: translateY(-6px);
    }

    100% {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  /*
    BOOK COVER LINK
  */

  .book-cover-link {
    display: inline-block;
  }

  .book-cover-link img {
    display: block;
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }

  .book-cover-link:hover img {
    transform: scale(1.02);
  }

  .book-cover-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 6px;
  }

  /*
    REDUCED MOTION
  */

  @media (prefers-reduced-motion: reduce) {
    .hero .animated-text-four > span {
      display: none;
      animation: none;
    }

    .hero .animated-text-four > span:first-child {
      display: block;
      position: static;
      opacity: 1;
      transform: none;
    }

    .book-cover-link img {
      transition: none;
    }

    .book-cover-link:hover img {
      transform: none;
    }
  }
</style>
