---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";

const questions = [
  {
    id: "state-moral-legitimacy",
    number: "01",
    title: "Is the State morally legitimate?",
    answer: [
      "No. The State claims compulsory authority over everyone in a territory, whether they consent or not",
      "Legality, democratic approval, or benevolent aims do not turn compulsion into consent",
    ],
  },
  {
    id: "state-criminal-organization",
    number: "02",
    title: "Is the State a criminal organization?",
    answer: [
      "Yes, in a normative sense. Taxation, compulsory jurisdiction, and enforcement would be coercive if exercised without consent by a private association",
      "Legality does not, by itself, confer moral legitimacy",
    ],
  },
  {
    id: "government-efficiency",
    number: "03",
    title: "Can government ever be efficient?",
    answer: [
      "No—not institutionally. A public agency may perform a particular task well, but government still faces structural limits of information, economic calculation, incentives, competition, exit, and error correction",
      "Those limits can be reduced, not eliminated",
    ],
  },
  {
    id: "functions-of-government",
    number: "04",
    title: "What functions should government perform?",
    answer: [
      "There is no predefined list. Defense, courts, education, health, or any other function must be examined rather than accepted by convention",
      "The question is whether coercion is necessary for that specific function",
    ],
  },
  {
    id: "burden-of-proof-coercion",
    number: "05",
    title: "Who must prove that coercion is necessary?",
    answer: [
      "Whoever seeks to impose it. Liberty is the baseline, so the burden of proof belongs to power",
    ],
  },
  {
    id: "democracy-legitimizes-coercion",
    number: "06",
    title: "Does democracy legitimize State coercion?",
    answer: [
      "No. Elections can decide who governs and under what rules, but they do not convert compulsory decisions into individual consent",
      "Majority approval is a procedure for choosing political action, not a moral exemption from justifying it",
    ],
  },
  {
    id: "essential-services-state-coercion",
    number: "07",
    title: "Do essential services justify State coercion?",
    answer: [
      "No. A service can be essential, valuable, or even life-saving without making compulsory provision necessary",
      "The importance of the goal and the justification for coercive means are separate questions",
    ],
  },
  {
    id: "public-goods-government-provision",
    number: "08",
    title: "Do public goods require government provision?",
    answer: [
      "No. Non-excludability and non-rivalry describe characteristics of a good, not who must provide it",
      "Samuelson formalized collective consumption, but public-good status alone does not establish that State provision is necessary",
    ],
  },
  {
    id: "free-rider-state-coercion",
    number: "09",
    title: "Does the free-rider problem justify State coercion?",
    answer: [
      "No. Benefiting without paying does not show that a function cannot be sustained voluntarily",
      "Free riding matters when the same incentive problem repeatedly defeats materially different voluntary arrangements",
    ],
  },
  {
    id: "failure-voluntary-provision",
    number: "10",
    title: "When does voluntary provision actually fail?",
    answer: [
      "When materially different arrangements repeatedly collapse because the same incentive structure prevents the function from being sustained",
      "One failed provider, temporary underprovision, or the absence of a current alternative is not enough",
    ],
  },
  {
    id: "schmidtz-public-goods-free-riders",
    number: "11",
    title: "What does David Schmidtz argue about public goods and free riders?",
    answer: [
      "In <em>The Limits of Government</em>, Schmidtz shows that public goods and free riders do not automatically justify State authority and that voluntary arrangements can work",
      "Minimal Tolerance goes further: coercion enters only after persistent collapse of voluntary provision has been established",
    ],
  },
  {
    id: "market-failure-government-intervention",
    number: "12",
    title: "Do market failures justify government intervention?",
    answer: [
      "No. Natural monopoly, imperfect information, concentration, coordination problems, or underprovision can identify shortcomings in markets",
      "None of them proves that State intervention is necessary or superior to available alternatives",
    ],
  },
  {
    id: "externalities-government-intervention",
    aliases: [
      "positive-externalities-government-intervention",
      "negative-externalities-government-intervention",
    ],
    number: "13",
    title: "Do externalities justify government intervention?",
    answer: [
      "Not by themselves. Positive externalities do not create a right to compel payment or State provision",
      "Negative externalities can involve harm, but then the central issues are rights, liability, and compensation—not a general license for government intervention",
    ],
  },
  {
    id: "libertarianism-state-coercion",
    number: "14",
    title: "Can a libertarian theory tolerate State coercion?",
    answer: [
      "Yes, exceptionally. Minimal Tolerance begins from liberty and rejects coercion as morally legitimate in itself",
      "It allows a coercive function to be tolerated only when necessity is established and no viable voluntary alternative remains",
    ],
  },
  {
    id: "hayek-government-power",
    number: "15",
    title: "What limits government power in Hayek's political theory?",
    answer: [
      "Hayek emphasizes dispersed knowledge, spontaneous order, general rules, and the rule of law as limits on political power",
      "Minimal Tolerance asks an earlier question: which functions, if any, may be placed under coercive authority at all",
    ],
  },
  {
    id: "buchanan-constitutional-political-economy",
    number: "16",
    title: "What limits government in Buchanan's constitutional political economy?",
    answer: [
      "Buchanan focuses on constitutional rules for collective decisions and on the role of agreement",
      "Minimal Tolerance asks whether a function may be assigned to coercive authority before its institutional design is chosen",
    ],
  },
  {
    id: "rothbard-anarcho-capitalism-state-coercion",
    number: "17",
    title: "Does Rothbard's anarcho-capitalism reject all State coercion?",
    answer: [
      "Yes. Rothbard rejects compulsory State provision and treats coercion as morally illegitimate regardless of who exercises it",
      "Minimal Tolerance shares that starting point but allows exceptional tolerance when coercive necessity is established",
    ],
  },
  {
    id: "minarchism-defense-police-courts",
    number: "18",
    title: "Does minarchism justify a State limited to defense, police, and courts?",
    answer: [
      "Minarchism usually treats defense, police, and courts as the legitimate core of a minimal State",
      "Minimal Tolerance grants no function automatic exemption. Each must independently satisfy the same burden of proof",
    ],
  },
  {
    id: "nozick-minimal-state-legitimacy",
    number: "19",
    title: "Is Nozick's minimal State morally legitimate?",
    answer: [
      "In <em>Anarchy, State, and Utopia</em>, Nozick argues that a minimal State can arise without violating rights and can therefore be legitimate",
      "Minimal Tolerance rejects that conclusion: limiting its scope does not change the moral status of compulsory authority",
    ],
  },
  {
    id: "absence-voluntary-alternatives-state-necessary",
    number: "20",
    title: "Does the absence of voluntary alternatives prove the State is necessary?",
    answer: [
      "No. The absence of a voluntary option today does not prove that coercive provision is necessary",
      "Legal monopoly, regulation, subsidies, or prior State provision may have blocked entry and experimentation",
    ],
  },
  {
    id: "economic-inequality-state-coercion",
    number: "21",
    title: "Does economic inequality justify State coercion?",
    answer: [
      "No. Economic differences are not inherently unjust",
      "They can result from work, choices, luck, inheritance—or from privilege, fraud, or aggression. Where rights are violated, the issue is the violation, not the unequal outcome",
    ],
  },
  {
    id: "poverty-state-coercion",
    number: "22",
    title: "Does poverty justify State coercion?",
    answer: [
      "No. Poverty can create powerful moral reasons to help, but need alone does not establish a right to compel others to provide or finance assistance",
      "Urgency strengthens the case for helping; it does not automatically justify coercive means",
    ],
  },
  {
    id: "collective-action-government-intervention",
    number: "23",
    title: "Do collective-action problems require government intervention?",
    answer: [
      "No. Contracts, firms, clubs, associations, insurance, charities, and social norms can organize many collective tasks without compulsory authority",
      "Imperfect coordination or underprovision is not enough; coercion requires a separate showing of necessity",
    ],
  },
  {
    id: "keynesian-economics-government-intervention",
    number: "24",
    title: "Does Keynesian economics justify government intervention?",
    answer: [
      "Not by itself. Keynesian economics argues that fiscal or monetary policy can stabilize demand during recessions",
      "Even if a policy is effective, that does not settle whether taxation, compulsory financing, or other coercive means are justified",
    ],
  },
  {
    id: "rawls-theory-justice-redistribution",
    number: "25",
    title: "Does Rawls's theory of justice justify redistribution?",
    answer: [
      "Not by itself. Rawls offers a moral case for arranging social and economic inequalities to benefit the least advantaged",
      "Even if that principle is accepted, coercive redistribution still requires its own justification",
    ],
  },
  {
    id: "musgrave-functions-government-intervention",
    number: "26",
    title: "Do Musgrave's functions of government justify State intervention?",
    answer: [
      "No. Musgrave's allocation, distribution, and stabilization branches classify three major roles of public finance; they do not establish coercive authority",
      "Each function must still show why compulsory provision or financing is necessary rather than merely useful or desirable",
    ],
  },
];

const stripHtml = (value) =>
  value.replace(/<[^>]*>/g, "");

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((question) => ({
    "@type": "Question",
    name: question.title,
    acceptedAnswer: {
      "@type": "Answer",
      text: question.answer.map(stripHtml).join(" "),
    },
  })),
};
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="What Should Government Be Allowed to Do? | Minimal Tolerance"
      description="When is government intervention justified? Questions on State coercion, public goods, market failure, externalities, inequality, Keynes, Rawls, and the limits of government power"
      lang="en"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    ></script>
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->

      <section class="hero questions-page-hero">
        <div class="hero-content hero-sequence">
          <p class="eyebrow">
            THE QUESTIONS
          </p>

          <h1>
            What should the State<br />
            be allowed to do?
          </h1>
        </div>
      </section>

      <!-- CENTRAL STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          No one has an inherent right to rule another
        </blockquote>
      </section>

      <!-- KEY QUESTIONS -->

      <section class="questions-index">
        <div class="questions-container">
          <p class="eyebrow reveal key-questions-label">
            KEY QUESTIONS
          </p>

          <nav
            class="questions-index-grid stagger"
            aria-label="Questions about government, coercion, public goods, and political power"
          >
            {
              questions.map((question) => (
                <a
                  href={`#${question.id}`}
                  class="question-index-card reveal"
                >
                  <span class="question-index-number">
                    {question.number}
                  </span>

                  <span class="question-index-title">
                    {question.title}
                  </span>
                </a>
              ))
            }
          </nav>
        </div>
      </section>

      <!-- QUESTIONS -->

      <section class="questions-content">
        <div class="questions-container">
          {
            questions.map((question) => (
              <article
                id={question.id}
                class="question-section"
              >
                {question.aliases?.map((alias) => (
                  <span id={alias} class="anchor-alias" aria-hidden="true"></span>
                ))}
                <div class="question-heading reveal reveal-left">
                  <span class="question-number">
                    {question.number}
                  </span>

                  <h2>
                    {question.title}
                  </h2>
                </div>

                <div class="question-copy reveal reveal-right">
                  {question.answer.map((paragraph) => (
                    <p set:html={paragraph}></p>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- FINAL CTA -->

      <section class="questions-cta">
        <div class="questions-container questions-cta-content">
          <div class="reveal reveal-left">
            <p class="eyebrow">
              THE THEORY OF MINIMAL TOLERANCE
            </p>

            <h2>
              The burden of proof belongs to power
            </h2>

            <p>
              Explore the criterion that determines when a function can
              pass the test of coercive necessity without turning
              tolerance into legitimacy
            </p>
          </div>

          <div class="questions-cta-buttons reveal reveal-right">
            <a href="/theory" class="primary">
              Explore the Theory
            </a>

            <a href="/theorem" class="secondary">
              Examine the Theorem
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /*
       * Force a true two-column grid here so each pair of questions
       * shares the exact same row height.
       */
      .key-questions-label {
        color: #a07d37 !important;
        font-size: 1.15rem;
        letter-spacing: 0.14em;
        margin-bottom: 1.25rem;
      }

      .questions-index-grid {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        grid-auto-flow: row !important;
        gap: 0 !important;
        align-items: stretch !important;
      }

      .question-index-card {
        box-sizing: border-box !important;
        display: grid !important;
        grid-template-columns: 3.1rem minmax(0, 1fr) !important;
        align-items: start !important;
        align-content: start !important;
        column-gap: 1rem !important;
        width: 100% !important;
        height: 100% !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 1rem 1.15rem 1rem 0 !important;
        transition:
          color 220ms ease,
          background 220ms ease,
          transform 220ms ease;
      }

      .question-index-card:nth-child(odd) {
        border-right: 1px solid var(--line, rgba(20, 30, 40, 0.14)) !important;
        padding-right: 1.4rem !important;
      }

      .question-index-card:nth-child(even) {
        padding-left: 2rem !important;
      }

      .question-index-number,
      .question-index-title {
        align-self: start !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .question-index-number {
        line-height: 1.28 !important;
        transition: transform 220ms ease;
      }

      .question-index-title {
        display: block !important;
        line-height: 1.28;
      }

      /*
       * Keep the index type exactly at the approved size.
       */
      .question-index-title {
        font-size: clamp(0.95rem, 1vw, 1.08rem);
      }

      /*
       * Developed-question title: 10% smaller than the previous version.
       * Right-side answer size is untouched.
       */
      .question-number {
        display: inline-block;
        transform: scale(1.50);
        transform-origin: left top;
      }

      .question-heading h2 {
        font-size: clamp(1.08rem, 1.62vw, 1.62rem);
        line-height: 1.12;
      }

      .question-section {
        position: relative;
        overflow: hidden;
      }

      .anchor-alias {
        position: absolute;
        top: 0;
        left: 0;
        width: 0;
        height: 0;
      }

      @media (hover: hover) and (pointer: fine) {
        .question-index-card:hover {
          transform: translateY(-2px);
        }

        .question-index-card:hover .question-index-number {
          transform: translateX(5px);
        }
      }

      @media (max-width: 900px) {
        .questions-index-grid {
          grid-template-columns: 1fr !important;
        }

        .question-index-card,
        .question-index-card:nth-child(odd),
        .question-index-card:nth-child(even) {
          grid-template-columns: 2.75rem minmax(0, 1fr) !important;
          column-gap: 0.85rem !important;
          padding: 0.9rem 0 !important;
          border-right: 0 !important;
        }

        .question-index-title {
          font-size: 0.95rem;
        }

        .question-heading h2 {
          font-size: clamp(0.99rem, 3.33vw, 1.26rem);
        }

        .question-heading.reveal-left,
        .question-copy.reveal-right {
          transform: translateY(24px);
        }

        .question-heading.reveal-left.is-visible,
        .question-copy.reveal-right.is-visible {
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .question-index-card,
        .question-index-number {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
