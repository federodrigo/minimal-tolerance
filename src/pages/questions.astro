---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";

const questions = [
  {
      id: "liberty-moral-baseline",
      number: "01",
      title: "Why should liberty be the moral baseline?",
      answer: [
        "Because coercion binds people without their consent. Benefits, fairness, or desirable outcomes may matter, but restricting liberty still requires justification",
      ],
    },
  {
      id: "burden-of-proof-coercion",
      number: "02",
      title: "Who must prove that coercion is necessary?",
      answer: [
        "Whoever seeks to impose it. Liberty is the baseline; the burden of proof belongs to power",
      ],
    },
  {
      id: "state-moral-legitimacy",
      number: "03",
      title: "Is the State morally legitimate?",
      answer: [
        "No. The State claims compulsory authority over people who have not consented to it",
        "Law and elections can regulate that power; they do not turn coercion into consent",
      ],
    },
  {
      id: "better-outcomes-state-coercion",
      number: "04",
      title: "Can better outcomes justify State coercion?",
      answer: [
        "No. Good consequences matter, but expected social gains do not by themselves create a right to compel others",
        "Otherwise almost any intrusion could be defended by predicting enough benefit",
      ],
    },
  {
      id: "democracy-legitimizes-coercion",
      number: "05",
      title: "Does democracy legitimize State coercion?",
      answer: [
        "No. Elections choose who exercises power and under what rules; they do not turn compulsory decisions into individual consent",
        "Majority support establishes political authorization, not moral legitimacy",
      ],
    },
  {
      id: "state-criminal-organization",
      number: "06",
      title: "Is the State a criminal organization?",
      answer: [
        "Yes, in a normative sense. Taxation, compulsory jurisdiction, and enforcement rely on powers that would be coercive if claimed by a private association without consent",
        "Legal authorization does not settle their moral status",
      ],
    },
  {
      id: "functions-of-government",
      number: "07",
      title: "What functions should government perform?",
      answer: [
        "No function is exempt in advance. Defense, courts, education, health, and others must be assessed separately",
        "The question is whether coercion is necessary for that function",
      ],
    },
  {
      id: "government-efficiency",
      number: "08",
      title: "Can government ever be efficient?",
      answer: [
        "No—not as an institution. A public agency may perform a particular task well",
        "The State still faces structural limits of information, calculation, incentives, competition, exit, and error correction that management cannot eliminate",
      ],
    },
  {
      id: "essential-services-state-coercion",
      number: "09",
      title: "Do essential services justify State coercion?",
      answer: [
        "No. Importance or urgency does not prove compulsory provision necessary",
        "The value of an end and the means used to pursue it are separate questions",
      ],
    },
  {
      id: "economic-inequality-state-coercion",
      number: "10",
      title: "Does economic inequality justify State coercion?",
      answer: [
        "No. Economic differences are not inherently unjust",
        "They can result from work, choices, luck, inheritance—or from privilege, fraud, or aggression. Where rights are violated, the issue is the violation, not the unequal outcome",
      ],
    },
  {
      id: "poverty-state-coercion",
      number: "11",
      title: "Does poverty justify State coercion?",
      answer: [
        "No. Poverty can create urgent reasons to help, but need alone does not create authority to compel others to provide or finance assistance",
      ],
    },
  {
      id: "public-goods-government-provision",
      number: "12",
      title: "Do public goods require government provision?",
      answer: [
        "No. Non-excludability and non-rivalry describe a good, not its required provider",
        "Samuelson formalized collective consumption; that classification alone does not establish a State role",
      ],
    },
  {
      id: "free-rider-state-coercion",
      number: "13",
      title: "Does the free-rider problem justify State coercion?",
      answer: [
        "No. Benefiting without paying does not show that voluntary provision will collapse",
        "Free riding matters only when the same incentive problem persistently defeats materially different arrangements",
      ],
    },
  {
      id: "failure-voluntary-provision",
      number: "14",
      title: "When does voluntary provision actually fail?",
      answer: [
        "When materially different arrangements repeatedly collapse because the same incentive structure prevents stable provision",
        "One failed provider, temporary underprovision, or the lack of a current alternative is not enough",
      ],
    },
  {
      id: "absence-voluntary-alternatives-state-necessary",
      number: "15",
      title: "Does the absence of voluntary alternatives prove the State is necessary?",
      answer: [
        "No. The absence of a voluntary option today does not prove coercive provision necessary",
        "Monopoly, regulation, subsidies, or prior State provision may have prevented alternatives from emerging",
      ],
    },
  {
      id: "market-failure-government-intervention",
      number: "16",
      title: "Do market failures justify government intervention?",
      answer: [
        "No. Monopoly, imperfect information, concentration, coordination failures, or underprovision may reveal market shortcomings",
        "They do not establish that government action is necessary or superior",
      ],
    },
  {
      id: "externalities-government-intervention",
      aliases: [
        "positive-externalities-government-intervention",
        "negative-externalities-government-intervention",
      ],
      number: "17",
      title: "Do externalities justify government intervention?",
      answer: [
        "Not automatically. Positive externalities do not create a right to compel payment",
        "Negative externalities may involve harm; then the relevant questions are rights, liability, and compensation—not a general license for intervention",
      ],
    },
  {
      id: "collective-action-government-intervention",
      number: "18",
      title: "Do collective-action problems require government intervention?",
      answer: [
        "No. Contracts, firms, clubs, associations, insurance, charities, and norms can coordinate many collective tasks without compulsory authority",
        "Failure in one arrangement or some underprovision does not establish coercive necessity",
      ],
    },
  {
      id: "schmidtz-public-goods-free-riders",
      number: "19",
      title: "What does David Schmidtz argue about public goods and free riders?",
      answer: [
        "In <em>The Limits of Government</em>, Schmidtz argues that public goods and free riders do not automatically establish State authority and shows that voluntary arrangements can work",
        "Minimal Tolerance adds a stricter condition: coercion can be considered only after persistent collapse across materially different voluntary arrangements",
      ],
    },
  {
      id: "keynesian-economics-government-intervention",
      number: "20",
      title: "Does Keynesian economics justify government intervention?",
      answer: [
        "Not by itself. Keynesian economics gives reasons for fiscal or monetary stabilization during downturns",
        "Even if those policies improve outcomes, effectiveness does not settle whether compulsory financing or control is justified",
      ],
    },
  {
      id: "rawls-theory-justice-redistribution",
      number: "21",
      title: "Does Rawls justify redistribution?",
      answer: [
        "Yes, under certain conditions. Rawls's principles can support redistribution when institutions protect equal liberties, fair opportunity, and the least advantaged",
        "Minimal Tolerance asks whether those aims also justify coercion",
      ],
    },
  {
      id: "musgrave-functions-government-intervention",
      number: "22",
      title: "What are Musgrave's three functions of government?",
      answer: [
        "Allocation, distribution, and stabilization",
        "Musgrave classifies major roles of public finance; the classification does not prove that any of them requires compulsory provision or financing",
      ],
    },
  {
      id: "libertarianism-state-coercion",
      number: "23",
      title: "Can a libertarian theory tolerate State coercion?",
      answer: [
        "Yes, exceptionally. Minimal Tolerance rejects coercion as morally legitimate, but tolerates a function when necessity is established and no viable voluntary alternative remains",
      ],
    },
  {
      id: "hayek-government-power",
      number: "24",
      title: "What limits government power in Hayek's political theory?",
      answer: [
        "Hayek stresses dispersed knowledge, spontaneous order, general rules, and the rule of law",
        "Minimal Tolerance asks an earlier question: which functions, if any, may be placed under coercive authority",
      ],
    },
  {
      id: "buchanan-constitutional-political-economy",
      number: "25",
      title: "What limits government in Buchanan's constitutional political economy?",
      answer: [
        "Buchanan focuses on constitutional rules for collective choice and the role of agreement",
        "Minimal Tolerance asks whether a function may be coercively assigned before its institutional design is chosen",
      ],
    },
  {
      id: "rothbard-anarcho-capitalism-state-coercion",
      number: "26",
      title: "Does Rothbard's anarcho-capitalism reject all State coercion?",
      answer: [
        "Yes. Rothbard rejects compulsory State provision and treats coercion as illegitimate regardless of who exercises it",
        "Minimal Tolerance shares that starting point but allows exceptional tolerance when necessity is established",
      ],
    },
  {
      id: "minarchism-defense-police-courts",
      number: "27",
      title: "Does minarchism justify a State limited to defense, police, and courts?",
      answer: [
        "Minarchism treats defense, police, and courts as the legitimate core of a minimal State",
        "Minimal Tolerance grants them no automatic exemption; each must satisfy the same test",
      ],
    },
  {
      id: "nozick-minimal-state-legitimacy",
      number: "28",
      title: "Is Nozick's minimal State morally legitimate?",
      answer: [
        "In <em>Anarchy, State, and Utopia</em>, Nozick argues that a minimal State can arise without violating rights and therefore be legitimate",
        "Minimal Tolerance rejects that conclusion: smaller scope does not change the moral status of compulsory authority",
      ],
    },
];

const stripHtml = (value) =>
  value.replace(/<[^>]*>/g, "");

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((question) => ({
    "@type": "Question",
    name: question.title,
    acceptedAnswer: {
      "@type": "Answer",
      text: question.answer.map(stripHtml).join(" "),
    },
  })),
};
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="What Should Government Be Allowed to Do? | Minimal Tolerance"
      description="When is government intervention justified? 28 concise questions on State legitimacy, coercion, public goods, market failure, externalities, inequality, Keynes, Rawls, and government power"
      lang="en"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    ></script>
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->

      <section class="hero questions-page-hero">
        <div class="hero-content hero-sequence">
          <p class="eyebrow">
            THE QUESTIONS
          </p>

          <h1>
            What should the State<br />
            be allowed to do?
          </h1>
        </div>
      </section>

      <!-- CENTRAL STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          No one has an inherent right to rule another
        </blockquote>
      </section>

      <!-- KEY QUESTIONS -->

      <section class="questions-index">
        <div class="questions-container">
          <p class="eyebrow reveal key-questions-label">
            KEY QUESTIONS
          </p>

          <nav
            class="questions-index-grid stagger"
            aria-label="Questions about government, coercion, public goods, and political power"
          >
            {
              questions.map((question) => (
                <a
                  href={`#${question.id}`}
                  class="question-index-card reveal"
                >
                  <span class="question-index-number">
                    {question.number}
                  </span>

                  <span class="question-index-title">
                    {question.title}
                  </span>
                </a>
              ))
            }
          </nav>
        </div>
      </section>

      <!-- QUESTIONS -->

      <section class="questions-content">
        <div class="questions-container">
          {
            questions.map((question) => (
              <article
                id={question.id}
                class="question-section"
              >
                {question.aliases?.map((alias) => (
                  <span id={alias} class="anchor-alias" aria-hidden="true"></span>
                ))}
                <div class="question-heading reveal reveal-left">
                  <span class="question-number">
                    {question.number}
                  </span>

                  <h2>
                    {question.title}
                  </h2>
                </div>

                <div class="question-copy reveal reveal-right">
                  {question.answer.map((paragraph) => (
                    <p set:html={paragraph}></p>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- FINAL CTA -->

      <section class="questions-cta">
        <div class="questions-container questions-cta-content">
          <div class="reveal reveal-left">
            <p class="eyebrow">
              THE THEORY OF MINIMAL TOLERANCE
            </p>

            <h2>
              The burden of proof belongs to power
            </h2>

            <p>
              Explore the criterion that determines when a function can
              pass the test of coercive necessity without turning
              tolerance into legitimacy
            </p>
          </div>

          <div class="questions-cta-buttons reveal reveal-right">
            <a href="/theory" class="primary">
              Explore the Theory
            </a>

            <a href="/theorem" class="secondary">
              Examine the Theorem
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /*
       * Force a true two-column grid here so each pair of questions
       * shares the exact same row height.
       */
      .key-questions-label {
        color: #a07d37 !important;
        font-size: 1.15rem;
        letter-spacing: 0.14em;
        margin-bottom: 1.25rem;
      }

      .questions-index-grid {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        grid-auto-flow: row !important;
        gap: 0 !important;
        align-items: stretch !important;
      }

      .question-index-card {
        box-sizing: border-box !important;
        display: grid !important;
        grid-template-columns: 3.1rem minmax(0, 1fr) !important;
        align-items: start !important;
        align-content: start !important;
        column-gap: 1rem !important;
        width: 100% !important;
        height: 100% !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 1rem 1.15rem 1rem 0 !important;
        transition:
          color 220ms ease,
          background 220ms ease,
          transform 220ms ease;
      }

      .question-index-card:nth-child(odd) {
        border-right: 1px solid var(--line, rgba(20, 30, 40, 0.14)) !important;
        padding-right: 1.4rem !important;
      }

      .question-index-card:nth-child(even) {
        padding-left: 2rem !important;
      }

      .question-index-number,
      .question-index-title {
        align-self: start !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .question-index-number {
        line-height: 1.28 !important;
        transition: transform 220ms ease;
      }

      .question-index-title {
        display: block !important;
        line-height: 1.28;
      }

      /*
       * Keep the index type exactly at the approved size.
       */
      .question-index-title {
        font-size: clamp(0.95rem, 1vw, 1.08rem);
      }

      /*
       * Developed-question title: 10% smaller than the previous version.
       * Right-side answer size is untouched.
       */
      .question-number {
        display: inline-block;
        transform: scale(1.50);
        transform-origin: left top;
      }

      .question-heading h2 {
        font-size: clamp(1.08rem, 1.62vw, 1.62rem);
        line-height: 1.12;
      }

      .question-section {
        position: relative;
        overflow: hidden;
      }

      .anchor-alias {
        position: absolute;
        top: 0;
        left: 0;
        width: 0;
        height: 0;
      }

      @media (hover: hover) and (pointer: fine) {
        .question-index-card:hover {
          transform: translateY(-2px);
        }

        .question-index-card:hover .question-index-number {
          transform: translateX(5px);
        }
      }

      @media (max-width: 900px) {
        .questions-index-grid {
          grid-template-columns: 1fr !important;
        }

        .question-index-card,
        .question-index-card:nth-child(odd),
        .question-index-card:nth-child(even) {
          grid-template-columns: 2.75rem minmax(0, 1fr) !important;
          column-gap: 0.85rem !important;
          padding: 0.9rem 0 !important;
          border-right: 0 !important;
        }

        .question-index-title {
          font-size: 0.95rem;
        }

        .question-heading h2 {
          font-size: clamp(0.99rem, 3.33vw, 1.26rem);
        }

        .question-heading.reveal-left,
        .question-copy.reveal-right {
          transform: translateY(24px);
        }

        .question-heading.reveal-left.is-visible,
        .question-copy.reveal-right.is-visible {
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .question-index-card,
        .question-index-number {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
