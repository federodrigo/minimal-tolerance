---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";

const questions = [
  {
    id: "functions-of-government",
    number: "01",
    title: "What Functions Should Government Perform?",
    answer: [
      "No function should be taken for granted simply because it is assigned to the State. Each must pass the same criterion",
    ],
  },
  {
    id: "burden-of-proof-coercion",
    number: "02",
    title: "Who Must Prove That Coercion Is Necessary?",
    answer: [
      "Whoever seeks to impose it. Liberty is the baseline, and the burden of proof falls on power",
    ],
  },
  {
    id: "legitimacy-state-coercion",
    number: "03",
    title: "Can State Coercion Ever Be Legitimate?",
    answer: [
      "No. The fact that coercion comes from the State does not make it morally legitimate",
      "It can be tolerable without becoming legitimate",
    ],
  },
  {
    id: "democracy-legitimizes-coercion",
    number: "04",
    title: "Does Democracy Legitimize State Coercion?",
    answer: [
      "No. Voting or electing a government does not transfer moral authority to decide for others in every matter",
      "Majority approval does not turn an imposed decision into a voluntary one",
    ],
  },
  {
    id: "usefulness-necessity-coercion",
    number: "05",
    title: "Does the Usefulness or Necessity of a Function Justify Coercion?",
    answer: [
      "No. A function can be useful, necessary, valuable, or socially beneficial and still fail to justify coercion",
      "The importance of the end does not replace the criterion",
    ],
  },
  {
    id: "public-goods-government-provision",
    number: "06",
    title: "Do Public Goods Require Government Provision?",
    answer: [
      "No. Non-excludability and non-rivalry describe a structure of the good, not an institutional conclusion",
      "Provision can be sustained through voluntary arrangements. Samuelson formalized the structure of collective consumption goods in <em>The Pure Theory of Public Expenditure</em>; it does not follow that the State must provide them",
    ],
  },
  {
    id: "free-rider-state-coercion",
    number: "07",
    title: "Does the Free-Rider Problem Justify State Coercion?",
    answer: [
      "No. The fact that someone can benefit without contributing does not show that the function cannot be sustained",
      "Free riding matters when that incentive causes persistent failure across materially different arrangements",
    ],
  },
  {
    id: "failure-voluntary-provision",
    number: "08",
    title: "When Does Voluntary Provision Actually Fail?",
    answer: [
      "When materially different arrangements fail persistently because the same incentive structure prevents the function from being sustained",
      "One failed provider, underprovision, or a temporary absence is not enough",
    ],
  },
  {
    id: "schmidtz-public-goods-free-riders",
    number: "09",
    title: "What Does David Schmidtz Argue About Public Goods and Free Riders?",
    answer: [
      "In <em>The Limits of Government</em>, Schmidtz shows that public goods and free riders do not by themselves justify state authority and that some voluntary arrangements can work",
      "This theory adds a stricter requirement: persistent collapse of voluntary provision must be established before coercion can be considered",
    ],
  },
  {
    id: "market-failure-government-intervention",
    number: "10",
    title: "Do Market Failures Justify Government Intervention?",
    answer: [
      "No. Natural monopoly, imperfect information, concentration, coordination problems, or underprovision do not demonstrate coercive necessity",
      "Those categories describe certain market conditions; they do not prove that the State must assume the function",
    ],
  },
  {
    id: "positive-externalities-government-intervention",
    number: "11",
    title: "Do Positive Externalities Justify Government Intervention?",
    answer: [
      "No. The fact that an activity benefits third parties does not make it a state function",
      "That benefit does not establish non-excludability, non-rivalry, or persistent collapse of voluntary provision",
    ],
  },
  {
    id: "libertarianism-state-coercion",
    number: "12",
    title: "Is Libertarianism Compatible with State Coercion?",
    answer: [
      "Not as moral legitimacy. This theory is libertarian because liberty is the baseline and coercion is never intrinsically legitimate, whether exercised by the State or anyone else",
      "It nevertheless allows a narrowly bounded coercive function to be tolerated on grounds of necessity without becoming legitimate",
    ],
  },
  {
    id: "hayek-government-power",
    number: "13",
    title: "What Limits Government Power in Hayek's Political Theory?",
    answer: [
      "Hayek emphasizes the limits of knowledge, spontaneous order, general rules, and the rule of law",
      "The question here comes earlier: which functions may be placed under coercive authority at all",
    ],
  },
  {
    id: "buchanan-constitutional-political-economy",
    number: "14",
    title: "What Limits Government in Buchanan's Constitutional Political Economy?",
    answer: [
      "Buchanan examines the constitutional rules within which collective decisions are made and the role of agreement",
      "Here the function must pass a prior filter before its institutional design is considered",
    ],
  },
  {
    id: "rothbard-anarcho-capitalism-state-coercion",
    number: "15",
    title: "Does Rothbard's Anarcho-Capitalism Reject All State Coercion?",
    answer: [
      "Yes. Rothbard treats coercion as morally illegitimate whether it comes from the State or anyone else and rejects compulsory state provision",
      "This theory shares that philosophical rejection of legitimacy but allows a specific coercive function to be tolerated on grounds of necessity when it passes the criterion",
    ],
  },
  {
    id: "minarchism-minimal-state-functions",
    number: "16",
    title: "What Is Minarchism, and What Functions Does a Minimal State Perform?",
    answer: [
      "Minarchism usually begins with a fixed set of state functions such as defense, police, and courts",
      "This theory does not start from a predefined list. Every function must pass the same criterion",
    ],
  },
  {
    id: "nozick-minimal-state-legitimacy",
    number: "17",
    title: "Is Nozick's Minimal State Morally Legitimate?",
    answer: [
      "Yes, in Nozick's theory. In <em>Anarchy, State, and Utopia</em>, he defends a morally legitimate minimal state grounded in a theory of rights",
      "Here, state coercion never becomes morally legitimate. It can only be tolerated exceptionally on grounds of necessity",
    ],
  },
  {
    id: "state-self-limitation",
    number: "18",
    title: "Can the State Limit Itself?",
    answer: [
      "Only imperfectly. Whoever exercises power also participates in defining, interpreting, and changing its limits",
      "Constraint therefore cannot rest solely on the willingness of those who govern",
    ],
  },
  {
    id: "absence-voluntary-alternatives-state-necessary",
    number: "19",
    title: "Does the Absence of Voluntary Alternatives Prove the State Is Necessary?",
    answer: [
      "No. A legal monopoly or prolonged state provision can prevent alternative providers, capabilities, and institutions from emerging",
      "The absence of an alternative today does not demonstrate persistent collapse of voluntary provision",
    ],
  },
  {
    id: "necessary-function-scope-government-intervention",
    number: "20",
    title: "If a State Function Is Necessary, How Far May Government Intervention Go?",
    answer: [
      "Only as far as separately justified. Necessity of the function does not authorize any tax, agency, monopoly, mandate, budget, or form of enforcement",
      "Each coercive instrument faces a second burden of proof",
    ],
  },
];

const stripHtml = (value) =>
  value.replace(/<[^>]*>/g, "");

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((question) => ({
    "@type": "Question",
    name: question.title,
    acceptedAnswer: {
      "@type": "Answer",
      text: question.answer.map(stripHtml).join(" "),
    },
  })),
};
---
<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Limits of Government, State Coercion & Public Goods | Minimal Tolerance"
      description="Questions on government power, state coercion, public goods, free riders, market failure, libertarianism, Hayek, Buchanan, Rothbard, minarchism, and Nozick"
      lang="en"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    ></script>
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->

      <section class="hero questions-page-hero">
        <div class="hero-content hero-sequence">
          <p class="eyebrow">
            THE QUESTIONS
          </p>

          <h1>
            What should government<br />
            be allowed to do?
          </h1>
        </div>
      </section>

      <!-- CENTRAL STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          An exception is not a license for power
        </blockquote>
      </section>

      <!-- EXPLORE -->

      <section class="questions-index">
        <div class="questions-container">
          <p class="eyebrow reveal">
            EXPLORE
          </p>

          <p class="questions-intro reveal">
            Questions about what can justify coercion and where government power should end
          </p>

          <nav
            class="questions-index-grid stagger"
            aria-label="Questions about government, coercion, public goods, and political power"
          >
            {
              questions.map((question) => (
                <a
                  href={`#${question.id}`}
                  class="question-index-card reveal"
                >
                  <span class="question-index-number">
                    {question.number}
                  </span>

                  <span class="question-index-title">
                    {question.title}
                  </span>
                </a>
              ))
            }
          </nav>
        </div>
      </section>

      <!-- QUESTIONS -->

      <section class="questions-content">
        <div class="questions-container">
          {
            questions.map((question) => (
              <article
                id={question.id}
                class="question-section"
              >
                <div class="question-heading reveal reveal-left">
                  <span class="question-number">
                    {question.number}
                  </span>

                  <h2>
                    {question.title}
                  </h2>
                </div>

                <div class="question-copy reveal reveal-right">
                  {question.answer.map((paragraph) => (
                    <p set:html={paragraph}></p>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- FINAL CTA -->

      <section class="questions-cta">
        <div class="questions-container questions-cta-content">
          <div class="reveal reveal-left">
            <p class="eyebrow">
              THE THEORY OF MINIMAL TOLERANCE
            </p>

            <h2>
              The burden of proof belongs to power
            </h2>

            <p>
              Explore the criterion that determines when a function can
              pass the test of coercive necessity without turning
              tolerance into legitimacy
            </p>
          </div>

          <div class="questions-cta-buttons reveal reveal-right">
            <a href="/theory" class="primary">
              Explore the Theory
            </a>

            <a href="/theorem" class="secondary">
              Examine the Theorem
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /*
       * Force a true two-column grid here so each pair of questions
       * shares the exact same row height.
       */
      .questions-index-grid {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        grid-auto-flow: row !important;
        gap: 0 !important;
        align-items: stretch !important;
      }

      .question-index-card {
        box-sizing: border-box !important;
        display: grid !important;
        grid-template-columns: 3.1rem minmax(0, 1fr) !important;
        align-items: start !important;
        align-content: start !important;
        column-gap: 1rem !important;
        width: 100% !important;
        height: 100% !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 1rem 1.15rem 1rem 0 !important;
        transition:
          color 220ms ease,
          background 220ms ease,
          transform 220ms ease;
      }

      .question-index-card:nth-child(odd) {
        border-right: 1px solid var(--line, rgba(20, 30, 40, 0.14)) !important;
        padding-right: 1.4rem !important;
      }

      .question-index-card:nth-child(even) {
        padding-left: 2rem !important;
      }

      .question-index-number,
      .question-index-title {
        align-self: start !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .question-index-number {
        line-height: 1.28 !important;
        transition: transform 220ms ease;
      }

      .question-index-title {
        display: block !important;
        line-height: 1.28;
      }

      .questions-intro {
        max-width: 760px;
        margin: 0 0 1.25rem;
        font-size: 1rem;
        line-height: 1.55;
        opacity: 0.82;
      }

      /*
       * Keep the index type exactly at the approved size.
       */
      .question-index-title {
        font-size: clamp(0.95rem, 1vw, 1.08rem);
      }

      /*
       * Developed-question title: 10% smaller than the previous version.
       * Right-side answer size is untouched.
       */
      .question-heading h2 {
        font-size: clamp(1.08rem, 1.62vw, 1.62rem);
        line-height: 1.12;
      }

      .question-section {
        overflow: hidden;
      }

      @media (hover: hover) and (pointer: fine) {
        .question-index-card:hover {
          transform: translateY(-2px);
        }

        .question-index-card:hover .question-index-number {
          transform: translateX(5px);
        }
      }

      @media (max-width: 900px) {
        .questions-index-grid {
          grid-template-columns: 1fr !important;
        }

        .question-index-card,
        .question-index-card:nth-child(odd),
        .question-index-card:nth-child(even) {
          grid-template-columns: 2.75rem minmax(0, 1fr) !important;
          column-gap: 0.85rem !important;
          padding: 0.9rem 0 !important;
          border-right: 0 !important;
        }

        .questions-intro {
          margin-bottom: 1.1rem;
          font-size: 0.98rem;
        }

        .question-index-title {
          font-size: 0.95rem;
        }

        .question-heading h2 {
          font-size: clamp(0.99rem, 3.33vw, 1.26rem);
        }

        .question-heading.reveal-left,
        .question-copy.reveal-right {
          transform: translateY(24px);
        }

        .question-heading.reveal-left.is-visible,
        .question-copy.reveal-right.is-visible {
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .question-index-card,
        .question-index-number {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>

