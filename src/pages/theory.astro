---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

   <meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
/>

<SEO
  title="The Problem of Tolerance | Minimal Tolerance"
  description="The moral and economic foundations of the Theory of Minimal Tolerance"
  lang="en"
/>

<main>
  <!-- PAGE TITLE -->

  <section class="page-hero">
    <div class="container hero-sequence">
      <p class="eyebrow">
        THE THEORY
      </p>

      <h1>
        The problem of tolerance
      </h1>
    </div>
  </section>

  <!-- OPENING STATEMENT -->

<section class="statement">
    <blockquote class="reveal reveal-scale">
      The State does not become legitimate.
      At most, it may be tolerated
    </blockquote>
  </section>

  <!-- MORAL PROBLEM -->

  <section class="content-section">
    <div class="container theory-block">
      <p class="eyebrow reveal">
        THE MORAL PROBLEM
      </p>

      <h2 class="reveal">
        Political authority rests on coercion
      </h2>

      <p class="reveal">
        Every exercise of state power rests, ultimately, on the ability
        to compel. The individual cannot simply refuse taxes, regulations,
        prohibitions, or other binding rules. Such power may sometimes be
        tolerated, but coercion does not become consent merely because it
        is exercised by the State, nor does obedience transform it into
        moral legitimacy
      </p>
    </div>
  </section>

  <!-- EFFICIENCY PROBLEM -->

  <section class="content-section content-section-alt">
    <div class="container theory-block">
      <p class="eyebrow reveal">
        THE EFFICIENCY PROBLEM
      </p>

      <h2 class="reveal">
        Why centralized decisions fail
      </h2>

      <p class="reveal">
        Complex societies coordinate through knowledge dispersed among
        millions of people, prices that transmit changing conditions,
        entrepreneurial discovery, and competition that exposes error.
        No central authority can reproduce that process in full, because
        much of the information required to act is local, changing, or
        discovered only through experimentation. Centralized allocation
        therefore weakens adaptation, error correction, and the efficient
        use of scarce resources
      </p>
    </div>
  </section>

  <!-- MARKET FAILURE -->

  <section class="content-section">
    <div class="container theory-block">
      <p class="eyebrow reveal">
        MARKET FAILURE
      </p>

      <h2 class="reveal">
        A problem is not a license for coercion
      </h2>

      <p class="reveal">
        The existence of an imperfect outcome establishes only that a
        problem exists. It does not establish that state intervention will
        improve it, much less that coercion becomes morally tolerable.
        Markets must be compared with real political institutions, not
        with an idealized State immune to error, incentives, information
        limits, and unintended consequences
      </p>
    </div>
  </section>

  <!-- FREE-RIDER PROBLEM -->

  <section class="content-section content-section-alt">
    <div class="container theory-block">
      <p class="eyebrow reveal">
        THE FREE-RIDER PROBLEM
      </p>

      <h2 class="reveal">
        When voluntary provision breaks down
      </h2>

      <p class="reveal">
        A narrower case arises when exclusion is ineffective, use by one
        person does not meaningfully reduce what remains for others, and
        individuals can benefit without contributing. Yet free riding
        alone is not enough. Voluntary provision must collapse persistently,
        and even then coercion does not become legitimate: the collapse
        satisfies only one of the necessary conditions under which it may
        be considered morally tolerable
      </p>
    </div>
  </section>



  <!-- LINK TO THEOREM -->

  <section class="content-section">
    <div class="container theory-final">
      <p class="eyebrow reveal">
        THE THEOREM
      </p>

      <h2 class="reveal">
        Defining the boundary
      </h2>

      <div class="buttons reveal">
        <a href="/theorem/" class="primary">
          Read the Theorem
        </a>
      </div>
    </div>
  </section>
</main>

<Footer />

<style>
  .theory-block {
    position: relative;
  }

  .theory-block::before {
    position: absolute;
    top: 0;
    left: 5vw;
    width: 42px;
    height: 2px;
    background: var(--gold);
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition:
      opacity 500ms ease,
      transform 700ms ease;
  }

  .theory-block:has(.is-visible)::before {
    opacity: 1;
    transform: scaleX(1);
  }

  .theory-final {
    text-align: center;
  }

  .theory-final > h2 {
    margin-right: auto;
    margin-left: auto;
  }

  .theory-final .buttons {
    justify-content: center;
  }

  @media (max-width: 900px) {
    .theory-block::before {
      left: 5vw;
      width: 34px;
    }
  }

  @media (max-width: 560px) {
    .theory-block::before {
      left: 5vw;
      width: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theory-block::before {
      opacity: 1;
      transform: scaleX(1);
      transition: none;
    }
  }
</style>

<script is:inline>
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const revealElements =
    document.querySelectorAll(".reveal");

  if (reduceMotion || !("IntersectionObserver" in window)) {
    revealElements.forEach((element) => {
      element.classList.add("is-visible");
    });
  } else {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      {
        threshold: 0.14,
        rootMargin: "0px 0px -40px 0px",
      }
    );

    revealElements.forEach((element) => {
      revealObserver.observe(element);
    });
  }
</script>
    </script>
  </body>
</html>
