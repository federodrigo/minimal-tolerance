---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="The Problem of Tolerance | Minimal Tolerance"
      description="The moral, economic, and institutional foundations of the Theory of Minimal Tolerance"
      lang="en"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- PAGE TITLE -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            THE THEORY
          </p>

          <h1>
            The problem of tolerance
          </h1>
<p class="story-trail" aria-label="Reading path"><span class="story-step">Questions</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step is-current">Theory</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step">Theorem</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step">Cases</span></p>
        </div>
      </section>

      <!-- OPENING STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          Coercion may be tolerated, not legitimized
        </blockquote>
      </section>

      <!-- MORAL PROBLEM -->

      <section class="content-section">
        <div class="container theory-block">
          <p class="eyebrow reveal">
            THE MORAL PROBLEM
          </p>

          <h2 class="reveal">
            Political authority rests on coercion
          </h2>

          <p class="reveal">
            The State can impose taxes, rules, and prohibitions even on those who disagree. Holding political authority does not make that coercion morally legitimate
          </p>
        </div>
      </section>

      <!-- EFFICIENCY PROBLEM -->

      <section class="content-section content-section-alt">
        <div class="container theory-block manuscript-split"><div class="manuscript-copy">
          <p class="eyebrow reveal">
            THE EFFICIENCY PROBLEM
          </p>

          <h2 class="reveal">
            The limits of centralized decisions
          </h2>

          <p class="reveal">
            No central authority can gather all the knowledge needed to coordinate a complex society. Much of it is dispersed, changes constantly, and emerges through prices, competition, and experimentation. Centralizing decisions does not eliminate these limits
          </p>
        </div><figure class="manuscript-scene reveal reveal-right" role="img" aria-label="Central tower amid dispersed decisions"><span class="scene-picture scene-theory" aria-hidden="true"></span></figure></div>
      </section>

      <!-- PRESUMPTION OF LIBERTY -->

      <section class="content-section">
        <div class="container theory-block">
          <p class="eyebrow reveal">
            PRESUMPTION OF LIBERTY
          </p>

          <h2 class="reveal theory-proof-heading">
            The burden of proof belongs to power
          </h2>

          <p class="reveal">
            Finding a problem does not prove that government intervention is necessary. Those proposing coercion must show why voluntary alternatives cannot sustain the function
          </p>
        </div>
      </section>

      <!-- FREE-RIDER PROBLEM -->

      <section class="content-section content-section-alt">
        <div class="container theory-block">
          <p class="eyebrow reveal">
            THE FREE-RIDER PROBLEM
          </p>

          <h2 class="reveal">
            When voluntary provision fails
          </h2>

          <p class="reveal">
            When people can benefit without contributing, voluntary provision may become difficult. But that alone does not establish the need for coercion. The theorem requires three conditions together: ineffective exclusion, relevant non-rivalry, and persistent collapse of voluntary provision
          </p>
        </div>
      </section>

      <!-- COMPARISON OF APPROACHES -->

      <section class="content-section approaches-section" aria-labelledby="approaches-heading">
        <div class="container">
          <p class="eyebrow reveal">A CRITERION, NOT A LIST</p>
          <h2 class="reveal" id="approaches-heading">Three ways of thinking about government</h2>
          
          <div class="approaches-frame reveal reveal-scale">
            <table class="approaches-table" aria-labelledby="approaches-heading">
              <colgroup><col /><col /><col /><col /></colgroup>
              <thead>
              <tr>
                <th scope="col">Feature</th>
                <th scope="col">Anarcho-capitalism</th>
                <th scope="col">Minarchism</th>
                <th scope="col">Minimal Tolerance</th>
              </tr>
              </thead>
              <tbody>
              <tr>
                <th scope="row">The State</th>
                <td data-label="Anarcho-capitalism">Rejects the State’s coercive monopoly</td>
                <td data-label="Minarchism">Defends a limited State to protect rights</td>
                <td data-label="Minimal Tolerance">Does not presume moral legitimacy. Coercion may be tolerated only exceptionally</td>
              </tr>
              <tr>
                <th scope="row">Functions</th>
                <td data-label="Anarcho-capitalism">Defense, security, and justice may be organized voluntarily</td>
                <td data-label="Minarchism">Mainly defense, security, and justice</td>
                <td data-label="Minimal Tolerance">There is no fixed list. Each function must pass the criterion</td>
              </tr>
              <tr>
                <th scope="row">Justification</th>
                <td data-label="Anarcho-capitalism">No function justifies a coercive State monopoly</td>
                <td data-label="Minarchism">Protection of rights grounds the minimal State</td>
                <td data-label="Minimal Tolerance">Those proposing coercion must demonstrate necessity</td>
              </tr>
              <tr>
                <th scope="row">Production</th>
                <td data-label="Anarcho-capitalism">Provision belongs to voluntary institutions</td>
                <td data-label="Minarchism">The State may assume basic functions</td>
                <td data-label="Minimal Tolerance">State responsibility does not imply direct State production</td>
              </tr>
              <tr>
                <th scope="row">Permanence</th>
                <td data-label="Anarcho-capitalism">Rejects the State exception</td>
                <td data-label="Minarchism">Maintains a limited core of functions</td>
                <td data-label="Minimal Tolerance">Any exception must remain justified over time</td>
              </tr>
              </tbody>
            </table>
          </div>

                  </div>
      </section>

      <!-- LINK TO THEOREM -->

      <section class="content-section">
        <div class="container theory-final">
          <p class="eyebrow reveal" style="text-align: center;">
            THE THEOREM
          </p>

          <h2 class="reveal">
            Defining the boundary
          </h2>

          <div class="section-action section-action-centered reveal"><a href="/theorem/" class="story-link">Continue to the theorem <span aria-hidden="true">→</span></a></div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .theory-block {
        position: relative;
      }

      .theory-block::before {
        position: absolute;
        top: 0;
        left: 5vw;
        width: 42px;
        height: 2px;
        background: var(--gold);
        content: "";
        opacity: 0;
        transform: scaleX(0);
        transform-origin: left;
        transition:
          opacity 500ms ease,
          transform 700ms ease;
      }

      .theory-block:has(.is-visible)::before {
        opacity: 1;
        transform: scaleX(1);
      }

      .theory-final {
        text-align: center;
      }

      .theory-final > h2 {
        margin-right: auto;
        margin-left: auto;
      }

      .theory-final .buttons {
        justify-content: center;
      }

      @media (max-width: 900px) {
        .theory-block::before {
          left: 5vw;
          width: 34px;
        }
      }

      @media (max-width: 560px) {
        .theory-block::before {
          left: 5vw;
          width: 28px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .theory-block::before {
          opacity: 1;
          transform: scaleX(1);
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.14,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
