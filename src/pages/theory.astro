---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="The Problem of Tolerance | Minimal Tolerance"
      description="The moral and economic foundations of the Theory of Minimal Tolerance"
      lang="en"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- PAGE TITLE -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            THE THEORY
          </p>

          <h1>
            The problem of tolerance
          </h1>
        </div>
      </section>

      <!-- OPENING STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          The State does not become legitimate.
          At most, it may be tolerated
        </blockquote>
      </section>

      <!-- MORAL PROBLEM -->

      <section class="content-section">
        <div class="container theory-block">
          <p class="eyebrow reveal">
            THE MORAL PROBLEM
          </p>

          <h2 class="reveal">
            Political authority rests on coercion
          </h2>

          <p class="reveal">
            The State is routinely exempted from principles that govern
            every other human relationship. Consent is treated as
            essential in private interactions but becomes secondary
            once political authority enters the picture
          </p>

          <p class="reveal">
            Unlike private relationships, the relationship between the
            individual and the State is neither voluntary nor optional.
            The ability to impose a decision does not establish a moral
            right to impose it. Compliance and legitimacy are not the
            same thing
          </p>
        </div>
      </section>

      <!-- EFFICIENCY PROBLEM -->

      <section class="content-section content-section-alt">
        <div class="container theory-block">
          <p class="eyebrow reveal">
            THE EFFICIENCY PROBLEM
          </p>

          <h2 class="reveal">
            Why centralized decisions fail
          </h2>

          <p class="reveal">
            Complex societies depend on dispersed knowledge, market
            prices, entrepreneurial discovery, and competitive
            feedback. No central authority can fully replicate the
            processes through which decentralized decisions coordinate
            human activity
          </p>

          <p class="reveal">
            The result is not merely less information, but weaker
            adaptation, slower error correction, and less efficient
            allocation of scarce resources
          </p>
        </div>
      </section>

      <!-- MARKET FAILURE -->

      <section class="content-section">
        <div class="container theory-block">
          <p class="eyebrow reveal">
            MARKET FAILURE
          </p>

          <h2 class="reveal">
            The existence of a problem does not establish the case for
            coercion
          </h2>

          <p class="reveal">
            Imperfect outcomes are often treated as automatic
            justification for state action. The diagnosis quickly
            becomes a prescription, as though identifying a difficulty
            were enough to validate the proposed remedy
          </p>

          <p class="reveal">
            Markets are judged against reality, while governments are
            judged against aspiration. Political decision-making does
            not eliminate the underlying problems. It merely changes
            their form
          </p>
        </div>
      </section>

      <!-- STRUCTURAL FREE RIDER -->

      <section class="content-section content-section-alt">
        <div class="container theory-block">
          <p class="eyebrow reveal">
            NOT A MARKET FAILURE
          </p>

          <h2 class="reveal">
            A structural free-rider problem
          </h2>

          <p class="reveal">
            The phenomenon addressed here is not a market failure in
            the classical sense. It is a structural free-rider problem:
            when exclusion is difficult or impossible, individuals may
            benefit regardless of whether they contribute, weakening
            the incentives for voluntary provision
          </p>

          <p class="reveal">
            The relevant case is narrower than the standard
            market-failure argument. It concerns situations in which
            voluntary provision collapses persistently because of the
            incentive structure itself. The objection is not moral,
            but operational
          </p>
        </div>
      </section>

      <!-- LINK TO THEOREM -->

      <section class="content-section">
        <div class="container theory-final">
          <p class="eyebrow reveal">
            THE THEOREM
          </p>

          <h2 class="reveal">
            Defining the boundary
          </h2>

          <div class="buttons reveal">
            <a href="/theorem/" class="primary">
              Read the Theorem
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .theory-block {
        position: relative;
      }

      .theory-block::before {
        position: absolute;
        top: 0;
        left: 5vw;
        width: 42px;
        height: 2px;
        background: var(--gold);
        content: "";
        opacity: 0;
        transform: scaleX(0);
        transform-origin: left;
        transition:
          opacity 500ms ease,
          transform 700ms ease;
      }

      .theory-block:has(.is-visible)::before {
        opacity: 1;
        transform: scaleX(1);
      }

      .theory-final {
        text-align: center;
      }

      .theory-final > h2 {
        margin-right: auto;
        margin-left: auto;
      }

      .theory-final .buttons {
        justify-content: center;
      }

      @media (max-width: 900px) {
        .theory-block::before {
          left: 5vw;
          width: 34px;
        }
      }

      @media (max-width: 560px) {
        .theory-block::before {
          left: 5vw;
          width: 28px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .theory-block::before {
          opacity: 1;
          transform: scaleX(1);
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.14,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
