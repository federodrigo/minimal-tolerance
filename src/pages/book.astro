---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";

const ssrnUrl =
  "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5984574";
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="A Theory of Minimal Tolerance | Minimal Tolerance"
      description="A Theory of Minimal Tolerance by Federico Rodrigo examines coercion, political authority, voluntary cooperation, and the limits of state power."
      lang="en"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- PAGE TITLE -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            THE BOOK
          </p>

          <h1>
            A Theory of Minimal Tolerance
          </h1>
        </div>
      </section>

      <!-- CENTRAL STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          Coercion may be tolerated, not legitimized
        </blockquote>
      </section>

      <!-- BOOK -->

      <section class="book book-page-section">
        <div class="container">
          <div class="book-grid">
            <div class="book-cover-wrapper reveal reveal-left">
              <img
                src="/images/book-cover.png"
                alt="Cover of A Theory of Minimal Tolerance by Federico Rodrigo"
              />
            </div>

            <div class="book-copy reveal reveal-right">
              <p class="eyebrow">
                ABOUT THE BOOK
              </p>

              <h2>
                A Theory of Minimal Tolerance
              </h2>

              <p>
                This book develops the moral, economic, and
                institutional foundations of the Theory of Minimal
                Tolerance. It defines the conditions a function must
                satisfy to pass the test of coercive necessity, without
                treating that result as authorization for any particular
                coercive arrangement
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- PAPER -->

      <section class="ssrn">
        <div class="container">
          <p class="eyebrow reveal">
            FOUNDATIONAL PAPER
          </p>

          <h2 class="reveal">
            Read the SSRN paper
          </h2>

          <p class="reveal">
            The original paper introduces the Minimal Tolerance
            Theorem and the idea of the State as an institutional
            technology of last resort
          </p>

          <a
            href={ssrnUrl}
            class="primary reveal"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open on SSRN
          </a>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .book-page-section .book-grid {
        align-items: center;
      }

      .book-cover-wrapper {
        perspective: 1000px;
      }

      .book-cover-wrapper img {
        transform-origin: center;
        transition:
          transform 320ms ease,
          box-shadow 320ms ease;
      }

      .book-copy p:not(.eyebrow) {
        max-width: 760px;
      }

      @media (hover: hover) and (pointer: fine) {
        .book-cover-wrapper img:hover {
          transform: translateY(-7px) rotateY(-2deg) rotateZ(-0.5deg);
          box-shadow: 0 30px 76px rgba(13, 27, 42, 0.22);
        }
      }

      @media (max-width: 900px) {
        .book-cover-wrapper {
          max-width: 320px;
        }
      }

      @media (max-width: 560px) {
        .book-cover-wrapper {
          max-width: 270px;
          margin: 0 auto;
        }

        .book-copy {
          text-align: left;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .book-cover-wrapper img {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.14,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
