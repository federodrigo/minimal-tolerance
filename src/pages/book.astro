---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";

const coreConcepts = [
  {
    id: "minimal-tolerance-theorem",
    name: "Minimal Tolerance Theorem",
    description:
      "A function can be considered for a coercive exception only when effective non-excludability, relevant non-rivalry, and persistent collapse of voluntary provision are all established. Passing the test does not authorize a particular intervention",
  },
  {
    id: "presumption-of-liberty",
    name: "Presumption of Liberty",
    description:
      "Voluntary cooperation is the default. Those seeking to restrict it must justify the exception; individuals need not justify their freedom",
  },
  {
    id: "burden-of-proof-reversal",
    name: "Reversal of the Burden of Proof",
    description:
      "A social problem alone does not justify state intervention. Those proposing coercion must show that their response improves on available alternatives",
  },
  {
    id: "voluntary-provision",
    name: "Voluntary Provision",
    description:
      "Stable ways to sustain a function without coercion, including markets, contracts, cooperatives, mutual arrangements, charities, associations, and community organizations",
  },
  {
    id: "persistent-collapse",
    name: "Persistent Collapse of Voluntary Provision",
    description:
      "Free riding or the absence of a current solution is not proof of failure. Voluntary provision must persistently fail after genuine alternatives have had a chance to develop",
  },
  {
    id: "institutional-last-resort",
    name: "Institutional Technology of Last Resort",
    description:
      "The State enters consideration only as a last resort. If voluntary institutions or new technologies later sustain the function, the grounds for the exception disappear",
  },
];

const secondFilterConcepts = [
  {
    id: "second-burden-of-proof",
    name: "Second Burden of Proof",
    description:
      "Responsibility for guaranteeing a function does not require the State to produce it directly. Direct state production faces a second burden of proof",
  },
  {
    id: "principle-of-separability",
    name: "Principle of Separability",
    description:
      "Guaranteeing a function and producing it are different decisions. Execution can occur outside government while state responsibility and the guarantee remain intact",
  },
  {
    id: "authority-verifiability-substitutability",
    name: "Authority, Verifiability, and Substitutability",
    description:
      "The test is sequential: inseparable sovereign authority creates a presumption of state execution. Beyond that core, external producers take priority when performance can be verified and the producer replaced without jeopardizing the function",
  },
  {
    id: "perimeter-and-depth",
    name: "Perimeter and Depth",
    description:
      "The first filter limits which functions may become state responsibilities. The second limits how much of their production must remain inside the State",
  },
];

const institutionalConcepts = [
  {
    id: "state-free-riding",
    name: "State Free Riding",
    description:
      "A productive society may absorb an additional state burden and keep functioning. That adaptation makes the burden part of the inherited baseline and can make further burdens appear feasible. It facilitates expansion without making it inevitable",
  },
  {
    id: "paradox-of-resilience",
    name: "Paradox of Resilience",
    description:
      "The more resilient a society, the more burdens it may absorb before visible distress appears. Its strength can therefore make further demands seem sustainable",
  },
  {
    id: "institutional-bootstrap",
    name: "Institutional Bootstrap",
    description:
      "Voluntary alternatives need time, experience, and resources to develop. If prolonged state control prevents them from maturing, their absence is not proof that they could never work",
  },
  {
    id: "institutional-ratchet",
    name: "Institutional Ratchet",
    description:
      "An exceptional power creates interests, procedures, and structures that make reversal increasingly costly. Temporary measures can outlive the circumstances that originally justified them",
  },
  {
    id: "state-self-limitation",
    name: "The State Cannot Reliably Self-Limit",
    description:
      "The institutions that create, interpret, and enforce limits on state power are part of the power being restrained. Written rules alone cannot guarantee durable restraint",
  },
  {
    id: "law-of-benevolent-disguise",
    name: "Law of Benevolent Disguise",
    description:
      "Coercion often presents itself as help: taxes as solidarity, restrictions as protection, surveillance as security. Promised benefits can obscure the coercive means",
  },
  {
    id: "paradox-of-tutelage",
    name: "Paradox of Tutelage",
    description:
      "Intervention can weaken the voluntary capacities whose absence later becomes its justification. Dependence may be partly created by the institution meant to relieve it",
  },
  {
    id: "paradox-of-institutional-strength",
    name: "Paradox of Institutional Strength",
    description:
      "A constitution cannot enforce itself. Its limits endure only while those capable of violating them choose not to. Long obedience can hide how much institutions depend on human restraint",
  },
];

const allConcepts = [
  ...coreConcepts,
  ...secondFilterConcepts,
  ...institutionalConcepts,
];

const pageUrl = new URL(
  Astro.url.pathname,
  "https://minimaltolerance.com"
).href;

const bookPdfUrl = "https://minimaltolerance.com/books/a-theory-of-minimal-tolerance.pdf";

const bookSchema = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: "A Theory of Minimal Tolerance",
  author: {
    "@type": "Person",
    name: "Fede Rodrigo",
  },
  url: pageUrl,
  inLanguage: "en",
  isAccessibleForFree: true,
  encoding: {
    "@type": "MediaObject",
    contentUrl: bookPdfUrl,
    encodingFormat: "application/pdf",
    inLanguage: "en",
  },
  description:
    "A theory of coercion, political authority, voluntary provision, institutional limits, state production, State Free Riding, and the conditions under which political power may be tolerated as an exception",
  about: allConcepts.map((concept) => concept.name),
};

const conceptSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  name: "Key Concepts in A Theory of Minimal Tolerance",
  url: `${pageUrl}#key-concepts`,
  hasDefinedTerm: allConcepts.map((concept) => ({
    "@type": "DefinedTerm",
    name: concept.name,
    description: concept.description,
    url: `${pageUrl}#${concept.id}`,
  })),
};
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="A Theory of Minimal Tolerance | Minimal Tolerance"
      description="A Theory of Minimal Tolerance by Fede Rodrigo develops the Minimal Tolerance Theorem as a criterion for coercive exceptions, together with persistent collapse of voluntary provision, the Principle of Separability, State Free Riding, and institutional limits on political power"
      lang="en"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(bookSchema)}
    ></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(conceptSchema)}
    ></script>
  </head>

  <body>
    <Header />

    <main>
      <!-- PAGE TITLE -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            THE BOOK
          </p>

          <h1>
            A Theory of<br />
            Minimal Tolerance
          </h1>
        </div>
      </section>

      <!-- CENTRAL STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          Tolerance is not a license for power
        </blockquote>
      </section>

      <!-- BOOK -->

      <section class="book book-page-section">
        <div class="container">
          <div class="book-grid">
            <div class="book-cover-wrapper reveal reveal-left">
              <img
                src="/images/book-cover.jpg"
                alt="Cover of A Theory of Minimal Tolerance by Fede Rodrigo"
              />
            </div>

            <div class="book-copy reveal reveal-right">
              <p class="eyebrow">
                FEATURED BOOK
              </p>

              <h2>
                A Theory of<br />Minimal Tolerance
              </h2>

              <p>
                The book asks when coercive state power may be tolerated without treating it as morally legitimate
              </p>

              <p>
                It moves from the moral and economic limits of government to the Minimal Tolerance Theorem, a separate test for direct state production, and the institutional forces that can expand and sustain political power
              </p>

              <div class="book-access">
                <a
                  href="https://www.amazon.com/dp/B0HMM92K5R"
                  class="book-action"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Buy on Amazon
                </a>
                <a
                  href="/books/a-theory-of-minimal-tolerance.pdf"
                  class="book-action"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Read Free (PDF)
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ABSTRACT -->

      <section class="book-abstract">
        <div class="container abstract-inner">
          <p class="eyebrow reveal">
            ABSTRACT
          </p>

          <h2 class="reveal book-question-heading">
            <span class="book-question-line">When may</span>
            <span class="book-question-line">coercion be <span style="color: var(--gold)">tolerated?</span></span>
          </h2>

          <div class="abstract-copy reveal">
            <p>
              <em>A Theory of Minimal Tolerance</em> asks when political coercion may be tolerated without treating it as morally legitimate. Voluntary cooperation remains the rule; coercion is an exception that must be justified
            </p>

            <p>
              The Presumption of Liberty places the burden of proof on those proposing coercion. The Minimal Tolerance Theorem requires three conditions together: effective non-excludability, relevant non-rivalry, and persistent collapse of voluntary provision. Even when these hold, no particular intervention is automatically authorized
            </p>

            <p>
              A second test separates state responsibility from direct state production. The book then examines how productive resilience can accommodate growing burdens, why the State cannot reliably limit itself, and how intervention may weaken voluntary alternatives. It also considers what an institutionally constrained order would require
            </p>
          </div>
        </div>
      </section>

      <!-- COMPARISON OF APPROACHES -->

      <section class="content-section approaches-section" aria-labelledby="approaches-heading">
        <div class="container">
          <p class="eyebrow reveal">A CRITERION, NOT A LIST</p>
          <h2 class="reveal" id="approaches-heading">Three ways of thinking about government</h2>
          
          <div class="approaches-frame reveal reveal-scale">
            <table class="approaches-table" aria-labelledby="approaches-heading">
              <colgroup><col /><col /><col /><col /></colgroup>
              <thead>
              <tr>
                <th scope="col">State</th>
                <th scope="col">Anarcho-capitalism</th>
                <th scope="col">Minarchism</th>
                <th scope="col">Minimal Tolerance</th>
              </tr>
              </thead>
              <tbody>
              <tr>
                <th scope="row">Coercion</th>
                <td data-label="Anarcho-capitalism">Morally illegitimate</td>
                <td data-label="Minarchism">Justified to protect rights</td>
                <td data-label="Minimal Tolerance">Not legitimized; only tolerated</td>
              </tr>
              <tr>
                <th scope="row">Existence</th>
                <td data-label="Anarcho-capitalism">Rejects it</td>
                <td data-label="Minarchism">Minimal State</td>
                <td data-label="Minimal Tolerance">Institution of last resort</td>
              </tr>
              <tr>
                <th scope="row">Functions</th>
                <td data-label="Anarcho-capitalism">None; all voluntary</td>
                <td data-label="Minarchism">Defense, security, and justice</td>
                <td data-label="Minimal Tolerance">Each function must meet NE, NR, and CV</td>
              </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- KEY CONCEPTS -->

      <section
        class="concepts"
        id="key-concepts"
      >
        <div class="container">
          <div class="section-intro manuscript-split book-intro-split"><div class="manuscript-copy">
            <p class="eyebrow reveal">
              KEY CONCEPTS
            </p>

            <h2 class="reveal">
              The conceptual architecture
            </h2>

            <p class="section-lead reveal">
              The book follows three questions: which functions may enter state responsibility, when direct state production can be justified, and what happens once political power exists
            </p>
          </div><figure class="manuscript-scene reveal reveal-right" role="img" aria-label="Institutional structure amid ruins"><span class="scene-picture scene-book" aria-hidden="true"></span></figure></div>

          <!-- FIRST FILTER -->

          <div class="concept-group">
            <div class="concept-group-heading reveal">
              <span class="concept-number">01</span>

              <div>
                <p class="concept-kicker">
                  THE FIRST FILTER
                </p>

                <h3>
                  When may a function enter the State?
                </h3>
              </div>
            </div>

            <div class="concept-grid">
              {
                coreConcepts.map((concept) => (
                  <article
                    class="concept-card reveal"
                    id={concept.id}
                  >
                    <h4>
                      {concept.name}
                    </h4>

                    <p>
                      {concept.description}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>

          <!-- SECOND FILTER -->

          <div class="concept-group">
            <div class="concept-group-heading reveal">
              <span class="concept-number">02</span>

              <div>
                <p class="concept-kicker">
                  THE SECOND FILTER
                </p>

                <h3>
                  How much State is required?
                </h3>
              </div>
            </div>

            <div class="concept-grid">
              {
                secondFilterConcepts.map((concept) => (
                  <article
                    class="concept-card reveal"
                    id={concept.id}
                  >
                    <h4>
                      {concept.name}
                    </h4>

                    <p>
                      {concept.description}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>

          <!-- CONSEQUENCES -->

          <div class="concept-group">
            <div class="concept-group-heading reveal">
              <span class="concept-number">03</span>

              <div>
                <p class="concept-kicker">
                  THE CONSEQUENCES
                </p>

                <h3>
                  What happens once power exists?
                </h3>
              </div>
            </div>

            <div class="concept-grid">
              {
                institutionalConcepts.map((concept) => (
                  <article
                    class="concept-card reveal"
                    id={concept.id}
                  >
                    <h4>
                      {concept.name}
                    </h4>

                    <p>
                      {concept.description}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- CENTRAL PRINCIPLE -->

      <section class="book-principle">
        <div class="container">
          <p class="eyebrow reveal">
            THE STANDARD
          </p>

          <blockquote class="reveal reveal-scale book-standard-singleline">
            <strong>The burden of proof belongs to power</strong>
          </blockquote>

          <p class="reveal">
            First when power seeks to enter. Again when it seeks to produce
          </p>
        </div>
      </section>

      <!-- PAPERS -->

      <section class="ssrn">
        <div class="container">
          <p class="eyebrow reveal">
            THE PAPERS
          </p>

          <h2 class="reveal book-research-singleline">
            Research behind the theory
          </h2>

          <p class="reveal">
            Explore the research papers behind the book’s criteria, arguments, and institutional implications
          </p>

          <a
            href="/papers"
            class="primary reveal"
          >
            Explore the Papers
          </a>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /* Compact, matching book actions using the site's light and gold palette. */
      .book-access {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 218px));
        gap: 12px;
        width: fit-content;
        max-width: 100%;
        margin-top: 28px;
      }

      .book-access .book-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 56px;
        padding: 11px 16px;
        border: 1px solid rgba(169, 131, 58, 0.55);
        border-radius: 999px;
        background: var(--cream);
        color: var(--gold);
        font-family: inherit;
        font-size: 1.12rem;
        font-weight: 700;
        line-height: 1.3;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        appearance: none;
        transition:
          background-color 260ms var(--motion-ease),
          border-color 260ms var(--motion-ease),
          box-shadow 260ms var(--motion-ease),
          transform 260ms var(--motion-ease);
      }

      .book-access .book-action:hover,
      .book-access .book-action:focus-visible {
        background: var(--paper-light);
        border-color: var(--gold);
        box-shadow: 0 8px 18px rgba(13, 27, 42, 0.09);
        transform: translateY(-2px);
      }

      .book-access .book-action:focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: 3px;
      }

      .book-access .book-action[aria-disabled="true"] {
        cursor: not-allowed;
      }

      @media (max-width: 620px) {
        .book-access {
          grid-template-columns: minmax(0, 218px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .book-access .book-action {
          transition: none;
        }

        .book-access .book-action:hover,
        .book-access .book-action:focus-visible {
          transform: none;
        }
      }

      /* Anchor the cover to the text heading, independent of copy length. */
      .book-page-section .book-grid {
        align-items: start;
      }

      @media (min-width: 901px) {
        .book-page-section .book-cover-wrapper {
          margin-top: 14px;
        }
      }

      .book-cover-wrapper {
        perspective: 1000px;
      }

      .book-cover-wrapper img {
        transform-origin: center;
        transition:
          transform 320ms ease,
          box-shadow 320ms ease;
      }

      .book-copy p:not(.eyebrow) {
        max-width: 720px;
      }

      .book-copy p + p {
        margin-top: 0.9rem;
      }

      /* ABSTRACT */

      .book-abstract {
        padding: 3rem 0 3.5rem;
      }

      .abstract-inner {
        max-width: 980px;
      }

      .abstract-inner h2 {
        max-width: 760px;
        margin-bottom: 1.25rem;
      }

      .abstract-copy {
        max-width: 900px;
        font-size: 1.03rem;
        line-height: 1.65;
      }

      .abstract-copy p {
        margin: 0;
      }

      .abstract-copy p + p {
        margin-top: 0.9rem;
      }

      /* KEY CONCEPTS */

      .concepts {
        padding: 3.5rem 0 4rem;
      }

      .section-intro {
        max-width: 850px;
        margin-bottom: 2.4rem;
      }

      .section-intro h2 {
        margin-bottom: 0;
      }

      .section-lead {
        max-width: 760px;
        margin-top: 0.8rem;
        font-size: 1.03rem;
        line-height: 1.6;
      }

      .concept-group + .concept-group {
        margin-top: 3rem;
      }

      .concept-group-heading {
        display: grid;
        grid-template-columns: 96px 1fr;
        gap: 1.1rem;
        align-items: start;
        margin-bottom: 1.2rem;
      }

      .concept-number {
        display: block;
        margin-top: -0.05rem;
        color: var(--gold, #b49355);
        font-size: clamp(3rem, 5vw, 4.6rem);
        font-weight: 800;
        line-height: 0.82;
        letter-spacing: -0.065em;
      }

      .concept-kicker {
        margin: 0 0 0.18rem;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.14em;
      }

      .concept-group-heading h3 {
        margin: 0;
        font-size: clamp(1.45rem, 2.3vw, 2rem);
        line-height: 1.15;
      }

      .concept-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid rgba(13, 27, 42, 0.16);
      }

      .concept-card {
        padding: 1.35rem 1.65rem 1.45rem 0;
        border-bottom: 1px solid rgba(13, 27, 42, 0.16);
        scroll-margin-top: 100px;
      }

      .concept-card:nth-child(even) {
        padding-left: 1.65rem;
        border-left: 1px solid rgba(13, 27, 42, 0.16);
      }

      .concept-card h4 {
        margin: 0 0 0.5rem;
        font-size: clamp(1.1rem, 1.5vw, 1.32rem);
        line-height: 1.2;
      }

      .concept-card p {
        margin: 0;
        max-width: 620px;
        font-size: 0.96rem;
        line-height: 1.55;
      }

      /* CENTRAL PRINCIPLE */

      .book-principle {
        padding: 3.2rem 0 3.5rem;
        text-align: center;
      }

      .book-principle blockquote {
        max-width: 950px;
        margin: 0.7rem auto;
        font-size: clamp(2rem, 4vw, 3.6rem);
        line-height: 1.05;
        letter-spacing: -0.03em;
      }

      .book-principle > .container > p:last-child {
        max-width: 620px;
        margin: 0.85rem auto 0;
        font-size: 0.98rem;
        opacity: 0.72;
      }

      @media (hover: hover) and (pointer: fine) {
        .book-cover-wrapper img:hover {
          transform: translateY(-7px) rotateY(-2deg) rotateZ(-0.5deg);
          box-shadow: 0 30px 76px rgba(13, 27, 42, 0.22);
        }
      }

      @media (max-width: 900px) {
        .book-cover-wrapper {
          max-width: 320px;
        }

        .concept-grid {
          grid-template-columns: 1fr;
        }

        .concept-card,
        .concept-card:nth-child(even) {
          padding: 1.25rem 0;
          border-left: 0;
        }
      }

      @media (max-width: 560px) {
        .book-cover-wrapper {
          max-width: 270px;
          margin: 0 auto;
        }

        .book-copy {
          text-align: left;
        }

        .book-abstract {
          padding: 2.6rem 0 3rem;
        }

        .concepts {
          padding: 3rem 0 3.5rem;
        }

        .concept-group + .concept-group {
          margin-top: 2.6rem;
        }

        .concept-group-heading {
          grid-template-columns: 64px 1fr;
          gap: 0.75rem;
        }

        .concept-number {
          font-size: 2.9rem;
        }

        .concept-card {
          padding: 1.15rem 0 1.25rem;
        }

        .book-principle {
          padding: 2.8rem 0 3rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .book-cover-wrapper img {
          transition: none;
        }
      }
    
      /* Three selected titles fit on one line at desktop widths only */
      @media (min-width: 861px) {
        .book-principle blockquote.book-standard-singleline {
          max-width: none;
          font-size: clamp(1.8rem, 3.1vw, 2.65rem);
          white-space: nowrap;
          letter-spacing: -0.037em;
        }
        .ssrn h2.book-research-singleline {
          max-width: none;
          font-size: clamp(1.8rem, 3.1vw, 2.65rem);
          white-space: nowrap;
          letter-spacing: -0.035em;
        }
      }

    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (
        reduceMotion ||
        !("IntersectionObserver" in window)
      ) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver =
          new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;

                entry.target.classList.add(
                  "is-visible"
                );

                observer.unobserve(entry.target);
              });
            },
            {
              threshold: 0.14,
              rootMargin:
                "0px 0px -40px 0px",
            }
          );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
