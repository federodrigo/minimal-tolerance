---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";

const coreConcepts = [
  {
    id: "minimal-tolerance-theorem",
    name: "Minimal Tolerance Theorem",
    description:
      "A criterion for determining when a function may enter consideration as a coercive exception. Three necessary conditions must be jointly satisfied: effective non-excludability, relevant non-rivalry, and persistent collapse of voluntary provision. Passing the criterion does not automatically justify any particular coercive intervention",
  },
  {
    id: "presumption-of-liberty",
    name: "Presumption of Liberty",
    description:
      "Voluntary cooperation is the default and coercion is the exception. Individuals do not bear the burden of explaining why they should remain free; the burden belongs to whoever proposes restricting that freedom",
  },
  {
    id: "burden-of-proof-reversal",
    name: "Reversal of the Burden of Proof",
    description:
      "The existence of a social problem does not establish the superiority of state intervention. Whoever proposes coercion must show why the proposed response improves upon the available alternatives",
  },
  {
    id: "voluntary-provision",
    name: "Voluntary Provision",
    description:
      "The stable ways in which people can sustain a function without coercion. It includes markets and contracts, but also cooperatives, mutual arrangements, charities, associations, community organizations, and other forms of voluntary coordination",
  },
  {
    id: "persistent-collapse",
    name: "Persistent Collapse of Voluntary Provision",
    description:
      "Free riding or the present absence of a voluntary solution is not enough. The relevant question is whether voluntary provision persistently fails to sustain the function after genuine alternatives have had the opportunity to develop",
  },
  {
    id: "institutional-last-resort",
    name: "Institutional Technology of Last Resort",
    description:
      "The State is not the starting point of institutional design. It enters consideration only after the conditions for a coercive exception have been established. If voluntary institutions or technological change later sustain the function, the basis for the exception disappears",
  },
];

const secondFilterConcepts = [
  {
    id: "second-burden-of-proof",
    name: "Second Burden of Proof",
    description:
      "Passing the first test determines whether the State may become responsible for guaranteeing a function. It does not establish that the State must directly produce every activity required to perform it. Direct state production therefore faces a second burden of proof",
  },
  {
    id: "principle-of-separability",
    name: "Principle of Separability",
    description:
      "State responsibility and state production are separate decisions. A function may remain fully under state responsibility while parts of its execution are performed outside the public administration, provided the guarantee over the function remains intact",
  },
  {
    id: "authority-verifiability-substitutability",
    name: "Authority, Verifiability, and Substitutability",
    description:
      "The second filter is sequential. Inseparable sovereign authority creates a presumption of state execution. Outside that core, external execution gains priority when performance can be sufficiently verified and the producer can be replaced without compromising the function",
  },
  {
    id: "perimeter-and-depth",
    name: "Perimeter and Depth",
    description:
      "The first filter limits the perimeter of the State by asking which functions may fall under its responsibility. The second limits its depth by asking how much of the productive chain must actually remain inside the State",
  },
];

const institutionalConcepts = [
  {
    id: "state-free-riding",
    name: "State Free Riding",
    description:
      "A process in which a productive society absorbs an additional state burden and continues operating. That continuity reveals adaptive capacity, while the absorbed burden becomes part of the inherited baseline. Both can make a subsequent burden appear more feasible. The process describes facilitation, not causal necessity",
  },
  {
    id: "paradox-of-resilience",
    name: "Paradox of Resilience",
    description:
      "The stronger and more adaptable a productive society is, the more state burdens it may absorb before producing a visible signal of distress. The same resilience that protects society from immediate breakdown can expand the perceived room for further demands",
  },
  {
    id: "institutional-bootstrap",
    name: "Institutional Bootstrap",
    description:
      "Institutional alternatives require time, experience, capital, and repeated use to develop. When the State occupies a function for long periods and prevents alternatives from maturing, their later absence cannot be treated as evidence that voluntary provision was inherently incapable of sustaining the function",
  },
  {
    id: "state-self-limitation",
    name: "The State Cannot Reliably Self-Limit",
    description:
      "A formal limit on state power does not guarantee that the limit will hold. The institutions that create, interpret, administer, and enforce those boundaries remain part of the same structure they are meant to restrain. Durable limits therefore depend on more than rules written by the power they constrain",
  },
  {
    id: "law-of-benevolent-disguise",
    name: "Law of Benevolent Disguise",
    description:
      "Politically acceptable coercion tends to present itself as assistance. Taxes become solidarity, restrictions become protection, surveillance becomes security, and expanded authority is described through the benefits it promises rather than through the coercive means it requires",
  },
  {
    id: "paradox-of-tutelage",
    name: "Paradox of Tutelage",
    description:
      "Intervention can weaken precisely the social capacities whose absence is later invoked to justify its continuation. When people have fewer opportunities to organize, cooperate, solve problems, and bear responsibility, dependence can become partly a product of the institution created to relieve it",
  },
  {
    id: "right-to-be-wrong",
    name: "The Right to Be Wrong",
    description:
      "Treating individuals as adults requires preserving their authority over their own lives, including the possibility of making bad decisions. Freedom is not limited to choices considered wise by an authority; learning, responsibility, and adaptation depend partly on allowing decisions and their consequences to remain connected",
  },
  {
    id: "tolerable-order",
    name: "Tolerable Order",
    description:
      "Coercion is limited to the functions that satisfy the Minimal Tolerance criterion. Beyond that boundary, decisions remain dispersed among individuals, associations, communities, and voluntary institutions, reducing the scale and persistence of errors backed by political power",
  },
  {
    id: "paradox-of-institutional-strength",
    name: "Paradox of Institutional Strength",
    description:
      "Institutional limits often appear strongest when they are not being tested. A constitution has no physical force of its own: its authority ultimately depends on people who possess the capacity to violate it choosing not to do so. Prolonged obedience can make an institution appear self-enforcing, concealing the human compliance on which its survival depends",
  },
];

const allConcepts = [
  ...coreConcepts,
  ...secondFilterConcepts,
  ...institutionalConcepts,
];

const pageUrl = new URL(
  Astro.url.pathname,
  "https://minimaltolerance.com"
).href;

const bookSchema = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: "A Theory of Minimal Tolerance",
  author: {
    "@type": "Person",
    name: "Fede Rodrigo",
  },
  url: pageUrl,
  inLanguage: "en",
  description:
    "A theory of coercion, political authority, voluntary provision, institutional limits, state production, State Free Riding, and the conditions under which political power may be tolerated as an exception",
  about: allConcepts.map((concept) => concept.name),
};

const conceptSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  name: "Key Concepts in A Theory of Minimal Tolerance",
  url: `${pageUrl}#key-concepts`,
  hasDefinedTerm: allConcepts.map((concept) => ({
    "@type": "DefinedTerm",
    name: concept.name,
    description: concept.description,
    url: `${pageUrl}#${concept.id}`,
  })),
};
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="A Theory of Minimal Tolerance | Minimal Tolerance"
      description="A Theory of Minimal Tolerance by Fede Rodrigo develops the Minimal Tolerance Theorem as a criterion for coercive exceptions, together with persistent collapse of voluntary provision, the Principle of Separability, State Free Riding, and institutional limits on political power"
      lang="en"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(bookSchema)}
    ></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(conceptSchema)}
    ></script>
  </head>

  <body>
    <Header />

    <main>
      <!-- PAGE TITLE -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            THE BOOK
          </p>

          <h1>
            A Theory of Minimal Tolerance
          </h1>
        </div>
      </section>

      <!-- CENTRAL STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          Tolerance is not a license for power
        </blockquote>
      </section>

      <!-- BOOK -->

      <section class="book book-page-section">
        <div class="container">
          <div class="book-grid">
            <div class="book-cover-wrapper reveal reveal-left">
              <img
                src="/images/book-cover.jpg"
                alt="Cover of A Theory of Minimal Tolerance by Fede Rodrigo"
              />
            </div>

            <div class="book-copy reveal reveal-right">
              <p class="eyebrow">
                COMING LATE SEPTEMBER 2026
              </p>

              <h2>
                A Theory of Minimal Tolerance
              </h2>

              <p>
                This book develops a framework for determining when coercive
                political power may be tolerated as an exception rather than
                assumed as a legitimate starting point
              </p>

              <p>
                It moves from the moral and economic limits of state power to
                the Minimal Tolerance Theorem, a second test for direct state
                production, and the institutional forces that allow power to
                expand, persist, and reshape the society beneath it
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ABSTRACT -->

      <section class="book-abstract">
        <div class="container abstract-inner">
          <p class="eyebrow reveal">
            ABSTRACT
          </p>

          <h2 class="reveal">
            When may coercion be tolerated?
          </h2>

          <div class="abstract-copy reveal">
            <p>
              <em>A Theory of Minimal Tolerance</em> begins from a distinction
              between legitimacy and tolerance. Political power does not acquire
              a different moral nature simply because it is exercised by the
              State. If coercion is to be admitted, the relevant question is
              therefore not whether it is legitimate by definition, but under
              what exceptional conditions it may be tolerated
            </p>

            <p>
              The book develops a Presumption of Liberty under which voluntary
              cooperation remains the rule and coercion bears the burden of
              proof. The Minimal Tolerance Theorem is a criterion for identifying
              the narrow class of functions that may enter consideration as
              coercive exceptions. It requires three necessary conditions:
              effective non-excludability, relevant non-rivalry, and persistent
              collapse of voluntary provision. Satisfying all three is necessary,
              but does not automatically authorize every intervention undertaken
              in the function's name
            </p>

            <p>
              The analysis then moves beyond the first threshold. State
              responsibility does not imply direct state production, and the
              Principle of Separability establishes a second filter. The final
              part examines what happens once power exists: how productive
              resilience can facilitate successive burdens, why political power
              cannot be expected to limit itself reliably, how intervention can
              weaken voluntary capacities, and what an institutional order
              constrained by the same standard would look like
            </p>
          </div>
        </div>
      </section>

      <!-- KEY CONCEPTS -->

      <section
        class="concepts"
        id="key-concepts"
      >
        <div class="container">
          <div class="section-intro">
            <p class="eyebrow reveal">
              KEY CONCEPTS
            </p>

            <h2 class="reveal">
              The conceptual architecture
            </h2>

            <p class="section-lead reveal">
              The theory develops through three stages: the criterion for
              coercive responsibility, the limits of direct state production,
              and the institutional consequences of power once it exists
            </p>
          </div>

          <!-- FIRST FILTER -->

          <div class="concept-group">
            <div class="concept-group-heading reveal">
              <span class="concept-number">01</span>

              <div>
                <p class="concept-kicker">
                  THE FIRST FILTER
                </p>

                <h3>
                  When may a function enter the State?
                </h3>
              </div>
            </div>

            <div class="concept-grid">
              {
                coreConcepts.map((concept) => (
                  <article
                    class="concept-card reveal"
                    id={concept.id}
                  >
                    <h4>
                      {concept.name}
                    </h4>

                    <p>
                      {concept.description}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>

          <!-- SECOND FILTER -->

          <div class="concept-group">
            <div class="concept-group-heading reveal">
              <span class="concept-number">02</span>

              <div>
                <p class="concept-kicker">
                  THE SECOND FILTER
                </p>

                <h3>
                  How much State is required?
                </h3>
              </div>
            </div>

            <div class="concept-grid">
              {
                secondFilterConcepts.map((concept) => (
                  <article
                    class="concept-card reveal"
                    id={concept.id}
                  >
                    <h4>
                      {concept.name}
                    </h4>

                    <p>
                      {concept.description}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>

          <!-- CONSEQUENCES -->

          <div class="concept-group">
            <div class="concept-group-heading reveal">
              <span class="concept-number">03</span>

              <div>
                <p class="concept-kicker">
                  THE CONSEQUENCES
                </p>

                <h3>
                  What happens once power exists?
                </h3>
              </div>
            </div>

            <div class="concept-grid">
              {
                institutionalConcepts.map((concept) => (
                  <article
                    class="concept-card reveal"
                    id={concept.id}
                  >
                    <h4>
                      {concept.name}
                    </h4>

                    <p>
                      {concept.description}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- CENTRAL PRINCIPLE -->

      <section class="book-principle">
        <div class="container">
          <p class="eyebrow reveal">
            THE STANDARD
          </p>

          <blockquote class="reveal reveal-scale">
            The burden of proof belongs to power
          </blockquote>

          <p class="reveal">
            First when power seeks to enter. Again when it seeks to produce
          </p>
        </div>
      </section>

      <!-- PAPERS -->

      <section class="ssrn">
        <div class="container">
          <p class="eyebrow reveal">
            THE PAPERS
          </p>

          <h2 class="reveal">
            Research behind the theory
          </h2>

          <p class="reveal">
            Explore the papers developing the theoretical foundations,
            formal structure, and implications of the Theory of Minimal Tolerance
          </p>

          <a
            href="/papers"
            class="primary reveal"
          >
            Explore the Papers
          </a>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .book-page-section .book-grid {
        align-items: center;
      }

      .book-cover-wrapper {
        perspective: 1000px;
      }

      .book-cover-wrapper img {
        transform-origin: center;
        transition:
          transform 320ms ease,
          box-shadow 320ms ease;
      }

      .book-copy p:not(.eyebrow) {
        max-width: 720px;
      }

      .book-copy p + p {
        margin-top: 0.9rem;
      }

      /* ABSTRACT */

      .book-abstract {
        padding: 3rem 0 3.5rem;
      }

      .abstract-inner {
        max-width: 980px;
      }

      .abstract-inner h2 {
        max-width: 760px;
        margin-bottom: 1.25rem;
      }

      .abstract-copy {
        max-width: 900px;
        font-size: 1.03rem;
        line-height: 1.65;
      }

      .abstract-copy p {
        margin: 0;
      }

      .abstract-copy p + p {
        margin-top: 0.9rem;
      }

      /* KEY CONCEPTS */

      .concepts {
        padding: 3.5rem 0 4rem;
      }

      .section-intro {
        max-width: 850px;
        margin-bottom: 2.4rem;
      }

      .section-intro h2 {
        margin-bottom: 0;
      }

      .section-lead {
        max-width: 760px;
        margin-top: 0.8rem;
        font-size: 1.03rem;
        line-height: 1.6;
      }

      .concept-group + .concept-group {
        margin-top: 3rem;
      }

      .concept-group-heading {
        display: grid;
        grid-template-columns: 96px 1fr;
        gap: 1.1rem;
        align-items: start;
        margin-bottom: 1.2rem;
      }

      .concept-number {
        display: block;
        margin-top: -0.05rem;
        color: var(--gold, #b49355);
        font-size: clamp(3rem, 5vw, 4.6rem);
        font-weight: 800;
        line-height: 0.82;
        letter-spacing: -0.065em;
      }

      .concept-kicker {
        margin: 0 0 0.18rem;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.14em;
      }

      .concept-group-heading h3 {
        margin: 0;
        font-size: clamp(1.45rem, 2.3vw, 2rem);
        line-height: 1.15;
      }

      .concept-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid rgba(13, 27, 42, 0.16);
      }

      .concept-card {
        padding: 1.35rem 1.65rem 1.45rem 0;
        border-bottom: 1px solid rgba(13, 27, 42, 0.16);
        scroll-margin-top: 100px;
      }

      .concept-card:nth-child(even) {
        padding-left: 1.65rem;
        border-left: 1px solid rgba(13, 27, 42, 0.16);
      }

      .concept-card h4 {
        margin: 0 0 0.5rem;
        font-size: clamp(1.1rem, 1.5vw, 1.32rem);
        line-height: 1.2;
      }

      .concept-card p {
        margin: 0;
        max-width: 620px;
        font-size: 0.96rem;
        line-height: 1.55;
      }

      /* CENTRAL PRINCIPLE */

      .book-principle {
        padding: 3.2rem 0 3.5rem;
        text-align: center;
      }

      .book-principle blockquote {
        max-width: 950px;
        margin: 0.7rem auto;
        font-size: clamp(2rem, 4vw, 3.6rem);
        line-height: 1.05;
        letter-spacing: -0.03em;
      }

      .book-principle > .container > p:last-child {
        max-width: 620px;
        margin: 0.85rem auto 0;
        font-size: 0.98rem;
        opacity: 0.72;
      }

      @media (hover: hover) and (pointer: fine) {
        .book-cover-wrapper img:hover {
          transform: translateY(-7px) rotateY(-2deg) rotateZ(-0.5deg);
          box-shadow: 0 30px 76px rgba(13, 27, 42, 0.22);
        }
      }

      @media (max-width: 900px) {
        .book-cover-wrapper {
          max-width: 320px;
        }

        .concept-grid {
          grid-template-columns: 1fr;
        }

        .concept-card,
        .concept-card:nth-child(even) {
          padding: 1.25rem 0;
          border-left: 0;
        }
      }

      @media (max-width: 560px) {
        .book-cover-wrapper {
          max-width: 270px;
          margin: 0 auto;
        }

        .book-copy {
          text-align: left;
        }

        .book-abstract {
          padding: 2.6rem 0 3rem;
        }

        .concepts {
          padding: 3rem 0 3.5rem;
        }

        .concept-group + .concept-group {
          margin-top: 2.6rem;
        }

        .concept-group-heading {
          grid-template-columns: 64px 1fr;
          gap: 0.75rem;
        }

        .concept-number {
          font-size: 2.9rem;
        }

        .concept-card {
          padding: 1.15rem 0 1.25rem;
        }

        .book-principle {
          padding: 2.8rem 0 3rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .book-cover-wrapper img {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (
        reduceMotion ||
        !("IntersectionObserver" in window)
      ) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver =
          new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;

                entry.target.classList.add(
                  "is-visible"
                );

                observer.unobserve(entry.target);
              });
            },
            {
              threshold: 0.14,
              rootMargin:
                "0px 0px -40px 0px",
            }
          );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
