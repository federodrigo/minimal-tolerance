---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Cases of the Theorem of Minimal Tolerance | Minimal Tolerance"
      description="Stress testing the Theorem of Minimal Tolerance across defense, public services, basic needs, financial stability, scientific research, and other contested areas."
      lang="en"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- PAGE TITLE -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            CASES
          </p>

          <h1>
            Stress Testing
          </h1>
<p class="story-trail" aria-label="Reading path"><span class="story-step">Questions</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step">Theory</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step">Theorem</span><span class="story-arrow" aria-hidden="true">→</span><span class="story-step is-current">Cases</span></p>
        </div>
      </section>

      <!-- MAIN STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          Every exception must prove itself
        </blockquote>
      </section>

      <!-- CRITERION -->

      <section class="application-section method-section">
        <div class="container">
          <div class="cases-criterion-layout">
            <div class="cases-criterion-copy">

          <p class="eyebrow reveal">
            THE MINIMAL TOLERANCE THEOREM
          </p>

          <h2 class="reveal">
            T → (NE ∧ NR ∧ CV)
          </h2>

          <div
            class="criterion-panel reveal reveal-scale"
            style="margin: 20px auto 0;"
          >

            <!-- DEFINITIONS -->

            <div class="criterion-terms">

              <div class="criterion-term">
                <span class="criterion-code">
                  T
                </span>

                <span class="criterion-name">
                  Tolerability of coercion on grounds of necessity
                </span>
              </div>

              <div class="criterion-term">
                <span class="criterion-code">
                  NE
                </span>

                <span class="criterion-name">
                  Effective non-excludability
                </span>
              </div>

              <div class="criterion-term">
                <span class="criterion-code">
                  NR
                </span>

                <span class="criterion-name">
                  Relevant non-rivalry
                </span>
              </div>

              <div class="criterion-term">
                <span class="criterion-code">
                  CV
                </span>

                <span class="criterion-name">
                  Persistent collapse of voluntary provision
                </span>
              </div>

            </div>

          </div>
        </div>
            <figure class="manuscript-scene cases-criterion-illustration reveal reveal-right" role="img" aria-label="Bridge undergoing a stress test"><span class="scene-picture scene-cases" aria-hidden="true"></span></figure>
          </div>
        </div>
      </section>

      <!-- FUNCTIONS THAT PASS -->

      <section class="application-section application-section-pass">
        <div class="container">
          <p class="eyebrow reveal">
            THE STRONGEST CANDIDATES
          </p>

          <h2 class="reveal">
            Functions that pass the test
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <h3>
                Territorial defense
              </h3>

              <p>
                Territorial defense may meet non-excludability and non-rivalry. It passes only if free riding also causes persistent failure of voluntary financing, coordination, or participation
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Internal security and legal order
              </h3>

              <p>
                Some collective security and legal-order functions may meet the first two conditions. They still require proof that voluntary provision persistently fails
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Major emergencies and epidemics
              </h3>

              <p>
                Major emergencies may involve non-excludable, non-rival benefits. Each function still requires proof of persistent voluntary collapse before coercion can be tolerated
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- FUNCTIONS THAT FAIL -->

      <section class="application-section application-section-fail">
        <div class="container">
          <p class="eyebrow reveal">
            OUTSIDE THE EXCEPTION
          </p>

          <h2 class="reveal">
            Functions that fail the test
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <h3>
                Health, education, and pensions
              </h3>

              <p>
                These services can be essential, but their importance does not establish non-excludability or non-rivalry. As general categories, they fail the first test
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Labor regulation and paternalism
              </h3>

              <p>
                Wage and contract rules may pursue fairness or protection, but those goals do not establish the theorem’s three conditions
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Political parties and ordinary regulation
              </h3>

              <p>
                Unequal bargaining power, concentration, and misconduct can raise serious concerns. None alone proves non-excludability, non-rivalry, and persistent voluntary collapse
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- BORDERLINE CASES -->

      <section
        class="application-section application-section-borderline"
      >
        <div class="container">
          <p class="eyebrow reveal">
            BORDERLINE CASES
          </p>

          <h2 class="reveal">
            Not every function has a clear answer
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <h3>
                Major urban arteries and open roads
              </h3>

              <p>
                Tolls and private streets can exclude non-contributors; some open roads cannot. Congestion, ownership, technology, and financing can change the answer
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Basic scientific research
              </h3>

              <p>
                Research knowledge may be hard to exclude and non-rival. The question is whether free riding persistently prevents voluntary institutions from sustaining the research
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <h3>
                Non-excludable urban services
              </h3>

              <p>
                Open street lighting may satisfy the first two conditions. The remaining question is whether voluntary provision can sustain the service
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- FINAL PRINCIPLE -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow reveal">
            THE RESULT
          </p>

          <h2 class="reveal cases-result-title">
            Each function stands on its own
          </h2>

          <p class="reveal">
            The theorem judges each function, not the State as a whole. Passing one test creates no presumption for another. Any exception must be reconsidered if technology, institutions, or voluntary alternatives change
          </p>
        </div>
      </section>

      <!-- COMPARISON OF APPROACHES -->

      <section class="content-section approaches-section" aria-labelledby="approaches-heading">
        <div class="container">
          <p class="eyebrow reveal">A CRITERION, NOT A LIST</p>
          <h2 class="reveal" id="approaches-heading">Three ways of thinking about government</h2>
          
          <div class="approaches-frame reveal reveal-scale">
            <table class="approaches-table" aria-labelledby="approaches-heading">
              <colgroup><col /><col /><col /><col /></colgroup>
              <thead>
              <tr>
                <th scope="col">Feature</th>
                <th scope="col">Anarcho-capitalism</th>
                <th scope="col">Minarchism</th>
                <th scope="col">Minimal Tolerance</th>
              </tr>
              </thead>
              <tbody>
              <tr>
                <th scope="row">The State</th>
                <td data-label="Anarcho-capitalism">No: rejects the State’s coercive monopoly</td>
                <td data-label="Minarchism">Yes: defends a minimal State</td>
                <td data-label="Minimal Tolerance">Exceptional: an institution of last resort</td>
              </tr>
              <tr>
                <th scope="row">State functions</th>
                <td data-label="Anarcho-capitalism">None: provision must be voluntary</td>
                <td data-label="Minarchism">Defense, security, and justice</td>
                <td data-label="Minimal Tolerance">No fixed list: each function must meet NE, NR, and CV</td>
              </tr>
              <tr>
                <th scope="row">Philosophical basis</th>
                <td data-label="Anarcho-capitalism">State coercion is morally illegitimate</td>
                <td data-label="Minarchism">Protecting rights justifies limited coercive authority</td>
                <td data-label="Minimal Tolerance">Coercion is not legitimized; its necessity must be proven</td>
              </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- BOOK -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            THE BOOK
          </p>

          <h2 class="reveal">
            See the complete stress test
          </h2>

          <p class="reveal">
            The book applies the test to more cases, particularly those where the boundary is hardest to draw
          </p>

          <div class="section-action reveal"><a href="/book/" class="story-link">Explore the book <span aria-hidden="true">→</span></a></div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /* CRITERION */

      .criterion-panel {
        max-width: 480px;
        margin-top: 20px;
        padding: 0 30px 20px;
        background: var(--paper-light);
        border: 1px solid var(--line);
        border-radius: 16px;
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      /* FORMULA */

      .criterion-formal {
        padding: 25px 0 23px;
        border-bottom: 1px solid var(--line);
      }

      .formula-expression {
        color: var(--navy);
        font-size: clamp(2rem, 3.6vw, 2.75rem);
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: 0.01em;
      }

      /* DEFINITIONS */

      .criterion-terms {
        width: fit-content;
        margin: 0 auto;
        padding-top: 14px;
      }

      .criterion-term {
        display: grid;
        grid-template-columns: 48px auto;
        align-items: baseline;
        gap: 12px;
        padding: 5px 0;
      }

      .criterion-code {
        color: var(--gold);
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.2;
      }

      .criterion-name {
        color: var(--navy);
        font-size: 1.03rem;
        font-weight: 500;
        line-height: 1.35;
      }

      /* APPLICATION SECTIONS */

      .application-section {
        padding: var(--section-space) 0;
        border-top: 1px solid var(--line);
      }

      .application-section-pass {
        background: var(--cream);
      }

      .application-section-fail {
        background: var(--paper);
      }

      .application-section-borderline {
        background: var(--paper-light);
      }

      .application-section > .container > .eyebrow,
      .application-section > .container > h2 {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      .application-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
        margin-top: 34px;
      }

      .application-card {
        min-height: 245px;
        padding: 28px;
        background: var(--paper-light);
        border: 1px solid var(--line);
        border-radius: 14px;
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      .application-section-fail .application-card {
        background: var(--cream);
      }

      .application-card h3 {
        margin-bottom: 14px;
        color: var(--navy);
        font-size: 1.35rem;
        line-height: 1.25;
      }

      .application-card p {
        margin-bottom: 0;
        font-size: 1rem;
        line-height: 1.62;
        text-align: left;
        hyphens: none;
      }

      /* HOVER — MOUSE ONLY */

      @media (hover: hover) and (pointer: fine) {
        .criterion-panel:hover {
          transform: translateY(-3px);
          border-color: rgba(169, 131, 58, 0.35);
          box-shadow: 0 14px 32px rgba(13, 27, 42, 0.06);
        }

        .application-card:hover {
          transform: translateY(-5px);
          border-color: rgba(169, 131, 58, 0.4);
          box-shadow: 0 18px 42px rgba(13, 27, 42, 0.09);
        }
      }

      /* RESPONSIVE */

      @media (max-width: 900px) {
        .application-grid {
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .application-card {
          min-height: auto;
        }
      }

      @media (max-width: 700px) {
        .criterion-panel {
          padding: 0 22px 18px;
        }

        .criterion-formal {
          padding: 22px 0 20px;
        }

        .formula-expression {
          font-size: clamp(1.7rem, 7vw, 2.2rem);
        }

        .criterion-term {
          grid-template-columns: 42px auto;
          gap: 10px;
          padding: 5px 0;
        }

        .criterion-code {
          font-size: 1.05rem;
        }

        .criterion-name {
          font-size: 0.98rem;
        }
      }

      @media (max-width: 600px) {
        .application-card {
          padding: 24px;
        }
      }

      /* REDUCED MOTION */

      @media (prefers-reduced-motion: reduce) {
        .criterion-panel,
        .application-card {
          transition: none;
        }
      }
    
      /* Bridge illustration belongs with the theorem, not the page heading */
      .cases-criterion-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(210px, 275px);
        align-items: center;
        gap: 38px;
      }
      .cases-criterion-illustration {
        width: 100%;
        max-width: 275px;
        justify-self: end;
      }
      .cases-criterion-copy { min-width: 0; }
      .cases-criterion-copy > .eyebrow,
      .cases-criterion-copy > h2 {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }
      @media (min-width: 861px) {
        .cases-result-title {
          max-width: none;
          font-size: clamp(1.95rem, 3.05vw, 2.45rem);
          white-space: nowrap;
          letter-spacing: -0.035em;
        }
      }
      @media (max-width: 840px) {
        .cases-criterion-layout {
          grid-template-columns: 1fr;
          gap: 8px;
        }
        .cases-criterion-illustration { max-width: 205px !important; }
      }

    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
