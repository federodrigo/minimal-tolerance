---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";

const passCases = [
  "Territorial defense",
  "Internal security",
  "Judicial system / rule enforcement",
  "Emergencies and disasters",
  "Truly devastating epidemics",
  "Existential threats",
  "International monetary infrastructure",
  "Financial system stability",
  "Global environment",
  "Preservation of strategic capacity",
  "Common rule for ownerless land",
];

const failCases = [
  "Education",
  "Health as a general system",
  "Housing",
  "Pensions",
  "Food",
  "Transport, internet, and commercial infrastructure",
  "Urban services",
  "Property records and cadastres",
  "Labor regulation",
  "Political party financing",
  "Aircraft production with state support",
  "Scarce goods after a hurricane",
  "Monopolies, cartels, and dumping",
  "Natural monopolies / strategic activity",
  "National monetary monopolies",
  "Drug verification",
  "Lighthouse",
  "Cultural heritage",
  "Semiconductor production",
  "Discrimination and repugnant agreements",
  "State appropriation or distribution of ownerless land",
];

const grayCases = [
  "Open roads and highways",
  "Basic scientific research",
  "Immediate medical emergency",
];

const resultGroups = [
  {
    label: "PASS",
    title: "Pass",
    className: "result-pass",
    items: passCases,
  },
  {
    label: "DO NOT PASS",
    title: "Do not pass",
    className: "result-fail",
    items: failCases,
  },
  {
    label: "GRAY AREA",
    title: "Gray area / debatable",
    className: "result-gray",
    items: grayCases,
  },
];
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Cases of the Theorem of Minimal Tolerance | Minimal Tolerance"
      description="Stress testing the Theorem of Minimal Tolerance across defense, public services, financial stability, scientific research, ownerless land, and other contested functions."
      lang="en"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            CASES
          </p>

          <h1>
            Stress Testing
          </h1>
        </div>
      </section>

      <!-- STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          Every exception must prove itself
        </blockquote>
      </section>

      <!-- THEOREM -->

      <section class="content-section method-section">
        <div class="container">
          <p class="eyebrow reveal">
            THE MINIMAL TOLERANCE THEOREM
          </p>

          <div class="criterion-panel reveal reveal-scale">
            <div class="criterion-formal">
              <div class="formula-expression">
                T → (NE ∧ NR ∧ CV)
              </div>
            </div>

            <div class="criterion-terms">
              <div class="criterion-term">
                <span class="criterion-code">T</span>

                <span class="criterion-name">
                  Tolerability on coercive-necessity grounds
                </span>
              </div>

              <div class="criterion-term">
                <span class="criterion-code">NE</span>

                <span class="criterion-name">
                  Effective non-excludability
                </span>
              </div>

              <div class="criterion-term">
                <span class="criterion-code">NR</span>

                <span class="criterion-name">
                  Relevant non-rivalry
                </span>
              </div>

              <div class="criterion-term">
                <span class="criterion-code">CV</span>

                <span class="criterion-name">
                  Persistent collapse of voluntary provision
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- COMPLETE RESULT -->

      <section class="results-section">
        <div class="container">
          <p class="eyebrow reveal">
            THE RESULT
          </p>

          <h2 class="reveal">
            Which functions pass — and which do not
          </h2>

          <p class="results-intro reveal">
            The theorem evaluates the function itself, not its importance,
            popularity, moral appeal, or current association with government.
            All three conditions must be satisfied at the same time.
          </p>

          <div class="results-grid">
            {
              resultGroups.map((group) => (
                <article
                  class={`result-column ${group.className} reveal reveal-scale`}
                >
                  <div class="result-header">
                    <span class="result-label">
                      {group.label}
                    </span>

                    <h3>
                      {group.title}
                    </h3>
                  </div>

                  <ul class="result-list">
                    {
                      group.items.map((item) => (
                        <li>
                          <span class="result-marker" aria-hidden="true"></span>
                          <span>{item}</span>
                        </li>
                      ))
                    }
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- PART I -->

      <section class="application-section application-section-pass">
        <div class="container">
          <p class="eyebrow reveal">
            TEST I
          </p>

          <h2 class="reveal">
            The first filter is structural
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <span class="card-kicker">
                STRONGEST CASES
              </span>

              <h3>
                Defense, security, and legal order
              </h3>

              <p>
                Territorial defense, internal security, and the judicial
                system are among the strongest candidates. Their benefits
                can be effectively non-excludable and relevantly
                non-rival, while free-rider incentives can undermine the
                financing or participation required to sustain them.
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <span class="card-kicker">
                BASIC NEEDS
              </span>

              <h3>
                Importance does not remove rivalry
              </h3>

              <p>
                Education, health, housing, food, and pensions may be
                essential. That does not change the economic structure of
                the underlying goods. Rivalry alone is sufficient to place
                them outside the theorem.
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <span class="card-kicker">
                EMERGENCIES
              </span>

              <h3>
                Scarcity does not change the test
              </h3>

              <p>
                A hurricane can destroy supply and make water, food, or
                fuel extremely scarce. It does not make those goods
                non-excludable or non-rival. Physical disruption is not
                the same thing as persistent voluntary collapse.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- PART II -->

      <section class="application-section application-section-second">
        <div class="container">
          <p class="eyebrow reveal">
            TEST II
          </p>

          <h2 class="reveal">
            The function must be defined precisely
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <span class="card-kicker">
                MONETARY INFRASTRUCTURE
              </span>

              <h3>
                A currency is not the same as a monetary infrastructure
              </h3>

              <p>
                A national monetary monopoly does not pass simply because
                it exists. The analysis changes when the relevant function
                is an international monetary infrastructure whose benefits
                extend across a much wider system.
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <span class="card-kicker">
                FINANCIAL SYSTEM
              </span>

              <h3>
                Stability is not the survival of a firm
              </h3>

              <p>
                The relevant function is the continued operation of the
                financial system, not the preservation of a particular
                bank, insurer, or institution. The distinction is essential
                to the result.
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <span class="card-kicker">
                STRATEGIC CAPACITY
              </span>

              <h3>
                The product and the capacity are different functions
              </h3>

              <p>
                Semiconductor production is excludable, rival, and already
                supplied voluntarily. Preserving a strategic productive
                capacity against a future military threat is a different
                function and must be evaluated separately.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- OWNERLESS LAND -->

      <section class="distinction-section">
        <div class="container">
          <p class="eyebrow reveal">
            A CRITICAL DISTINCTION
          </p>

          <h2 class="reveal">
            Ownerless land produces two opposite results
          </h2>

          <div class="distinction-grid">
            <article class="distinction-card distinction-no reveal reveal-scale">
              <span class="distinction-status">
                DOES NOT PASS
              </span>

              <h3>
                State appropriation or distribution
              </h3>

              <p>
                The land itself remains rival and excludable. The State
                does not acquire ownership merely by controlling the
                territory, and distributing the land does not alter the
                nature of the resource.
              </p>
            </article>

            <div class="distinction-divider" aria-hidden="true">
              ≠
            </div>

            <article class="distinction-card distinction-yes reveal reveal-scale">
              <span class="distinction-status">
                PASSES
              </span>

              <h3>
                A common rule for acquiring title
              </h3>

              <p>
                The relevant function is no longer the land itself. It is
                the common rule that determines when title arises over
                previously ownerless land. That rule can satisfy all three
                conditions.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- GRAY AREA -->

      <section class="application-section application-section-borderline">
        <div class="container">
          <p class="eyebrow reveal">
            GRAY AREA
          </p>

          <h2 class="reveal">
            Three cases remain genuinely debatable
          </h2>

          <div class="application-grid gray-grid stagger">
            <article class="application-card reveal reveal-scale">
              <span class="card-kicker">
                OPEN NETWORKS
              </span>

              <h3>
                Open roads and highways
              </h3>

              <p>
                Toll roads and private streets permit exclusion. Some open
                roads do not. Congestion, technology, financing, and the
                precise function under examination can change the result.
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <span class="card-kicker">
                KNOWLEDGE
              </span>

              <h3>
                Basic scientific research
              </h3>

              <p>
                Basic knowledge is difficult to exclude and can be used by
                many without being depleted. The unresolved question is
                whether voluntary institutions can sustain its production
                persistently at the relevant scale.
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <span class="card-kicker">
                IMMEDIATE AID
              </span>

              <h3>
                Immediate medical emergency
              </h3>

              <p>
                An unconscious patient may require immediate assistance
                without prior agreement. The emergency creates a difficult
                exceptional case, but it does not transform healthcare as
                a whole into a non-rival and non-excludable good.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- WHAT DOES NOT FOLLOW -->

      <section class="content-section content-section-alt">
        <div class="container narrow-result">
          <p class="eyebrow reveal">
            WHAT PASSING DOES NOT MEAN
          </p>

          <h2 class="reveal">
            An exception remains an exception
          </h2>

          <p class="reveal">
            Passing the theorem does not grant moral legitimacy to the
            State, nor does it authorize every policy, institution, or
            method used in the name of the admitted function.
          </p>

          <p class="reveal">
            The exception extends only to the function that satisfies the
            three conditions. Its scope must remain limited to the reason
            for which coercion was tolerated.
          </p>
        </div>
      </section>

      <!-- FINAL PRINCIPLE -->

      <section class="final-principle">
        <div class="container">
          <p class="eyebrow reveal">
            THE PRINCIPLE
          </p>

          <blockquote class="final-quote reveal reveal-scale">
            The burden of proof belongs to power
          </blockquote>
        </div>
      </section>

      <!-- BOOK -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            THE BOOK
          </p>

          <h2 class="reveal">
            See the complete stress test
          </h2>

          <p class="reveal">
            The book develops each case in full, including the distinction
            between products and functions, the treatment of voluntary
            provision, and the cases that remain genuinely uncertain.
          </p>

          <div class="buttons reveal">
            <a href="/book" class="primary">
              Explore the Book
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /* -------------------------------------------------------
         CRITERION
      ------------------------------------------------------- */

      .criterion-panel {
        max-width: 760px;
        margin-top: 20px;
        padding: 0 30px 20px;
        background: var(--paper-light);
        border: 1px solid var(--line);
        border-radius: 16px;
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      .criterion-formal {
        padding: 25px 0 23px;
        border-bottom: 1px solid var(--line);
      }

      .formula-expression {
        color: var(--navy);
        font-size: clamp(2rem, 3.6vw, 2.75rem);
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: 0.01em;
      }

      .criterion-terms {
        padding-top: 14px;
      }

      .criterion-term {
        display: grid;
        grid-template-columns: 48px 1fr;
        align-items: baseline;
        gap: 12px;
        padding: 5px 0;
      }

      .criterion-code {
        color: var(--gold);
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.2;
      }

      .criterion-name {
        color: var(--navy);
        font-size: 1.03rem;
        font-weight: 500;
        line-height: 1.35;
      }

      /* -------------------------------------------------------
         COMPLETE RESULTS
      ------------------------------------------------------- */

      .results-section {
        padding: var(--section-space) 0;
        background: var(--paper);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .results-section > .container > .eyebrow,
      .results-section > .container > h2,
      .results-intro {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      .results-intro {
        max-width: 760px;
        margin-top: 18px;
        margin-bottom: 0;
      }

      .results-grid {
        display: grid;
        grid-template-columns: 0.95fr 1.35fr 0.8fr;
        gap: 20px;
        margin-top: 42px;
        align-items: stretch;
      }

      .result-column {
        overflow: hidden;
        background: var(--paper-light);
        border: 1px solid var(--line);
        border-radius: 16px;
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      .result-header {
        padding: 20px 24px 19px;
        background:
          linear-gradient(
            180deg,
            rgba(13, 27, 42, 0.055),
            rgba(13, 27, 42, 0.018)
          );
        border-bottom: 1px solid var(--line);
      }

      .result-label {
        display: block;
        margin-bottom: 5px;
        color: var(--gold);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
      }

      .result-header h3 {
        margin: 0;
        color: var(--navy);
        font-size: 1.65rem;
        line-height: 1.1;
      }

      .result-list {
        margin: 0;
        padding: 10px 22px 16px;
        list-style: none;
      }

      .result-list li {
        display: grid;
        grid-template-columns: 9px 1fr;
        gap: 12px;
        align-items: baseline;
        padding: 12px 0;
        color: var(--navy);
        font-size: 0.98rem;
        line-height: 1.35;
        border-bottom: 1px solid rgba(13, 27, 42, 0.09);
      }

      .result-list li:last-child {
        border-bottom: 0;
      }

      .result-marker {
        width: 5px;
        height: 5px;
        margin-top: 0.45em;
        background: rgba(13, 27, 42, 0.52);
        border-radius: 50%;
      }

      .result-pass .result-header {
        background:
          linear-gradient(
            180deg,
            rgba(13, 27, 42, 0.035),
            rgba(13, 27, 42, 0.012)
          );
      }

      .result-fail .result-header {
        background:
          linear-gradient(
            180deg,
            rgba(13, 27, 42, 0.075),
            rgba(13, 27, 42, 0.022)
          );
      }

      .result-gray .result-header {
        background:
          linear-gradient(
            180deg,
            rgba(169, 131, 58, 0.09),
            rgba(169, 131, 58, 0.02)
          );
      }

      /* -------------------------------------------------------
         APPLICATION SECTIONS
      ------------------------------------------------------- */

      .application-section {
        padding: var(--section-space) 0;
        border-top: 1px solid var(--line);
      }

      .application-section-pass {
        background: var(--cream);
      }

      .application-section-second {
        background: var(--paper);
      }

      .application-section-borderline {
        background: var(--paper-light);
      }

      .application-section > .container > .eyebrow,
      .application-section > .container > h2 {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      .application-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
        margin-top: 36px;
      }

      .application-card {
        min-height: 300px;
        padding: 28px;
        background: var(--paper-light);
        border: 1px solid var(--line);
        border-radius: 14px;
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      .application-section-second .application-card {
        background: var(--cream);
      }

      .card-kicker {
        display: block;
        margin-bottom: 14px;
        color: var(--gold);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.11em;
      }

      .application-card h3 {
        margin-bottom: 14px;
        color: var(--navy);
        font-size: 1.35rem;
        line-height: 1.25;
      }

      .application-card p {
        margin-bottom: 0;
        font-size: 1rem;
        line-height: 1.62;
        text-align: left;
        hyphens: none;
      }

      /* -------------------------------------------------------
         OWNERLESS LAND DISTINCTION
      ------------------------------------------------------- */

      .distinction-section {
        padding: var(--section-space) 0;
        background: var(--cream);
        border-top: 1px solid var(--line);
      }

      .distinction-section > .container > .eyebrow,
      .distinction-section > .container > h2 {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      .distinction-grid {
        display: grid;
        grid-template-columns: 1fr 70px 1fr;
        gap: 18px;
        align-items: stretch;
        max-width: 1000px;
        margin: 40px auto 0;
      }

      .distinction-card {
        padding: 32px;
        background: var(--paper-light);
        border: 1px solid var(--line);
        border-radius: 16px;
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      .distinction-status {
        display: block;
        margin-bottom: 14px;
        color: var(--gold);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
      }

      .distinction-card h3 {
        margin-bottom: 15px;
        color: var(--navy);
        font-size: 1.5rem;
        line-height: 1.2;
      }

      .distinction-card p {
        margin: 0;
        font-size: 1rem;
        line-height: 1.62;
      }

      .distinction-divider {
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(13, 27, 42, 0.35);
        font-size: 2.2rem;
        font-weight: 600;
      }

      /* -------------------------------------------------------
         FINAL RESULT
      ------------------------------------------------------- */

      .narrow-result {
        max-width: 830px;
      }

      .narrow-result p {
        max-width: 760px;
      }

      .final-principle {
        padding: calc(var(--section-space) * 0.9) 0;
        background: var(--navy);
        text-align: center;
      }

      .final-principle .eyebrow {
        color: var(--gold);
      }

      .final-quote {
        max-width: 900px;
        margin: 22px auto 0;
        color: var(--paper-light);
        font-size: clamp(2.2rem, 5vw, 4.4rem);
        font-weight: 600;
        line-height: 1.08;
        letter-spacing: -0.025em;
      }

      /* -------------------------------------------------------
         HOVER
      ------------------------------------------------------- */

      @media (hover: hover) and (pointer: fine) {
        .criterion-panel:hover,
        .result-column:hover,
        .application-card:hover,
        .distinction-card:hover {
          transform: translateY(-4px);
          border-color: rgba(169, 131, 58, 0.38);
          box-shadow: 0 16px 38px rgba(13, 27, 42, 0.075);
        }
      }

      /* -------------------------------------------------------
         RESPONSIVE
      ------------------------------------------------------- */

      @media (max-width: 1050px) {
        .results-grid {
          grid-template-columns: 1fr 1fr;
        }

        .result-gray {
          grid-column: 1 / -1;
        }

        .result-gray .result-list {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 0 20px;
        }
      }

      @media (max-width: 900px) {
        .application-grid {
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .application-card {
          min-height: auto;
        }

        .distinction-grid {
          grid-template-columns: 1fr;
          gap: 14px;
        }

        .distinction-divider {
          min-height: 50px;
          transform: rotate(90deg);
        }
      }

      @media (max-width: 700px) {
        .criterion-panel {
          padding: 0 22px 18px;
        }

        .criterion-formal {
          padding: 22px 0 20px;
        }

        .formula-expression {
          font-size: clamp(1.7rem, 7vw, 2.2rem);
        }

        .criterion-term {
          grid-template-columns: 42px 1fr;
          gap: 10px;
          padding: 5px 0;
        }

        .criterion-code {
          font-size: 1.05rem;
        }

        .criterion-name {
          font-size: 0.98rem;
        }

        .results-grid {
          grid-template-columns: 1fr;
        }

        .result-gray {
          grid-column: auto;
        }

        .result-gray .result-list {
          display: block;
        }
      }

      @media (max-width: 600px) {
        .application-card,
        .distinction-card {
          padding: 24px;
        }

        .result-header {
          padding: 18px 20px;
        }

        .result-list {
          padding-left: 20px;
          padding-right: 20px;
        }

        .final-quote {
          font-size: clamp(2rem, 10vw, 3.1rem);
        }
      }

      /* -------------------------------------------------------
         REDUCED MOTION
      ------------------------------------------------------- */

      @media (prefers-reduced-motion: reduce) {
        .criterion-panel,
        .result-column,
        .application-card,
        .distinction-card {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
