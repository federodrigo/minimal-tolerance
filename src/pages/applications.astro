---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";

const questions = [
  {
    id: "proper-functions-of-government",
    number: "01",
    title: "What Are the Proper Functions of Government?",
    short:
      "Political theories offer different lists of government functions, but the prior question is what standard can justify placing any particular function under coercive authority",
  },
  {
    id: "why-these-functions",
    number: "02",
    title: "Why These Functions and Not Others?",
    short:
      "The importance of an activity does not explain why it should be placed under political control or financed through coercion",
  },
  {
    id: "principle-limits-government-power",
    number: "03",
    title: "Is There a Principle That Limits Government?",
    short:
      "A durable limit requires a function-specific standard that places the burden of proof on those proposing coercion",
  },
  {
    id: "can-state-coercion-be-tolerated",
    number: "04",
    title: "Can Coercion Ever Be Tolerated?",
    short:
      "Useful outcomes, democratic support, and good intentions do not legitimize coercion; only exceptional conditions can support a function-level case for coercive necessity",
  },
  {
    id: "limits-of-voluntary-cooperation",
    number: "05",
    title: "When Does Voluntary Cooperation Reach Its Limit?",
    short:
      "Free riders are not enough: their incentives must persistently undermine the financing, coordination, or participation needed to sustain the function",
  },
  {
    id: "does-test-legitimize-coercion",
    number: "06",
    title: "Does Passing the Test Legitimize Coercion?",
    short:
      "No. Passing all three conditions establishes a function-level case for coercive necessity; it does not justify any particular coercive arrangement",
  },
];
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Proper Functions and Limits of Government | Minimal Tolerance"
      description="Six questions on the proper functions and limits of government, state coercion, voluntary cooperation, free riders, and the burden of proof on political power"
      lang="en"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->

      <section class="hero questions-page-hero">
        <div class="hero-content hero-sequence">
          <p class="eyebrow">
            THE QUESTIONS
          </p>

          <h1>
            What should government<br />
            be allowed to do?
          </h1>
        </div>
      </section>

      <!-- CENTRAL STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          An exception is not a license for power
        </blockquote>
      </section>

      <!-- EXPLORE -->

      <section class="questions-index">
        <div class="questions-container">
          <p class="eyebrow reveal">
            EXPLORE
          </p>

          <nav
            class="questions-index-grid stagger"
            aria-label="Questions about government and political power"
          >
            {
              questions.map((question) => (
                <a
                  href={`#${question.id}`}
                  class="question-index-card reveal"
                >
                  <span class="question-index-number">
                    {question.number}
                  </span>

                  <span class="question-index-title">
                    {question.title}
                  </span>
                </a>
              ))
            }
          </nav>
        </div>
      </section>

      <!-- QUESTIONS -->

      <section class="questions-content">
        <div class="questions-container">

          <!-- QUESTION 01 -->

          <article
            id="proper-functions-of-government"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                01
              </span>

              <h2>
                What Are the Proper Functions of Government?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                Every political philosophy offers a different answer.
                Some restrict government to police, courts, and national
                defense, while others also include education, healthcare,
                pensions, infrastructure, monetary policy, or scientific
                research. The disagreement is easy to observe; the harder
                question is what common standard can distinguish among
                these competing functions
              </p>

              <p>
                Before deciding what government should do, each proposed
                function must answer a prior question: why should this
                activity be removed from voluntary cooperation and placed
                under coercive authority? Without a common standard,
                political boundaries become collections of preferences
                rather than consistent limits on power
              </p>
            </div>
          </article>

          <!-- QUESTION 02 -->

          <article
            id="why-these-functions"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                02
              </span>

              <h2>
                Why These Functions and Not Others?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                Defenders of limited government usually identify a
                small group of functions that should remain under state
                control, but the selection itself requires an explanation.
                Why police but not healthcare, national defense but not
                pensions, courts but not scientific research? The fact
                that an activity is valuable, difficult, or socially
                important does not establish that it must be provided
                through coercion
              </p>

              <p>
                A meaningful limit must explain why one function may
                qualify as an exception while another remains within
                voluntary cooperation. The task is not to produce a
                shorter or longer list, but to apply the same burden
                of proof to every proposed function
              </p>
            </div>
          </article>

          <!-- QUESTION 03 -->

          <article
            id="principle-limits-government-power"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                03
              </span>

              <h2>
                Is There a Principle That Limits Government?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                Political debate concentrates on policies, institutions,
                and outcomes while giving less attention to the principle
                that determines which powers government may exercise.
                A limit based on tradition, political preference, or a
                fixed list of familiar functions becomes unstable when
                new problems, technologies, and demands appear
              </p>

              <p>
                A durable limiting principle must apply regardless of
                who governs, which objective is pursued, or how attractive
                the promised result may be. Liberty is the baseline:
                the burden belongs to coercion, and each proposed
                exception must establish its own conditions
              </p>
            </div>
          </article>

          <!-- QUESTION 04 -->

          <article
            id="can-state-coercion-be-tolerated"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                04
              </span>

              <h2>
                Can Coercion Ever Be Tolerated?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                Every government ultimately relies on coercion because
                laws, taxes, and regulations remain binding even for
                those who reject them. Elections, beneficial outcomes,
                and good intentions may affect political judgment, but
                they do not transform an imposed decision into a
                voluntary one or confer moral legitimacy on coercion
              </p>

              <p>
                Minimal Tolerance asks whether a particular function
                can qualify as an exception on grounds of coercive
                necessity. The presumption remains with voluntary
                cooperation, and the burden of establishing the
                exception belongs to those who would impose coercion
              </p>
            </div>
          </article>

          <!-- QUESTION 05 -->

          <article
            id="limits-of-voluntary-cooperation"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                05
              </span>

              <h2>
                When Does Voluntary Cooperation Reach Its Limit?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                Effective non-excludability (NE) and relevant
                non-rivalry (NR) can create strong incentives to benefit
                without contributing. But the existence of free riders
                does not establish that voluntary institutions cannot
                sustain the relevant function
              </p>

              <p>
                Persistent collapse of voluntary provision (CV) occurs
                when those incentives undermine the financing,
                coordination, or participation needed to sustain the
                function over time and across materially different
                voluntary arrangements. The failure of one arrangement,
                observed underprovision, or the absence of a current
                provider does not by itself establish collapse
              </p>
            </div>
          </article>

          <!-- QUESTION 06 -->

          <article
            id="does-test-legitimize-coercion"
            class="question-section"
          >
            <div class="question-heading reveal reveal-left">
              <span class="question-number">
                06
              </span>

              <h2>
                Does Passing the Test Legitimize Coercion?
              </h2>
            </div>

            <div class="question-copy reveal reveal-right">
              <p>
                No. When effective non-excludability, relevant
                non-rivalry, and persistent collapse of voluntary
                provision are jointly established, the function passes
                the Minimal Tolerance Criterion on coercive-necessity
                grounds. This does not legitimize coercion or justify
                any particular coercive arrangement
              </p>

              <p>
                Any tax, agency, budget, mandate, enforcement rule,
                or other coercive instrument must therefore be justified
                separately. Passing one function creates no presumption
                in favor of another, and the result must be reconsidered
                if the conditions that supported it change
              </p>
            </div>
          </article>
        </div>
      </section>

      <!-- FINAL CTA -->

      <section class="questions-cta">
        <div class="questions-container questions-cta-content">
          <div class="reveal reveal-left">
            <p class="eyebrow">
              THE THEORY OF MINIMAL TOLERANCE
            </p>

            <h2>
              The burden of proof belongs to power
            </h2>

            <p>
              Explore the framework developed to determine when a
              function can pass the test of coercive necessity without
              converting that result into a general authorization
              for political power
            </p>
          </div>

          <div class="questions-cta-buttons reveal reveal-right">
            <a
              href="/theory"
              class="primary"
            >
              Explore the Theory
            </a>

            <a
              href="/theorem"
              class="secondary"
            >
              Examine the Theorem
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .question-index-card {
        transition:
          color 220ms ease,
          background 220ms ease,
          transform 220ms ease;
      }

      .question-index-number {
        transition: transform 220ms ease;
      }

      .question-section {
        overflow: hidden;
      }

      @media (hover: hover) and (pointer: fine) {
        .question-index-card:hover {
          transform: translateY(-2px);
        }

        .question-index-card:hover .question-index-number {
          transform: translateX(5px);
        }
      }

      @media (max-width: 900px) {
        .question-heading.reveal-left,
        .question-copy.reveal-right {
          transform: translateY(24px);
        }

        .question-heading.reveal-left.is-visible,
        .question-copy.reveal-right.is-visible {
          transform: translateY(0);
        }
      }

      @media (max-width: 560px) {
        .questions-statement .reveal {
          transform: translateY(18px);
        }

        .questions-statement .reveal.is-visible {
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .question-index-card,
        .question-index-number {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
