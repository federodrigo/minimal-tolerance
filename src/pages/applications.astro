---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Applications of the Theorem of Minimal Tolerance | Minimal Tolerance"
      description="Practical applications of the Theorem of Minimal Tolerance across defense, public services, basic needs, financial stability, and other contested areas."
      lang="en"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- PAGE TITLE -->

      <section class="page-hero">
        <div class="container">
          <p class="eyebrow">
            APPLICATIONS
          </p>

          <h1>
            Stress Testing
          </h1>
        </div>
      </section>

      <!-- MAIN STATEMENT -->

      <section class="statement">
        <blockquote>
          The theorem does not accept or reject the State as a whole.
          Each function must pass the test independently
        </blockquote>
      </section>

      <!-- METHOD -->

      <section class="content-section method-section">
        <div class="container">
          <p class="eyebrow">
            THE METHOD
          </p>

          <h2>
            One test for every function
          </h2>

          <p class="method-intro">
            Every proposed exception must satisfy
            <strong>all three conditions</strong>
          </p>

          <ol class="condition-list">
            <li class="condition">
              <span class="condition-number" aria-hidden="true">
                01
              </span>

              <span class="condition-name">
                Effective non-excludability
              </span>
            </li>

            <li class="condition">
              <span class="condition-number" aria-hidden="true">
                02
              </span>

              <span class="condition-name">
                Relevant non-rivalry
              </span>
            </li>

            <li class="condition">
              <span class="condition-number" aria-hidden="true">
                03
              </span>

              <span class="condition-name">
                Persistent collapse of voluntary provision
              </span>
            </li>
          </ol>

          <p class="method-note">
            Importance does not establish necessity. Difficulty does not establish impossibility
          </p>
        </div>
      </section>

      <!-- INSTITUTIONAL BOOTSTRAP -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow">
            INSTITUTIONAL BOOTSTRAP
          </p>

          <h2>
            Absence Is Not Impossibility
          </h2>

          <p>
            When an activity has remained under state control for
            generations, alternative institutions may have
            disappeared, weakened, or become illegal. Their absence
            cannot be treated as proof that voluntary provision is
            impossible.
          </p>

          <p>
            A monopoly may prevent competing arrangements from
            developing and later invoke their absence as evidence
            of its own necessity. The consequences of intervention
            cannot be used to justify the intervention that produced
            them.
          </p>
        </div>
      </section>

      <!-- FUNCTIONS THAT PASS -->

      <section class="application-section application-section-pass">
        <div class="container">
          <p class="eyebrow">
            THE EXCEPTION
          </p>

          <h2>
            Functions that pass the test
          </h2>

          <div class="application-grid">
            <article class="application-card">
              <p class="application-result">
                PASSES
              </p>

              <h3>
                Defense, security, and legal order
              </h3>

              <p>
                Protection against invasion, organized violence,
                catastrophic threats, and the enforcement of common
                legal rules affect entire populations. The benefits
                extend beyond those who finance them and cannot be
                easily confined to paying participants
              </p>
            </article>

            <article class="application-card">
              <p class="application-result">
                PASSES
              </p>

              <h3>
                Systemic financial stability
              </h3>

              <p>
                The relevant good is not the survival of a particular
                bank or company, but the continued operation of the
                financial infrastructure on which millions of
                participants depend
              </p>
            </article>

            <article class="application-card">
              <p class="application-result">
                PASSES
              </p>

              <h3>
                Global environmental threats
              </h3>

              <p>
                Some environmental risks cross borders, affect future
                generations, and cannot be confined to those who pay
                for prevention. The benefits are shared while the
                incentives to assume the costs remain weak
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- FUNCTIONS THAT FAIL -->

      <section class="application-section application-section-fail">
        <div class="container">
          <p class="eyebrow">
            OUTSIDE THE EXCEPTION
          </p>

          <h2>
            Functions that fail the test
          </h2>

          <div class="application-grid">
            <article class="application-card">
              <p class="application-result">
                FAILS
              </p>

              <h3>
                Health, education, housing, and pensions
              </h3>

              <p>
                These goods may be essential to individual wellbeing,
                but they remain excludable, rival, or capable of
                voluntary provision
              </p>
            </article>

            <article class="application-card">
              <p class="application-result">
                FAILS
              </p>

              <h3>
                Labor regulation and paternalism
              </h3>

              <p>
                Restrictions on wages, contracts, benefits, and working
                conditions rest on judgments about acceptable
                agreements and acceptable outcomes
              </p>
            </article>

            <article class="application-card">
              <p class="application-result">
                FAILS
              </p>

              <h3>
                Political parties and ordinary market regulation
              </h3>

              <p>
                Political influence, unequal bargaining power,
                monopolies, and undesirable conduct may create serious
                concerns. None of them establishes non-excludability,
                non-rivalry, and persistent voluntary collapse
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- BORDERLINE CASES -->

      <section
        class="application-section application-section-borderline"
      >
        <div class="container">
          <p class="eyebrow">
            BORDERLINE CASES
          </p>

          <h2>
            Not every function has a clear answer
          </h2>

          <div class="application-grid">
            <article class="application-card">
              <p class="application-result">
                CONTEXT DEPENDENT
              </p>

              <h3>
                Roads and urban networks
              </h3>

              <p>
                Toll roads and private streets permit exclusion.
                Large open networks may not. Congestion, technology,
                ownership, and the scale of the network can change the
                result
              </p>
            </article>

            <article class="application-card">
              <p class="application-result">
                CONTEXT DEPENDENT
              </p>

              <h3>
                Basic scientific research
              </h3>

              <p>
                Knowledge can benefit people who never financed its
                discovery and can be used without being consumed.
                The decisive issue is whether voluntary institutions
                remain capable of sustaining its production
              </p>
            </article>

            <article class="application-card">
              <p class="application-result">
                CONTEXT DEPENDENT
              </p>

              <h3>
                Strategic and monetary infrastructure
              </h3>

              <p>
                Semiconductors and currencies are normally produced
                through voluntary exchange. The analysis may change
                when the relevant good becomes systemic resilience
                rather than the individual product itself
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- FINAL PRINCIPLE -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow">
            THE RESULT
          </p>

          <h2>
            Each function stands on its wwn
          </h2>

          <p>
            The theorem does not accept or reject the State as a
            whole. It evaluates each function independently,
            requiring every proposed exception to satisfy the same
            test
          </p>

          <p>
            The exceptions remain exceptions. Their tolerance depends
            on circumstances rather than permanence, and different
            societies may reach different outcomes while applying the
            same criterion
          </p>
        </div>
      </section>

      <!-- BOOK -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow">
            THE BOOK
          </p>

          <h2>
            See the complete stress test
          </h2>

          <p>
            The book applies the theorem to defense, emergencies,
            basic needs, roads, monetary systems, financial crises,
            scientific research, environmental threats, labor
            regulation, and agreements commonly considered
            unacceptable.
          </p>

          <div class="buttons">
            <a href="/book" class="primary">
              Explore the Book
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /* METHOD */

      .method-intro {
        max-width: 680px;
        margin-bottom: 20px;
      }

      .condition-list {
        max-width: 760px;
        margin: 0 0 20px;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--line);
      }

      .condition {
        display: grid;
        grid-template-columns: 62px 1fr;
        align-items: center;
        min-height: 68px;
        border-bottom: 1px solid var(--line);
      }

      .condition-number {
        color: var(--gold);
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.18em;
      }

      .condition-name {
        color: var(--navy);
        font-family: inherit;
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.35;
      }

      .method-note {
        margin-bottom: 0;
        font-style: italic;
        line-height: 1.6;
      }

      /* APPLICATION SECTIONS */

      .application-section {
        padding: var(--section-space) 0;
        border-top: 1px solid var(--line);
      }

      .application-section-pass {
        background: var(--cream);
      }

      .application-section-fail {
        background: var(--paper);
      }

      .application-section-borderline {
        background: var(--paper-light);
      }

      .application-section > .container > .eyebrow,
      .application-section > .container > h2 {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      .application-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
        margin-top: 34px;
      }

      .application-card {
        min-height: 290px;
        padding: 28px;
        background: var(--paper-light);
        border: 1px solid var(--line);
        border-radius: 14px;
      }

      .application-section-fail .application-card {
        background: var(--cream);
      }

      .application-card h3 {
        margin-bottom: 14px;
        color: var(--navy);
        font-size: 1.35rem;
        line-height: 1.25;
      }

      .application-card p {
        margin-bottom: 0;
        font-size: 1rem;
        line-height: 1.62;
        text-align: left;
        hyphens: none;
      }

      .application-card .application-result {
        margin-bottom: 14px;
        color: var(--gold);
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: 0.16em;
      }

      /* RESPONSIVE */

      @media (max-width: 900px) {
        .application-grid {
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .application-card {
          min-height: auto;
        }
      }

      @media (max-width: 600px) {
        .condition {
          grid-template-columns: 46px 1fr;
          min-height: 66px;
        }

        .condition-name {
          font-size: 1.05rem;
        }
      }
    </style>
  </body>
</html>
