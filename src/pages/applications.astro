---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Applications of the Theorem of Minimal Tolerance | Minimal Tolerance"
      description="Stress testing the Theorem of Minimal Tolerance across defense, public services, basic needs, financial stability, scientific research, and other contested areas."
      lang="en"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- PAGE TITLE -->

      <section class="page-hero">
        <div class="container hero-sequence">
          <p class="eyebrow">
            APPLICATIONS
          </p>

          <h1>
            Stress Testing
          </h1>
        </div>
      </section>

      <!-- MAIN STATEMENT -->

      <section class="statement">
        <blockquote class="reveal reveal-scale">
          Each function must pass the test independently
        </blockquote>
      </section>

      <!-- METHOD -->

      <section class="content-section method-section">
        <div class="container">
          <p class="eyebrow reveal">
            THE METHOD
          </p>

          <h2 class="reveal">
            All three conditions must be satisfied
          </h2>

          <ol class="condition-list stagger">
            <li class="condition reveal">
              <span class="condition-number" aria-hidden="true">
                NE
              </span>

              <span class="condition-name">
                Effective non-excludability
              </span>
            </li>

            <li class="condition reveal">
              <span class="condition-number" aria-hidden="true">
                NR
              </span>

              <span class="condition-name">
                Relevant non-rivalry
              </span>
            </li>

            <li class="condition reveal">
              <span class="condition-number" aria-hidden="true">
                CV
              </span>

              <span class="condition-name">
                Persistent collapse of voluntary provision
              </span>
            </li>
          </ol>

          <p class="method-note reveal">
            The first two define the economic structure; the third tests
            its institutional consequence. Passing all three is a
            function-level result, not an authorization of any particular
            coercive arrangement
          </p>
        </div>
      </section>

      <!-- FUNCTIONS THAT PASS -->

      <section class="application-section application-section-pass">
        <div class="container">
          <p class="eyebrow reveal">
            THE STRONGEST CANDIDATES
          </p>

          <h2 class="reveal">
            Functions that may pass the test
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                STRONG CANDIDATE
              </p>

              <h3>
                Territorial defense
              </h3>

              <p>
                Territorial defense can satisfy non-excludability and
                non-rivalry. It passes the test only if free-rider
                incentives persistently undermine the financing,
                coordination, or participation needed to sustain the
                collective function
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                STRONG CANDIDATE
              </p>

              <h3>
                Internal security and legal order
              </h3>

              <p>
                Some functions of collective security and legal order may
                satisfy the first two conditions. The remaining burden is
                to establish that voluntary provision persistently fails
                to sustain the relevant function
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                STRONG CANDIDATE
              </p>

              <h3>
                Large-scale emergencies and devastating epidemics
              </h3>

              <p>
                Exceptional emergencies may create functions whose benefits
                are difficult to exclude and broadly shared. They pass only
                where persistent voluntary collapse is also established for
                the specific function under examination
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- FUNCTIONS THAT FAIL -->

      <section class="application-section application-section-fail">
        <div class="container">
          <p class="eyebrow reveal">
            OUTSIDE THE EXCEPTION
          </p>

          <h2 class="reveal">
            Functions that fail the test
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                FAILS
              </p>

              <h3>
                Health, education, housing, and pensions
              </h3>

              <p>
                These goods may be essential and socially valuable, but
                their importance does not remove rivalry or make exclusion
                ineffective. They therefore fail before persistent voluntary
                collapse becomes relevant
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                FAILS
              </p>

              <h3>
                Labor regulation and paternalism
              </h3>

              <p>
                Restrictions on wages, contracts, benefits, and working
                conditions may pursue distributive or paternalistic
                goals, but those grounds do not establish the three
                conditions required by the theorem
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                FAILS
              </p>

              <h3>
                Political parties and ordinary market regulation
              </h3>

              <p>
                Political influence, unequal bargaining power,
                concentration, and undesirable conduct may raise serious
                concerns. They do not by themselves establish effective
                non-excludability, relevant non-rivalry, and persistent
                collapse of voluntary provision
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- BORDERLINE CASES -->

      <section
        class="application-section application-section-borderline"
      >
        <div class="container">
          <p class="eyebrow reveal">
            BORDERLINE CASES
          </p>

          <h2 class="reveal">
            Not every function has a clear answer
          </h2>

          <div class="application-grid stagger">
            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                CONTEXT DEPENDENT
              </p>

              <h3>
                Roads and urban networks
              </h3>

              <p>
                Toll roads and private streets can permit effective
                exclusion, while some open networks may not. Congestion,
                technology, ownership, scale, and alternative financing
                arrangements can change the result
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                CONTEXT DEPENDENT
              </p>

              <h3>
                Basic scientific research
              </h3>

              <p>
                Knowledge can be difficult to exclude and can often be
                used without diminishing what remains for others. The
                remaining question is whether free-rider incentives
                prevent voluntary institutions from sustaining the
                relevant research function over time
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                CONTEXT DEPENDENT
              </p>

              <h3>
                Strategic and monetary infrastructure
              </h3>

              <p>
                Semiconductors, currencies, and financial services are
                ordinarily excludable and rival at the product level.
                The analysis may change when the function under review
                is a broader form of systemic resilience, which must
                then satisfy all three conditions independently
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                CONTEXT DEPENDENT
              </p>

              <h3>
                Systemic financial stability
              </h3>

              <p>
                The relevant function may be the continued operation of
                a financial infrastructure rather than the survival of
                any particular institution. Whether it passes the test
                depends on the structure of the system and the available
                voluntary alternatives
              </p>
            </article>

            <article class="application-card reveal reveal-scale">
              <p class="application-result">
                CONTEXT DEPENDENT
              </p>

              <h3>
                Global environmental threats
              </h3>

              <p>
                Some environmental benefits extend across borders and
                generations and may satisfy non-excludability and
                non-rivalry. The remaining question is whether free-rider
                incentives persistently undermine the protective function
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- FINAL PRINCIPLE -->

      <section class="content-section content-section-alt">
        <div class="container">
          <p class="eyebrow reveal">
            THE RESULT
          </p>

          <h2 class="reveal">
            Each function stands on its own
          </h2>

          <p class="reveal">
            The theorem does not accept or reject the State as a
            whole. Each function is evaluated independently, and
            passing one creates no presumption in favor of another
          </p>

          <p class="reveal">
            Any tolerance remains contingent on the conditions that
            supported it. Changes in technology, institutions, or
            voluntary provision can therefore require the exception
            to be examined again
          </p>
        </div>
      </section>

      <!-- BOOK -->

      <section class="content-section">
        <div class="container">
          <p class="eyebrow reveal">
            THE BOOK
          </p>

          <h2 class="reveal">
            See the complete stress test
          </h2>

          <p class="reveal">
            The book applies the theorem to defense, emergencies,
            basic needs, roads, monetary systems, financial crises,
            scientific research, environmental threats, labor
            regulation, and agreements commonly considered
            unacceptable
          </p>

          <div class="buttons reveal">
            <a href="/book" class="primary">
              Explore the Book
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /* METHOD */

      .method-intro {
        max-width: 680px;
        margin-bottom: 20px;
      }

      .condition-list {
        max-width: 760px;
        margin: 0 0 20px;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--line);
      }

      .condition {
        display: grid;
        grid-template-columns: 62px 1fr;
        align-items: center;
        min-height: 68px;
        border-bottom: 1px solid var(--line);
      }

      .condition-number {
        color: var(--gold);
        font-size: 1.4rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0;
        transition:
          transform 220ms ease,
          color 220ms ease;
      }

      .condition-name {
        color: var(--navy);
        font-family: inherit;
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.35;
      }

      .method-note {
        margin-bottom: 0;
        font-style: italic;
        line-height: 1.6;
      }

      /* APPLICATION SECTIONS */

      .application-section {
        padding: var(--section-space) 0;
        border-top: 1px solid var(--line);
      }

      .application-section-pass {
        background: var(--cream);
      }

      .application-section-fail {
        background: var(--paper);
      }

      .application-section-borderline {
        background: var(--paper-light);
      }

      .application-section > .container > .eyebrow,
      .application-section > .container > h2 {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      .application-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
        margin-top: 34px;
      }

      .application-card {
        min-height: 290px;
        padding: 28px;
        background: var(--paper-light);
        border: 1px solid var(--line);
        border-radius: 14px;
        transition:
          transform 240ms ease,
          border-color 240ms ease,
          box-shadow 240ms ease;
      }

      .application-section-fail .application-card {
        background: var(--cream);
      }

      .application-card h3 {
        margin-bottom: 14px;
        color: var(--navy);
        font-size: 1.35rem;
        line-height: 1.25;
      }

      .application-card p {
        margin-bottom: 0;
        font-size: 1rem;
        line-height: 1.62;
        text-align: left;
        hyphens: none;
      }

      .application-card .application-result {
        margin-bottom: 14px;
        color: var(--gold);
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: 0.16em;
      }

      /* HOVER — MOUSE ONLY */

      @media (hover: hover) and (pointer: fine) {
        .condition:hover .condition-number {
          color: var(--navy);
          transform: translateX(5px);
        }

        .application-card:hover {
          transform: translateY(-5px);
          border-color: rgba(169, 131, 58, 0.4);
          box-shadow: 0 18px 42px rgba(13, 27, 42, 0.09);
        }
      }

      /* RESPONSIVE */

      @media (max-width: 900px) {
        .application-grid {
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .application-card {
          min-height: auto;
        }
      }

      @media (max-width: 600px) {
        .condition {
          grid-template-columns: 46px 1fr;
          min-height: 66px;
        }

        .condition-name {
          font-size: 1.05rem;
        }

        .application-card {
          padding: 24px;
        }
      }

      /* REDUCED MOTION */

      @media (prefers-reduced-motion: reduce) {
        .condition-number,
        .application-card {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const revealElements =
        document.querySelectorAll(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
