---
const {
  title,
  description,
  canonical,
  lang = "en",
  alternateEn,
  alternateEs,
} = Astro.props;
---

<title>{title}</title>

<meta
  name="description"
  content={description}
/>

<link
  rel="canonical"
  href={canonical}
/>

{alternateEn && (
  <link
    rel="alternate"
    hreflang="en"
    href={alternateEn}
  />
)}

{alternateEs && (
  <link
    rel="alternate"
    hreflang="es"
    href={alternateEs}
  />
)}

{alternateEn && (
  <link
    rel="alternate"
    hreflang="x-default"
    href={alternateEn}
  />
)}
