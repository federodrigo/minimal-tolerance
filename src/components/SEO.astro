---
interface Props {
  title: string;
  description: string;
  lang?: "en" | "es";
}

const {
  title,
  description,
  lang = "en",
} = Astro.props;

const site = Astro.site ?? new URL("https://minimaltolerance.com");

const currentPath = Astro.url.pathname;

let englishPath: string;
let spanishPath: string;

if (currentPath === "/es" || currentPath === "/es/") {
  englishPath = "/";
  spanishPath = "/es/";
} else if (currentPath.startsWith("/es/")) {
  englishPath = currentPath.replace(/^\/es/, "");
  spanishPath = currentPath;
} else {
  englishPath = currentPath;
  spanishPath =
    currentPath === "/"
      ? "/es/"
      : `/es${currentPath}`;
}

const canonicalUrl = new URL(currentPath, site).toString();
const englishUrl = new URL(englishPath, site).toString();
const spanishUrl = new URL(spanishPath, site).toString();
---

<title>{title}</title>

<meta
  name="description"
  content={description}
/>

<link
  rel="canonical"
  href={canonicalUrl}
/>

<link
  rel="alternate"
  hreflang="en"
  href={englishUrl}
/>

<link
  rel="alternate"
  hreflang="es"
  href={spanishUrl}
/>

<link
  rel="alternate"
  hreflang="x-default"
  href={englishUrl}
/>

<meta
  property="og:type"
  content="website"
/>

<meta
  property="og:title"
  content={title}
/>

<meta
  property="og:description"
  content={description}
/>

<meta
  property="og:url"
  content={canonicalUrl}
/>

<meta
  property="og:site_name"
  content="Minimal Tolerance"
/>

<meta
  property="og:locale"
  content={lang === "es" ? "es_ES" : "en_US"}
/>

<meta
  property="og:locale:alternate"
  content={lang === "es" ? "en_US" : "es_ES"}
/>

<meta
  name="twitter:card"
  content="summary"
/>

<meta
  name="twitter:title"
  content={title}
/>

<meta
  name="twitter:description"
  content={description}
/>
