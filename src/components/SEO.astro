---
import '../styles/global.css';

interface Props {
	title: string;
	socialTitle?: string;
	description: string;
	lang?: 'en' | 'es';
	image?: string;
}

const {
	title,
	socialTitle = title,
	description,
	lang = 'en',
	image,
} = Astro.props;

const site = Astro.site ?? new URL('https://minimaltolerance.com');

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath === '/'
	? '/'
	: currentPath.endsWith('/')
		? currentPath
		: `${currentPath}/`;

let englishPath: string;
let spanishPath: string;

if (normalizedPath === '/es/') {
	englishPath = '/';
	spanishPath = '/es/';
} else if (normalizedPath.startsWith('/es/')) {
	englishPath = normalizedPath.replace(/^\/es/, '');
	spanishPath = normalizedPath;
} else {
	englishPath = normalizedPath;
	spanishPath =
		normalizedPath === '/'
			? '/es/'
			: `/es${normalizedPath}`;
}

const canonicalUrl = new URL(lang === 'es' ? spanishPath : englishPath, site);
const englishUrl = new URL(englishPath, site);
const spanishUrl = new URL(spanishPath, site);
const socialImage = image ?? '/images/mt-logo-social.png';
const imageUrl = new URL(socialImage, site);
const isSiteLogo = !image;
const imageAlt = socialImage.includes('book-cover')
	? (lang === 'es'
		? 'Portada de Una Teoría de Tolerancia Mínima'
		: 'Cover of A Theory of Minimal Tolerance')
	: (lang === 'es'
		? 'Logo MT de Tolerancia Mínima'
		: 'MT logo of Minimal Tolerance');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link
	rel="preload"
	href="/fonts/atkinson-regular.woff"
	as="font"
	type="font/woff"
	crossorigin
/>

<link
	rel="preload"
	href="/fonts/atkinson-bold.woff"
	as="font"
	type="font/woff"
	crossorigin
/>

<!-- Primary Metadata -->
<title>{title}</title>

<meta
	name="title"
	content={title}
/>

<meta
	name="description"
	content={description}
/>

<!-- Canonical and Languages -->
<link
	rel="canonical"
	href={canonicalUrl}
/>

<link
	rel="alternate"
	hreflang="en"
	href={englishUrl}
/>

<link
	rel="alternate"
	hreflang="es"
	href={spanishUrl}
/>

<link
	rel="alternate"
	hreflang="x-default"
	href={englishUrl}
/>

<!-- Open Graph -->
<meta
	property="og:type"
	content="website"
/>

<meta
	property="og:url"
	content={canonicalUrl}
/>

<meta
	property="og:title"
	content={socialTitle}
/>

<meta
	property="og:description"
	content={description}
/>

<meta
	property="og:image"
	content={imageUrl}
/>
<meta property="og:image:secure_url" content={imageUrl} />
<meta property="og:image:type" content={isSiteLogo ? 'image/png' : 'image/jpeg'} />
{isSiteLogo && <meta property="og:image:width" content="300" />}
{isSiteLogo && <meta property="og:image:height" content="300" />}
<link rel="image_src" href={imageUrl} />

<meta
	property="og:site_name"
	content={lang === 'es' ? 'Tolerancia Mínima' : 'Minimal Tolerance'}
/>

<meta
	property="og:locale"
	content={lang === 'es' ? 'es_ES' : 'en_US'}
/>

<meta
	property="og:locale:alternate"
	content={lang === 'es' ? 'en_US' : 'es_ES'}
/>

<meta
	property="og:image:alt"
	content={imageAlt}
/>

<!-- Twitter -->
<meta
	name="twitter:card"
	content="summary"
/>

<meta
	name="twitter:url"
	content={canonicalUrl}
/>

<meta
	name="twitter:title"
	content={socialTitle}
/>

<meta
	name="twitter:description"
	content={description}
/>

<meta
	name="twitter:image"
	content={imageUrl}
/>

<meta
	name="twitter:image:alt"
	content={imageAlt}
/>
