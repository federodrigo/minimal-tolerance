---
const today = new Date();

const currentPath = Astro.url.pathname;
const isSpanish = currentPath === "/es" || currentPath.startsWith("/es/");

const links = isSpanish
  ? [
      { label: "Preguntas", href: "/es/questions/" },
      { label: "Teoría", href: "/es/theory" },
      { label: "Teorema", href: "/es/theorem" },
      { label: "Aplicaciones", href: "/es/applications" },
      { label: "Libro", href: "/es/book" },
      { label: "Papers", href: "/es/papers" },
      { label: "Autor", href: "/es/author" },
    ]
  : [
      { label: "Questions", href: "/questions/" },
      { label: "Theory", href: "/theory" },
      { label: "Theorem", href: "/theorem" },
      { label: "Applications", href: "/applications" },
      { label: "Book", href: "/book" },
      { label: "Papers", href: "/papers" },
      { label: "Author", href: "/author" },
    ];
---

<footer>
  <div class="footer-inner">
    <p class="footer-copyright">
      © {today.getFullYear()}
      {isSpanish ? " Tolerancia Mínima" : " Minimal Tolerance"}
      · Fede Rodrigo
    </p>

    <div class="footer-navigation">
      <p class="footer-label">
        {isSpanish ? "NAVEGAR" : "NAVIGATE"}
      </p>

      <nav aria-label={isSpanish ? "Navegación del sitio" : "Site navigation"}>
        {links.map((link) => (
          <a href={link.href}>
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 2rem 0;
  }

  .footer-inner {
    width: min(1180px, calc(100% - 3rem));
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 3rem;
  }

  .footer-navigation {
    margin-left: auto;
    text-align: right;
  }

  .footer-label {
    margin: 0 0 1.25rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.65rem 1.1rem;
  }

  nav a {
    position: relative;
    color: inherit;
    font-weight: 400;
    text-decoration: none;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 220ms ease;
  }

  .footer-copyright {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 400;
    opacity: 0.6;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  @media (max-width: 700px) {
    footer {
      padding: 2rem 0;
    }

    .footer-inner {
      width: min(100% - 2rem, 1180px);
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }

    .footer-navigation {
      order: 1;
      margin-left: 0;
      text-align: left;
    }

    .footer-copyright {
      order: 2;
      white-space: normal;
    }

    nav {
      justify-content: flex-start;
      gap: 0.65rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    nav a::after {
      transition: none;
    }
  }
</style>
