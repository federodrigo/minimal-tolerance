---
const today = new Date();

const currentPath = Astro.url.pathname;
const isSpanish = currentPath === "/es" || currentPath.startsWith("/es/");

// Mantiene la página actual al cambiar de idioma.
// /theory  -> /es/theory
// /es/theory -> /theory
const englishPath = isSpanish
  ? currentPath.replace(/^\/es(?=\/|$)/, "") || "/"
  : currentPath;

const spanishPath = isSpanish
  ? currentPath
  : currentPath === "/"
    ? "/es"
    : `/es${currentPath}`;

const links = isSpanish
  ? [
      { label: "Preguntas", href: "/es/questions/" },
      { label: "Teoría", href: "/es/theory" },
      { label: "Teorema", href: "/es/theorem" },
      { label: "Casos", href: "/es/cases" },
      { label: "Libro", href: "/es/book" },
      { label: "Papers", href: "/es/papers" },
      { label: "Autor", href: "/es/author" },
    ]
  : [
      { label: "Questions", href: "/questions/" },
      { label: "Theory", href: "/theory" },
      { label: "Theorem", href: "/theorem" },
      { label: "Cases", href: "/cases" },
      { label: "Book", href: "/book" },
      { label: "Papers", href: "/papers" },
      { label: "Author", href: "/author" },
    ];
---

<footer>
  <div class="footer-inner">
    <p class="footer-copyright">
      © {today.getFullYear()}
      {isSpanish ? " Tolerancia Mínima" : " Minimal Tolerance"}
      · Fede Rodrigo
    </p>

    <div class="footer-navigation">
      <div class="footer-top">
        <p class="footer-label">
          {isSpanish ? "NAVEGAR" : "NAVIGATE"}
        </p>

        <div
          class="language-switcher"
          aria-label={isSpanish ? "Cambiar idioma" : "Change language"}
        >
          <a
            href={englishPath}
            class:list={["language-link", { active: !isSpanish }]}
            lang="en"
            aria-current={!isSpanish ? "page" : undefined}
          >
            EN
          </a>

          <span aria-hidden="true">|</span>

          <a
            href={spanishPath}
            class:list={["language-link", { active: isSpanish }]}
            lang="es"
            aria-current={isSpanish ? "page" : undefined}
          >
            ES
          </a>
        </div>
      </div>

      <nav aria-label={isSpanish ? "Navegación del sitio" : "Site navigation"}>
        {links.map((link) => (
          <a href={link.href}>
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 2rem 0;
  }

  .footer-inner {
    width: min(1180px, calc(100% - 3rem));
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 3rem;
  }

  .footer-navigation {
    margin-left: auto;
    text-align: right;
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .footer-label {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .language-switcher {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .language-switcher span {
    opacity: 0.35;
  }

  .language-link {
    position: relative;
    color: inherit;
    text-decoration: none;
    opacity: 0.45;
    transition: opacity 180ms ease;
  }

  .language-link.active {
    opacity: 1;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.65rem 1.1rem;
  }

  nav a {
    position: relative;
    color: inherit;
    font-weight: 400;
    text-decoration: none;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 220ms ease;
  }

  .footer-copyright {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 400;
    opacity: 0.6;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .language-link:hover {
      opacity: 1;
    }
  }

  @media (max-width: 700px) {
    footer {
      padding: 2rem 0;
    }

    .footer-inner {
      width: min(100% - 2rem, 1180px);
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }

    .footer-navigation {
      order: 1;
      margin-left: 0;
      text-align: left;
    }

    .footer-top {
      justify-content: flex-start;
    }

    .footer-copyright {
      order: 2;
      white-space: normal;
    }

    nav {
      justify-content: flex-start;
      gap: 0.65rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    nav a::after,
    .language-link {
      transition: none;
    }
  }
</style>
