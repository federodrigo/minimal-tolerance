---
interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
---

<section class="book-endorsement" aria-label={lang === "es" ? "Reconocimiento al libro" : "Praise for the book"}>
  <div class="container endorsement-inner">
    <p class="eyebrow">{lang === "es" ? "SOBRE EL LIBRO" : "PRAISE FOR THE BOOK"}</p>
    <figure>
      <blockquote>“This fascinating book of yours makes an important contribution.”</blockquote>
      <figcaption>Walter E. Block, Ph.D.</figcaption>
    </figure>
  </div>
</section>

<style>
  .book-endorsement {
    padding: clamp(42px, 5vw, 66px) 0;
    background: var(--navy);
    color: var(--paper-light);
    text-align: center;
  }

  .endorsement-inner {
    max-width: 960px;
  }

  .book-endorsement .eyebrow {
    margin-bottom: 18px;
    color: #d2b16d;
  }

  figure {
    margin: 0;
  }

  blockquote {
    max-width: 860px;
    margin: 0 auto 24px;
    font-size: clamp(1.55rem, 3vw, 2.4rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.32;
    letter-spacing: -0.025em;
  }

  figcaption {
    font-size: 1rem;
    line-height: 1.45;
    letter-spacing: 0.015em;
  }
</style>
