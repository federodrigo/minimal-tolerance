---
interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
---

<section class="book-endorsement" aria-label={lang === "es" ? "Reconocimiento al libro" : "Praise for the book"}>
  <div class="container endorsement-inner">
    <figure>
      <blockquote>
        {lang === "es" ? (
          <>
            «Este fascinante libro tuyo
            <span class="endorsement-line">hace una <span class="quote-tail">contribución importante»</span></span>
          </>
        ) : (
          <>
            “This fascinating book of yours
            <span class="endorsement-line">makes an <span class="quote-tail">important contribution”</span></span>
          </>
        )}
      </blockquote>
      <figcaption>Walter E. Block, Ph.D.</figcaption>
    </figure>
  </div>
</section>

<style>
  .book-endorsement {
    padding: clamp(20px, 2.5vw, 30px) 0;
    background: var(--navy);
    color: var(--paper-light);
    text-align: center;
  }

  .endorsement-inner {
    max-width: 960px;
  }

  figure {
    margin: 0;
  }

  blockquote {
    max-width: 860px;
    margin: 0 auto 9px;
    font-size: clamp(1.3rem, 2.3vw, 1.85rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .endorsement-line {
    display: block;
  }

  .quote-tail {
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .endorsement-line {
      display: inline;
    }

    .endorsement-line::before {
      content: " ";
    }
  }

  figcaption {
    font-size: 0.94rem;
    line-height: 1.25;
    letter-spacing: 0.015em;
  }
</style>
